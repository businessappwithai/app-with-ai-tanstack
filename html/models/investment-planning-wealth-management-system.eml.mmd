%% ---- Section 1: Business rule — risk suitability ---------------------------
%% A recommendation may not reach approval until a suitability result exists and
%% passed. The gate is here rather than in the approval screen so that every
%% caller — the saga, the API, an import — meets the same refusal.
%%meta name: Risk Suitability
%%meta kind: rules
%%rule riskSuitability on InvestmentRecommendation event: beforeUpdate priority: 10
flowchart TD
    A([Start: Recommendation moving forward]) --> B{status == pending_approval?}
    B -->|No| C[Leave the write alone]
    B -->|Yes| D{suitability_result == pass?}
    D -->|Yes| E[Allow the approval]
    D -->|No| F[Refuse: suitability has not passed]
    C --> Z([End: Suitability decided])
    E --> Z
    F --> Z

    %%action refuseUnsuitedRecommendation validation-error when: status == "pending_approval" and suitability_result != "pass" message: Suitability has not passed — a recommendation cannot go for approval until it has

%% ---- Section 2: Business rule — product eligibility ------------------------
%% A recommended line has to be a product the client may legally be sold, at the
%% risk band the household was assessed into.
%%meta name: Product Eligibility
%%meta kind: rules
%%rule productEligibility on RecommendationItem event: beforeCreate priority: 10
flowchart TD
    A([Start: Line added to a recommendation]) --> B{security is active?}
    B -->|No| C[Refuse: product withdrawn]
    B -->|Yes| D{product risk <= household risk band?}
    D -->|Yes| E[Accept the line]
    D -->|No| F[Refuse: outside the assessed risk band]
    C --> Z([End: Eligibility decided])
    E --> Z
    F --> Z

    %%action refuseWithdrawnProduct validation-error when: security_status != "active" message: This product has been withdrawn and cannot be recommended

%% ---- Section 3: Business rule — concentration ------------------------------
%% Nothing may push one holding past the concentration ceiling the mandate set.
%%meta name: Concentration Check
%%meta kind: rules
%%rule concentrationCheck on Order event: beforeCreate priority: 20
flowchart TD
    A([Start: Order raised]) --> B{resulting weight > 25 percent?}
    B -->|No| C[Within policy]
    B -->|Yes| D{dealer override recorded?}
    D -->|Yes| E[Allow, and flag for review]
    D -->|No| F[Refuse: concentration ceiling]
    C --> Z([End: Concentration decided])
    E --> Z
    F --> Z

    %%action refuseConcentrationBreach validation-error when: resulting_weight > 25 and override_reference == null message: This order would take one holding above the 25 percent concentration ceiling — record a dealer override or resize it

%% ---- Section 4: Business rule — allocation deviation -----------------------
%% How far a portfolio may drift from its model before a rebalance is raised.
%%meta name: Allocation Deviation
%%meta kind: rules
%%rule allocationDeviation on RebalanceRecommendation event: beforeCreate priority: 10
flowchart TD
    A([Start: Drift measured]) --> B{deviation >= 5 percent?}
    B -->|No| C[Below the band — no action]
    B -->|Yes| D{deviation >= 10 percent?}
    D -->|Yes| E[Raise a priority rebalance]
    D -->|No| F[Raise a routine rebalance]
    C --> Z([End: Deviation graded])
    E --> Z
    F --> Z

    %%action startRebalance trigger-workflow when: deviation_amount >= 5 workflow: Rebalancing message: Allocation has drifted past the tolerance band — raising a rebalance

%% ---- Section 5: Business rule — KYC completeness ---------------------------
%% No money moves for a client whose identity file is incomplete or expired.
%%meta name: KYC Completeness
%%meta kind: rules
%%rule kycCompleteness on Order event: beforeCreate priority: 5
flowchart TD
    A([Start: Order raised]) --> B{KYC verified?}
    B -->|No| C[Refuse: KYC incomplete]
    B -->|Yes| D{KYC expiry in the future?}
    D -->|Yes| E[Allow the order]
    D -->|No| F[Refuse: KYC expired]
    C --> Z([End: KYC decided])
    E --> Z
    F --> Z

    %%action refuseIncompleteKyc validation-error when: kyc_status != "verified" message: No order may be raised for a client whose KYC is not verified

%% ---- Section 6: Business rule — approval gate ------------------------------
%% A proposal cannot be produced from a recommendation nobody approved.
%%meta name: Recommendation Approval Gate
%%meta kind: rules
%%rule recommendationApprovalGate on Proposal event: beforeCreate priority: 10
flowchart TD
    A([Start: Proposal requested]) --> B{approval recorded?}
    B -->|No| C[Refuse: approval missing]
    B -->|Yes| D{approver differs from author?}
    D -->|Yes| E[Produce the proposal]
    D -->|No| F[Refuse: self-approval]
    C --> Z([End: Approval decided])
    E --> Z
    F --> Z

    %%action refuseUnapprovedProposal validation-error when: approval_reference == null message: A proposal cannot be produced from a recommendation nobody approved
    %%action refuseSelfApproval validation-error when: approver_id == advisor_id message: The approver of a recommendation may not be its author

%% ---- Section 7: Business rule — transaction eligibility --------------------
%% Settlement-side gate: the account has to be live and the mandate in force.
%%meta name: Transaction Eligibility
%%meta kind: rules
%%rule transactionEligibility on InvestmentTransaction event: beforeCreate priority: 10
flowchart TD
    A([Start: Transaction booked]) --> B{account active?}
    B -->|No| C[Refuse: account not active]
    B -->|Yes| D{mandate in force?}
    D -->|Yes| E[Book the transaction]
    D -->|No| F[Refuse: no mandate]
    C --> Z([End: Eligibility decided])
    E --> Z
    F --> Z

%% ---- Section 8: Business rule — commission reconciliation ------------------
%% What the platform expected against what the manufacturer paid, and what a
%% difference is called.
%%meta name: Commission Reconciliation
%%meta kind: rules

    %%action refuseInactiveAccount validation-error when: account_status != "active" message: A transaction cannot be booked against an account that is not active
    %%action refuseMissingMandate validation-error when: mandate_reference == null message: A transaction needs a mandate in force before it can be booked

%%rule commissionReconciliation on CommissionReconciliation event: beforeUpdate priority: 10
flowchart TD
    A([Start: Statement received]) --> B{difference within tolerance?}
    B -->|Yes| C[Mark matched]
    B -->|No| D{difference in the platform's favour?}
    D -->|Yes| E[Raise a payable exception]
    D -->|No| F[Raise a receivable exception]
    C --> Z([End: Reconciliation graded])
    E --> Z
    F --> Z

    %%action raiseCommissionException validation-error when: difference_amount != 0 and exception_reference == null message: Expected and received commission differ — record an exception before marking this reconciliation matched

%% ---- Sections 9a-9d: Lifecycle hooks ---------------------------------------
%% Rules decide and refuse; hooks act on the write itself. Everything below has
%% to happen however the record is reached — through the API, through an import,
%% through a saga — so none of it can live in a screen. The flowchart is what a
%% reader sees and the `%%hook` lines are what the generator compiles into
%% handler modules; both halves have to say the same thing.

%%meta name: Client Onboarding Hooks
%%meta kind: workflow
%%workflow ClientOnboardingHooks entity: Client kind: hook
flowchart TD
    A[Client Request] --> B[Validate Request]
    B --> C[beforeCreate: assignClientNumber]
    C --> D[customValidate: ensureClientNumberUnique]
    D --> E[Process Client]
    E --> F[afterCreate: openComplianceFile]
    F --> G[beforeList: scopeToOwnHouseholds]
    G --> H[beforeDelete: blockDeleteWithPortfolio]
    H --> I[Response]

    %% `beforeList: scopeToOwnHouseholds` is the one that matters most here. An
    %% advisor may read Client — that is what the %%rbac rule says — but reading
    %% *every* client is a different permission from reading their own, and RBAC
    %% has no way to express the difference. The row filter belongs on the query.
    %%hook beforeCreate assignClientNumber on Client[field: client_number]
    %%hook customValidate ensureClientNumberUnique on Client[field: client_number]
    %%hook afterCreate openComplianceFile on Client
    %%hook beforeList scopeToOwnHouseholds on Client[field: advisor_id]
    %%hook beforeDelete blockDeleteWithPortfolio on Client

%%meta name: Portfolio Valuation Hooks
%%meta kind: workflow
%%workflow PortfolioValuationHooks entity: Holding kind: hook
flowchart TD
    A[Client Request] --> B[Validate Request]
    B --> C[beforeCreate: normalizeQuantityScale]
    C --> D[Process Holding]
    D --> E[afterCreate: revalueOnNewHolding]
    E --> F[afterUpdate: revalueOnHoldingChange]
    F --> G[afterList: attachUnrealisedGain]
    G --> H[Response]

    %% A portfolio's value is arithmetic over its holdings, so it is recomputed
    %% on the write rather than read from a column somebody remembered to
    %% update. Unrealised gain is attached on the way out instead of stored: it
    %% moves with the price, and a stored copy is wrong the moment the market
    %% opens.
    %%hook beforeCreate normalizeQuantityScale on Holding[field: quantity]
    %% One handler name per event. Binding the same name to both afterCreate
    %% and afterUpdate makes the generator keep the first and drop the second,
    %% so the update path would have had no handler at all.
    %%hook afterCreate revalueOnNewHolding on Holding[field: portfolio_id]
    %%hook afterUpdate revalueOnHoldingChange on Holding[field: portfolio_id]
    %%hook afterList attachUnrealisedGain on Holding

%%meta name: Order Execution Hooks
%%meta kind: workflow
%%workflow OrderExecutionHooks entity: Order kind: hook
flowchart TD
    A[Client Request] --> B[Validate Request]
    B --> C[beforeCreate: stampOrderedAt]
    C --> D[customValidate: ensureDealingDeskOpen]
    D --> E[Process Order]
    E --> F[afterUpdate: bookExecutedTransaction]
    F --> G[beforeDelete: blockDeleteAfterSubmission]
    G --> H[Response]

    %% An order that reached the exchange is a record of something that
    %% happened, and deleting it is not a correction — it is a hole in the audit
    %% trail. Cancel it through the state machine instead; that edge exists.
    %%hook beforeCreate stampOrderedAt on Order[field: ordered_at]
    %%hook customValidate ensureDealingDeskOpen on Order
    %%hook afterUpdate bookExecutedTransaction on Order[field: status]
    %%hook beforeDelete blockDeleteAfterSubmission on Order

%%meta name: Audit Trail Hooks
%%meta kind: workflow
%%workflow AuditTrailHooks entity: AuditEvent kind: hook
flowchart TD
    A[Client Request] --> B[Validate Request]
    B --> C[beforeCreate: stampCorrelationRef]
    C --> D[Process AuditEvent]
    D --> E[beforeUpdate: blockAmendment]
    E --> F[beforeDelete: blockDeletion]
    F --> G[Response]

    %% The audit trail is append-only, and that has to be enforced where the
    %% write happens rather than by withholding a button: %%rbac can say who may
    %% update the table, and the answer here is nobody, including the
    %% administrator the master role would otherwise let through.
    %%hook beforeCreate stampCorrelationRef on AuditEvent[field: correlation_ref]
    %%hook beforeUpdate blockAmendment on AuditEvent
    %%hook beforeDelete blockDeletion on AuditEvent

