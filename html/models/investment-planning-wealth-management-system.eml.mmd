%% ---- Section 20: Workflow — client onboarding (saga) -----------------------
%% Runs when an onboarding case is opened: stands up the household record, the
%% financial profile and the risk profile the rest of the platform reads, then
%% moves the case on. Each step is a row somewhere else, so the flow is a saga
%% rather than a hook.
%%meta name: Client Onboarding
%%meta kind: workflow
%%workflow ClientOnboarding entity: OnboardingCase kind: saga trigger: automatic operation: INSERT
flowchart TD
    A([Onboarding case opened]) --> B{Grade the household}
    B --> C[Open the household]
    C --> D[Open the risk profile]
    D --> E[Open the financial plan]
    E --> F[Move the case to KYC]
    F --> G([Ready for KYC])

    %%step B Decision decisionTable: {"hitPolicy":"first","inputs":[{"id":"i1","name":"Investable","field":"estimated_aum"}],"outputs":[{"id":"o1","name":"Segment","field":"householdSegment"},{"id":"o2","name":"RiskBand","field":"openingRiskBand"}],"rules":[{"_id":"uhnw","i1":">= 5000000","o1":"'ultra_high_net_worth'","o2":"'moderately_aggressive'"},{"_id":"hnw","i1":">= 1000000","o1":"'high_net_worth'","o2":"'moderate'"},{"_id":"affluent","i1":">= 250000","o1":"'affluent'","o2":"'moderately_conservative'"},{"_id":"rest","i1":"","o1":"'retail'","o2":"'conservative'"}]}
    %%step C CreateEntity entity: Household as: newHouseholdId fields: {"name":"case_reference","status":"active","advisor_id":"advisor_id"}
    %%step D CreateEntity entity: RiskProfile as: newRiskProfileId fields: {"household_id":"newHouseholdId","risk_category":"openingRiskBand","status":"draft"}
    %%step E CreateEntity entity: FinancialPlan as: newFinancialPlanId fields: {"household_id":"newHouseholdId","advisor_id":"advisor_id","status":"draft"}
    %%step F UpdateEntity field: status value: kyc

%% ---- Section 21: Workflow — recommendation execution (saga) ----------------
%% What happens after a client accepts: the acceptance is what starts it, and it
%% ends with an order on the dealing desk and an audit row that says who did it.
%%meta name: Recommendation Execution
%%meta kind: workflow
%%workflow RecommendationExecution entity: ClientAcceptance kind: saga trigger: automatic operation: INSERT
flowchart TD
    A([Client accepted the proposal]) --> B{Size the first order}
    B --> C[Raise the order]
    C --> D[Write the audit record]
    D --> E[Close the acceptance]
    E --> F([Order with the desk])

    %%step B Decision decisionTable: {"hitPolicy":"first","inputs":[{"id":"i1","name":"Accepted","field":"accepted_amount"}],"outputs":[{"id":"o1","name":"OrderType","field":"openingOrderType"},{"id":"o2","name":"OrderAmount","field":"openingOrderAmount"}],"rules":[{"_id":"block","i1":">= 1000000","o1":"'block'","o2":"accepted_amount"},{"_id":"standard","i1":"","o1":"'market'","o2":"accepted_amount"}]}
    %%step C CreateEntity entity: Order as: newOrderId fields: {"client_id":"client_id","order_type":"openingOrderType","amount":"openingOrderAmount","status":"draft"}
    %%step D CreateEntity entity: AuditEvent as: newAuditEventId fields: {"action":"recommendation_executed","entity_type":"ClientAcceptance","entity_ref":"id","source":"saga"}
    %%step E UpdateEntity field: status value: accepted

%% ---- Section 22: Workflow — rebalancing (saga) -----------------------------
%% Drift is detected against the model portfolio; this is what the platform does
%% about it without waiting for anybody to open a screen.
%%meta name: Rebalancing
%%meta kind: workflow
%%workflow Rebalancing entity: RebalanceRecommendation kind: saga trigger: automatic operation: INSERT
flowchart TD
    A([Drift detected]) --> B{Grade the drift}
    B --> C[Size the corrective trade]
    C --> D[Write the audit record]
    D --> E[Move the rebalance to analysed]
    E --> F([Awaiting approval])

    %%step B Decision decisionTable: {"hitPolicy":"first","inputs":[{"id":"i1","name":"Deviation","field":"deviation_amount"}],"outputs":[{"id":"o1","name":"Urgency","field":"rebalanceUrgency"},{"id":"o2","name":"Factor","field":"correctionFactor"}],"rules":[{"_id":"urgent","i1":">= 100000","o1":"'priority'","o2":"1"},{"_id":"routine","i1":"","o1":"'routine'","o2":"0.5"}]}
    %%step C Formula target: correctiveTradeAmount operation: multiply source: deviation_amount operand: correctionFactor
    %%step D CreateEntity entity: AuditEvent as: newAuditEventId fields: {"action":"rebalance_detected","entity_type":"RebalanceRecommendation","entity_ref":"id","source":"saga"}
    %%step E UpdateEntity field: status value: analysed
