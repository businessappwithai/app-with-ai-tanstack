{
  "name": "@appwithai/eml-cli",
  "version": "0.0.1",
  "type": "module",
  "description": "Build applications from an EML (.mmd) model describing an ERD, business rules, and workflows.",
  "bin": {
    "eml": "./eml.ts"
  },
  "scripts": {
    "start": "bun eml.ts",
    "validate:examples": "bun eml.ts validate -i ../examples/crm.eml.mmd",
    "typecheck": "bun check"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "22",
    "bun-types": "^1.4.3",
    "typescript": "5.6.3"
  }
}
