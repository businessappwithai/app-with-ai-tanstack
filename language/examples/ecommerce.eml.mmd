%% ============================================================================
%% EML Example — E-Commerce
%% Data model + business rules + workflows for an online store, in one artifact.
%% All diagrams are valid, renderable Mermaid.
%% ============================================================================

%% ---- Section 1: ERD --------------------------------------------------------
%%meta name: Store Core
%%meta kind: erd
%%meta version: 1.0.0
%%enum OrderStatus: cart, placed, paid, packed, shipped, delivered, cancelled, refunded
%%enum FulfilmentEvent: place, pay, pack, ship, deliver, cancel, refund
%%enum PaymentStatus: pending, authorized, captured, failed, refunded
%%enum PaymentMethod: card, paypal, bank_transfer, gift_card
erDiagram
    Customer {
        string  id PK
        string  email UK
        string  password_hash
        string  first_name
        string  last_name
        string  phone OPTIONAL
        boolean is_verified
    }

    Product {
        string  id PK
        string  name
        string  sku UK
        text    description OPTIONAL
        decimal unit_price
        integer stock_qty
        boolean is_active
    }

    Category {
        string id PK
        string name
        string parent_id FK OPTIONAL
    }

    Order {
        string  id PK
        string  customer_id FK
        string  order_number UK
        string  status
        decimal subtotal
        decimal discount_amount
        decimal shipping_amount
        decimal total_amount
        datetime placed_at OPTIONAL
        datetime paid_at OPTIONAL
        datetime cancelled_at OPTIONAL
        datetime packed_at OPTIONAL
        datetime shipped_at OPTIONAL
        datetime delivered_at OPTIONAL
        datetime refunded_at OPTIONAL
    }

    OrderItem {
        string  id PK
        string  order_id FK
        string  product_id FK
        integer quantity
        decimal unit_price
        decimal line_total
    }

    Payment {
        string  id PK
        string  order_id FK
        string  method
        string  status
        decimal amount
        datetime captured_at OPTIONAL
    }

    Customer ||--o{ Order     : "places"
    Order    ||--o{ OrderItem : "contains"
    Product  ||--o{ OrderItem : "ordered_in"
    Order    ||--o{ Payment   : "paid_by"
    Category ||--o{ Product   : "categorizes"
    Category ||--o{ Category  : "has_subcategory"

    %%field Order.status enum: OrderStatus
    %%field Payment.status enum: PaymentStatus
    %%field Payment.method enum: PaymentMethod
    %%index Order(customer_id, status)
    %%index Product(sku) unique
    %%entity Order audited: true
    %%entity OrderItem parent: Order

    %%entity Customer help: A shopper with an account on the store. The account is what carries an order history, a saved address book and a verified contact address, so a customer exists before an order does and outlives every order they place.
    %%field Customer.email help: The address the customer signs in with and where order confirmations, dispatch notices and refunds are sent. Unique across the store — a second account on the same address splits one shopper's history in two.
    %%field Customer.password_hash help: The stored hash of the customer's password, never the password. Written only by the sign-up and password-reset flows; nothing else reads or displays it.
    %%field Customer.first_name help: How the customer is greeted in email and on the account page. Kept apart from the surname because most correspondence uses only this half.
    %%field Customer.last_name help: The family name, used together with the first name on invoices and delivery labels where a full name is required.
    %%field Customer.phone help: A number the courier can call on the day of delivery. Optional at sign-up, but an order without one is the usual reason a failed delivery cannot be rescued.
    %%field Customer.is_verified help: Whether the customer has confirmed their email address by following the link sent at sign-up. An unverified account can browse but should not be trusted with order notifications, because the address may belong to somebody else.

    %%entity Product help: Something the store sells, priced and counted. A product carries the list price an order line copies at the moment of sale and the stock figure fulfilment works from, which is why it is never deleted once it has been ordered — deactivating it takes it off the storefront and leaves the order history intact.
    %%field Product.name help: The product as it appears on the storefront, in search results and on the invoice line. Write it the way a shopper would recognise it, not the way the warehouse labels it.
    %%field Product.sku help: The stock-keeping unit — the warehouse's own code for this item, and the identifier the store shares with suppliers and couriers. Unique, and it does not change: a reused SKU makes two products indistinguishable in every stock report ever run.
    %%field Product.description help: What the shopper needs to know before buying — what it is, what is in the box, what it does not include. Optional, though a product without one converts noticeably worse.
    %%field Product.unit_price help: The current list price, before any discount. An order line copies this figure when the line is created rather than referring to it, so a later price change never rewrites what somebody already agreed to pay.
    %%field Product.stock_qty help: Units physically available to promise. Fulfilment decrements it when an order is packed, so a figure that drifts from the shelf is what causes an order to be accepted and then cancelled.
    %%field Product.is_active help: Whether the product is offered for sale. Cleared instead of deleting a discontinued line, which would break every historical order that contains it.

    %%entity Category help: A branch of the storefront's navigation. Categories nest — a category may name another as its parent — so the tree is what a shopper walks down and what the merchandising team reorganises without touching a single product.
    %%field Category.name help: The heading shoppers see in navigation and breadcrumbs. Keep it short: it is read in a menu, not in a sentence.
    %%field Category.parent_id help: The category this one sits under, empty for a top-level branch. This is what makes the navigation a tree rather than a flat list; a category pointing at its own descendant would make it a loop, so it is checked before it is saved.

    %%entity Order help: One purchase, from the basket a shopper is still filling to a delivered or refunded transaction. The order carries the money — subtotal, discount, shipping and total — and its status is the single answer to "where is this". It is audited, because the question after any billing dispute is who changed what and when.
    %%field Order.customer_id help: The shopper this order belongs to. It decides where confirmations are sent and which account the order appears under, and it is fixed once the order is placed.
    %%field Order.order_number help: The human-readable reference quoted in email, on the invoice and by anyone phoning about the order. Unique, and deliberately not the record's key: it is a number people read out.
    %%field Order.status help: cart — still being filled and freely editable; placed — submitted and awaiting payment; paid, packed, shipped, delivered — the fulfilment path; cancelled and refunded — the two ways it ends early. Only the moves the fulfilment diagram draws are allowed, so an order cannot ship before it is paid.
    %%field Order.subtotal help: The order's lines added up at the prices agreed when each was added, before discount and shipping. Recalculated by the pricing rule whenever a line changes.
    %%field Order.discount_amount help: What has been taken off the subtotal — a promotion, a voucher or an agreed goodwill reduction. Held separately from the line prices so a discount is always visible as a decision rather than hidden in the arithmetic.
    %%field Order.shipping_amount help: What the shopper is charged to have the order delivered, from the shipping band the basket qualifies for. Added after the discount, so a discount never reduces the carriage charge.
    %%field Order.total_amount help: What the customer actually owes: subtotal less discount, plus shipping. This is the figure payment is taken against, so a payment that does not match it is the first thing reconciliation looks for.
    %%field Order.placed_at help: When the shopper submitted the order. Empty while it is still a cart, and it is the clock every delivery promise is measured from.

    %%entity OrderItem help: One product on one order, at the quantity and price agreed. A line has no meaning away from its order — line 2 of order 4417, not line 2 — which is why it is a line item of the order rather than a screen of its own.
    %%field OrderItem.order_id help: The order this line belongs to. It is what the order's own screen lists the lines by, and the reason a line is never opened on its own.
    %%field OrderItem.product_id help: What was bought. It is the reference the warehouse picks against, and the only link back from a sale to the product's stock and description.
    %%field OrderItem.quantity help: How many units of the product this line covers. Multiplied by the unit price to give the line total, and the figure stock is decremented by when the order is packed.
    %%field OrderItem.unit_price help: The price per unit **as agreed when the line was added**, copied from the product rather than referenced. This is what makes an old order still show the price the customer actually paid after the product's list price has moved.
    %%field OrderItem.line_total help: Quantity multiplied by unit price, stored rather than recomputed so the order's arithmetic can be audited line by line without re-deriving prices that have since changed.

    %%entity Payment help: One attempt to collect money against an order. An order can carry several — a failed card followed by a successful one, a gift card topped up by a card, a refund — so payments are a list rather than a field, and the order is settled only when the captured amounts cover its total.
    %%field Payment.order_id help: The order this money is for. Everything about reconciliation starts here: a payment whose order is missing or already refunded is the exception a finance team chases.
    %%field Payment.method help: card, paypal, bank_transfer or gift_card. It decides how a refund has to be returned — money goes back the way it came — and how long settlement takes.
    %%field Payment.status help: pending — submitted, no answer yet; authorized — funds reserved, not taken; captured — money actually collected; failed — declined, and the order stays unpaid; refunded — returned to the customer. Only a captured payment counts towards the order's total.
    %%field Payment.amount help: The sum this payment moves. It need not equal the order total: part payments, gift-card balances and partial refunds are all normal, which is why settlement is the sum of captured payments rather than a single figure.
    %%field Payment.captured_at help: When the money was actually taken, as opposed to reserved. Empty until capture, and it is the date that appears on the customer's statement and in the day's takings.

    %% Form layout: headed sections of two-column rows (`|` between rows,
    %% `,` within one; a row of one spans the full width).
    %%section entity: Customer; name: Customer; help: Who is buying and how the shop reaches them about orders.; rows: first_name, last_name | email, phone
    %%section entity: Customer; name: Account security; help: The sign-in secret and whether the email address has been proven to belong to the customer.; rows: password_hash, is_verified; collapsed: true
    %%section entity: Product; name: Product; help: What is sold, the SKU it is picked by, and whether it is on sale.; rows: name, sku | is_active | description
    %%section entity: Product; name: Price and stock; help: What one unit costs and how many can still be sold before the shelf is empty.; rows: unit_price, stock_qty
    %%section entity: Category; name: Category; help: Where the category sits in the shop's navigation tree.; rows: name, parent_id
    %%section entity: Order; name: Order; help: Which order this is, who placed it, when, and where it stands.; rows: order_number | customer_id, placed_at
    %%section entity: Order; name: Totals; help: How the amount charged is made up — the lines, less discount, plus shipping.; rows: subtotal, discount_amount | shipping_amount, total_amount
    %%section entity: OrderItem; name: Item; help: One product on the order, how many, and what the line adds to the subtotal.; rows: order_id, product_id | quantity, unit_price | line_total
    %%section entity: Payment; name: Payment; help: The money taken for the order — how, how much, and whether it has been captured.; rows: order_id, status | method, amount | captured_at

%% ---- Section 2: Business rule — pricing & discount -------------------------
%%meta name: Order Pricing
%%meta kind: rules
%%rule pricing on Order event: beforeUpdate priority: 10
flowchart TD
    A([Start: Order Repriced]) --> B{Subtotal > 1000?}
    B -->|Yes| C[Apply Premium Discount 15%]
    B -->|No| D{Customer is_verified?}
    D -->|Yes| E[Apply Loyalty Discount 5%]
    D -->|No| F[No Discount]
    C --> G(Calculate Total)
    E --> G
    F --> G
    G --> H([End: Priced])

%% ---- Section 3: Business rule — free shipping eligibility ------------------
%%meta name: Free Shipping
%%meta kind: rules
%%rule freeShipping on Order event: beforeUpdate priority: 20
flowchart TD
    S([Start]) --> Q1{Total >= 50?}
    Q1 -->|No| P1[Charge Standard Shipping]
    Q1 -->|Yes| Q2{Item count >= 3?}
    Q2 -->|Yes| P2[Free Express Shipping]
    Q2 -->|No| P3[Free Standard Shipping]
    P1 --> R((Set Shipping Amount))
    P2 --> R
    P3 --> R
    R --> E([End])

%% ---- Section 4: Workflow — order fulfilment (state machine) ----------------
%%meta name: Order Fulfilment
%%meta kind: workflow
%%workflow OrderFulfilment entity: Order kind: state
stateDiagram-v2
    [*] --> cart
    cart      --> placed    : place
    placed    --> paid      : pay
    placed    --> cancelled : cancel
    paid      --> packed    : pack
    packed    --> shipped   : ship
    shipped   --> delivered : deliver
    paid      --> refunded  : refund
    delivered --> [*]
    cancelled --> [*]
    refunded  --> [*]

    %%trigger webhook:payment -> markPaid on Order
    %%trigger webhook:carrier -> markShipped on Order

%% ---- Section 5: Workflow — checkout hooks ----------------------------------
%%meta name: Checkout Hooks
%%meta kind: workflow
%%workflow CheckoutHooks entity: Order kind: hook
flowchart TD
    A[Client Request] --> B[Validate Cart]
    B --> C[customValidate: ensureStockAvailable]
    C --> D[beforeUpdate: recomputeTotals]
    D --> E[Process Order]
    E --> F[afterUpdate: decrementInventory]
    F --> G[afterUpdate: sendOrderConfirmation]
    G --> H[Response]

    %%hook customValidate ensureStockAvailable on Order
    %%hook beforeUpdate recomputeTotals on Order
    %%hook afterUpdate decrementInventory on Order
    %%hook afterUpdate sendOrderConfirmation on Order

%% ---- The state field is system-managed: each move is a rule and a saga ----
%% Nobody changes a state by hand. Recording the time a move depends on starts
%% the saga that sets the state; generated by the state-rule migration.
%%field Order.paid_at help: When the move to paid was recorded on this order. Recording it moves an order from placed to paid: the workflows set the status, which nobody changes by hand.
%%field Order.cancelled_at help: When the move to cancelled was recorded on this order. Recording it moves an order from placed to cancelled: the workflows set the status, which nobody changes by hand.
%%field Order.packed_at help: When the move to packed was recorded on this order. Recording it moves an order from paid to packed: the workflows set the status, which nobody changes by hand.
%%field Order.shipped_at help: When the move to shipped was recorded on this order. Recording it moves an order from packed to shipped: the workflows set the status, which nobody changes by hand.
%%field Order.delivered_at help: When the move to delivered was recorded on this order. Recording it moves an order from shipped to delivered: the workflows set the status, which nobody changes by hand.
%%field Order.refunded_at help: When the move to refunded was recorded on this order. Recording it moves an order from paid to refunded: the workflows set the status, which nobody changes by hand.
%%section entity: Order; name: Progress; help: The times that move this order along its lifecycle. Recording one is how its status changes; the status itself is shown in the header.; rows: paid_at, cancelled_at | packed_at, shipped_at | delivered_at, refunded_at

%%meta name: Order placed move
%%meta kind: workflow
%%workflow OrderPlacedMove entity: Order kind: saga trigger: rule
flowchart TD
    A([Move to placed recorded]) --> B[Set the status to placed]
    B --> C[Clear paid at for the next move]
    C --> D[Clear cancelled at for the next move]
    D --> Z([Placed])

    %%step B UpdateEntity field: status value: placed
    %%step C UpdateEntity field: paid_at value: null
    %%step D UpdateEntity field: cancelled_at value: null

%%meta name: Order paid move
%%meta kind: workflow
%%workflow OrderPaidMove entity: Order kind: saga trigger: rule
flowchart TD
    A([Move to paid recorded]) --> B[Set the status to paid]
    B --> C[Clear packed at for the next move]
    C --> D[Clear refunded at for the next move]
    D --> Z([Paid])

    %%step B UpdateEntity field: status value: paid
    %%step C UpdateEntity field: packed_at value: null
    %%step D UpdateEntity field: refunded_at value: null

%%meta name: Order cancelled move
%%meta kind: workflow
%%workflow OrderCancelledMove entity: Order kind: saga trigger: rule
flowchart TD
    A([Move to cancelled recorded]) --> B[Set the status to cancelled]
    B --> Z([Cancelled])

    %%step B UpdateEntity field: status value: cancelled

%%meta name: Order packed move
%%meta kind: workflow
%%workflow OrderPackedMove entity: Order kind: saga trigger: rule
flowchart TD
    A([Move to packed recorded]) --> B[Set the status to packed]
    B --> C[Clear shipped at for the next move]
    C --> Z([Packed])

    %%step B UpdateEntity field: status value: packed
    %%step C UpdateEntity field: shipped_at value: null

%%meta name: Order shipped move
%%meta kind: workflow
%%workflow OrderShippedMove entity: Order kind: saga trigger: rule
flowchart TD
    A([Move to shipped recorded]) --> B[Set the status to shipped]
    B --> C[Clear delivered at for the next move]
    C --> Z([Shipped])

    %%step B UpdateEntity field: status value: shipped
    %%step C UpdateEntity field: delivered_at value: null

%%meta name: Order delivered move
%%meta kind: workflow
%%workflow OrderDeliveredMove entity: Order kind: saga trigger: rule
flowchart TD
    A([Move to delivered recorded]) --> B[Set the status to delivered]
    B --> Z([Delivered])

    %%step B UpdateEntity field: status value: delivered

%%meta name: Order refunded move
%%meta kind: workflow
%%workflow OrderRefundedMove entity: Order kind: saga trigger: rule
flowchart TD
    A([Move to refunded recorded]) --> B[Set the status to refunded]
    B --> Z([Refunded])

    %%step B UpdateEntity field: status value: refunded

%%meta name: Order State Progress
%%meta kind: rules
%%rule orderStateProgress on Order event: beforeUpdate priority: 90
flowchart TD
    A([Order updated]) --> B{Is the time of a move recorded?}
    B -->|Yes| C[Start that move's workflow]
    B -->|No| E([Nothing to move])
    C --> E

    %%action moveCartToPlaced trigger-workflow when: status == "cart" and placed_at != null workflow: OrderPlacedMove
    %%action movePlacedToPaid trigger-workflow when: status == "placed" and paid_at != null workflow: OrderPaidMove
    %%action movePlacedToCancelled trigger-workflow when: status == "placed" and cancelled_at != null workflow: OrderCancelledMove
    %%action movePaidToPacked trigger-workflow when: status == "paid" and packed_at != null workflow: OrderPackedMove
    %%action movePackedToShipped trigger-workflow when: status == "packed" and shipped_at != null workflow: OrderShippedMove
    %%action moveShippedToDelivered trigger-workflow when: status == "shipped" and delivered_at != null workflow: OrderDeliveredMove
    %%action movePaidToRefunded trigger-workflow when: status == "paid" and refunded_at != null workflow: OrderRefundedMove
