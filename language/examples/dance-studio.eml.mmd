%% ============================================================================
%% EML Example — Acme Dance Studio / Class Booking
%%
%% A booking business, modelled end to end: nine entities, both state machines
%% a booking business actually has, the cancellation cutoff that decides whether
%% a credit comes back, and the saga that promotes a waitlisted member when a
%% place is released.
%%
%% Written as the worked example for the interactive authoring protocol in
%% llmtext/llmdetailed.txt §10, so it holds that section's standard: help text
%% on every entity and every column, one %%rbac read rule per entity, and every
%% state backed by a declared %%enum. 0 errors, 0 warnings, clean under
%% --strict. Every diagram is valid, renderable Mermaid.
%% ============================================================================

%%meta name: Acme Dance Studio
%%meta kind: erd
%%meta version: 1.0.0
%%category name: Scheduling; icon: calendar; entities: ClassOffering, ClassSession, Room
%%category name: Membership; icon: users; entities: Member, ClassPack, Booking
%%category name: Teaching; icon: user-check; entities: Instructor
%%category name: Finance; icon: credit-card; entities: Payment
%%enum MemberStatus: active, lapsed, suspended
%%enum ClassLevel: beginner, improver, intermediate, advanced
%%enum SessionStatus: scheduled, running, completed, cancelled
%%enum BookingStatus: held, attended, cancelled, forfeited, no_show
%%enum WaitlistStatus: waiting, promoted, expired
%%enum PackStatus: active, exhausted, expired
%%enum PaymentMethod: card, cash, bank_transfer
erDiagram
    Member {
        string   id PK
        string   email UK
        string   full_name
        string   phone OPTIONAL
        string   status
        date     joined_on
        boolean  marketing_opt_in
    }

    Instructor {
        string   id PK
        string   email UK
        string   full_name
        string   bio OPTIONAL
        boolean  is_active
    }

    Room {
        string   id PK
        string   code UK
        string   name
        integer  capacity
        boolean  is_active
    }

    ClassOffering {
        string   id PK
        string   code UK
        string   name
        string   level
        integer  duration_minutes
        integer  credit_cost
        boolean  is_active
    }

    ClassSession {
        string   id PK
        string   class_offering_id FK
        string   room_id FK
        string   instructor_id FK
        datetime starts_at
        datetime ends_at
        integer  capacity
        string   status
        text     cancellation_reason OPTIONAL
    }

    Booking {
        string   id PK
        string   class_session_id FK
        string   member_id FK
        string   class_pack_id FK OPTIONAL
        string   status
        datetime booked_at
        datetime cancelled_at OPTIONAL
        boolean  fee_waived
        text     waiver_reason OPTIONAL
    }

    WaitlistEntry {
        string   id PK
        string   class_session_id FK
        string   member_id FK
        integer  queue_position
        string   status
        datetime joined_at
    }

    ClassPack {
        string   id PK
        string   member_id FK
        integer  credits_purchased
        integer  credits_remaining
        date     purchased_on
        date     expires_on
        string   status
    }

    Payment {
        string   id PK
        string   class_pack_id FK
        decimal  amount
        string   method
        datetime received_at
        string   reference OPTIONAL
    }

    ClassOffering ||--o{ ClassSession  : "scheduled as"
    Room          ||--o{ ClassSession  : "hosts"
    Instructor    ||--o{ ClassSession  : "teaches"
    ClassSession  ||--o{ Booking       : "holds"
    ClassSession  ||--o{ WaitlistEntry : "queues"
    Member        ||--o{ Booking       : "makes"
    Member        ||--o{ WaitlistEntry : "joins"
    Member        ||--o{ ClassPack     : "buys"
    ClassPack     ||--o{ Booking       : "pays for"
    ClassPack     ||--o{ Payment       : "settled by"

    %%entity Member help: A person who buys class packs and books places in sessions. Created at first sign-up and kept after their last booking so attendance history survives.
    %%entity Instructor help: A teacher the studio schedules against sessions. Kept separate from Member because an instructor may also attend classes as a member.
    %%entity Room help: A physical studio space with a capacity. The capacity is the ceiling a session's bookable places are set from.
    %%entity ClassOffering help: A class the studio sells — a name, a level and a duration. Distinct from the individual sessions it is scheduled as.
    %%entity ClassSession help: One dated, timed occurrence of an offering, in a room, taught by an instructor. This is the thing a member actually books.
    %%entity Booking help: One member's place in one session. Created when the place is taken; terminal once attended, cancelled, forfeited or marked a no-show.
    %%entity WaitlistEntry help: A member's position in the queue for a full session. Promoted to a Booking in join order when a place is released.
    %%entity ClassPack help: A block of prepaid class credits bought by a member. Credits are drawn down by bookings and expire on a fixed date.
    %%entity Payment help: Money received against a class pack. Recorded once and never edited; a correction is a second, offsetting record.
    %%entity WaitlistEntry parent: ClassSession

    %%field Member.email help: The address all booking confirmations and cancellation notices go to. Unique — a second sign-up with the same address updates the existing member rather than creating a rival record.
    %%field Member.full_name help: The name shown on the instructor's attendance sheet. Stored as one field because the studio prints it, never sorts by surname.
    %%field Member.phone help: Used only for same-day cancellations, where email is too slow to be worth sending. Optional; most members never supply one.
    %%field Member.status help: active — may book; lapsed — no active pack, still visible for re-engagement; suspended — barred from booking after repeated no-shows, cleared by a manager.
    %%field Member.joined_on help: The date of first sign-up. Drives the loyalty reporting and never changes, even if the member lapses and returns.
    %%field Member.marketing_opt_in help: Consent to receive class announcements. Must be set by the member, never by staff; cleared on request and the clearing is audited.
    %%field Instructor.email help: The address the weekly teaching rota is sent to. Unique per instructor.
    %%field Instructor.full_name help: The name shown on the public timetable beside each session.
    %%field Instructor.bio help: The short paragraph shown on the timetable when a member taps the instructor's name. Optional; blank hides the panel entirely.
    %%field Instructor.is_active help: Cleared when an instructor stops teaching. Inactive instructors keep their session history but cannot be assigned to a new session.
    %%field Room.code help: The short label staff use on the printed timetable, e.g. STU1. Unique, and stable — it is written on the door.
    %%field Room.name help: The full room name shown to members, e.g. "Main Studio".
    %%field Room.capacity help: The maximum number of people the room legally holds. A session's own capacity may be lower but is never allowed above this.
    %%field Room.is_active help: Cleared while a room is out of use for refurbishment. Inactive rooms keep their past sessions but cannot take new ones.
    %%field ClassOffering.code help: The short code used on the timetable and in reporting, e.g. BALLET-1. Unique and stable across terms.
    %%field ClassOffering.name help: The class name members see when browsing the timetable.
    %%field ClassOffering.level help: beginner — no experience assumed; improver — one term completed; intermediate — assessed by an instructor; advanced — invitation only. The booking rule reads this against the member's history.
    %%field ClassOffering.duration_minutes help: How long a session of this class runs. Used to compute a session's end time when it is scheduled, so a change here does not move sessions already booked.
    %%field ClassOffering.credit_cost help: How many pack credits one place in this class costs. Advanced classes cost more than one; the booking rule refuses when the pack cannot cover it.
    %%field ClassOffering.is_active help: Cleared when a class is retired from the timetable. Past sessions survive; no new session can be scheduled against it.
    %%field ClassSession.class_offering_id help: The class being taught. Fixed at scheduling — moving a session to a different class is a cancellation and a new session, because the members who booked chose the class.
    %%field ClassSession.room_id help: Where the session runs. Changing it after bookings exist notifies every booked member, because the room is on the door they walk to.
    %%field ClassSession.instructor_id help: Who teaches it. A substitution is an edit here and is deliberately not a cancellation — the class still runs.
    %%field ClassSession.starts_at help: When the class begins, in studio local time. The cancellation cutoff is measured back from this, so it is the field the forfeit rule reads.
    %%field ClassSession.ends_at help: When the class finishes. Derived from the offering's duration at scheduling time and held rather than recomputed, so a later change to the offering cannot move a session already sold.
    %%field ClassSession.capacity help: Places available in this session. Seeded from the room's capacity and lowered for classes that need floor space; never raised above the room's.
    %%field ClassSession.status help: scheduled — open for booking; running — started, no longer bookable; completed — attendance taken; cancelled — the studio pulled it, which credits every held booking back.
    %%field ClassSession.cancellation_reason help: Why the studio cancelled. Shown to every affected member in the cancellation notice, so it is written for them, not for staff.
    %%field Booking.class_session_id help: The session the place is held in. Never changed — moving to another session is a cancellation and a new booking, so the credit accounting stays honest.
    %%field Booking.member_id help: Who holds the place. A booking may not be transferred between members; the studio's insurance names the attendee.
    %%field Booking.class_pack_id help: The pack the credit was drawn from. Blank for a drop-in place paid at the door, which is why it is optional.
    %%field Booking.status help: held — the place is reserved; attended — the member came; cancelled — released before the cutoff, credit returned; forfeited — released after the cutoff, credit kept; no_show — never cancelled and never attended, credit kept and counted toward suspension.
    %%field Booking.booked_at help: When the place was taken. Sets the member's position if the booking is later cancelled and the waitlist promotes in join order.
    %%field Booking.cancelled_at help: When the member released the place. Compared against the session's start to decide cancelled versus forfeited, so it is the field the cutoff rule reads.
    %%field Booking.fee_waived help: Set when a manager returns a credit that the cutoff rule had forfeited. Every waiver appears on the monthly exceptions report.
    %%field Booking.waiver_reason help: Why the forfeit was waived. Required whenever fee_waived is set — an unexplained waiver is the one the auditor asks about.
    %%field WaitlistEntry.class_session_id help: The full session being waited for. This is the link back to the parent record, so the entry appears as a tab on the session rather than a screen of its own.
    %%field WaitlistEntry.member_id help: Who is waiting. A member may hold only one entry per session.
    %%field WaitlistEntry.queue_position help: Place in the queue, lowest first. Assigned on joining and never renumbered, so a promotion cannot quietly reorder the people behind it.
    %%field WaitlistEntry.status help: waiting — still queued; promoted — a place was released and a Booking now exists; expired — the session started before a place came free.
    %%field WaitlistEntry.joined_at help: When the member joined the queue. The tiebreaker when two entries somehow share a position.
    %%field ClassPack.member_id help: Who owns the credits. Packs are not transferable between members, including within a household.
    %%field ClassPack.credits_purchased help: How many credits were bought. Never changes — a top-up is a second pack, which keeps each pack's expiry independent.
    %%field ClassPack.credits_remaining help: Credits still available. Decremented when a booking is held and returned when a booking is cancelled before the cutoff, but not when it is forfeited.
    %%field ClassPack.purchased_on help: The date of purchase. The expiry is measured from here, so a backdated purchase shortens the pack.
    %%field ClassPack.expires_on help: The last date a credit may be spent. Booking a session that starts after this date is refused even when credits remain.
    %%field ClassPack.status help: active — credits available and unexpired; exhausted — every credit spent; expired — the date passed with credits unspent, which the studio does not refund.
    %%field Payment.class_pack_id help: The pack this money bought. One pack may be settled by more than one payment where the studio allowed a split.
    %%field Payment.amount help: The sum received, gross, in studio currency. Never edited — a correction is a second, negative record so the trail stays intact.
    %%field Payment.method help: card — taken at the desk or online; cash — counted into the till and reconciled nightly; bank_transfer — matched against the statement, so it may be recorded days after the pack was issued.
    %%field Payment.received_at help: When the money actually arrived, not when it was keyed in. Bank transfers are commonly recorded late and the reconciliation depends on this distinction.
    %%field Payment.reference help: The card authorisation code or bank reference used to match the payment against the statement. Optional for cash, where there is nothing to match.

    %%field Member.status enum: MemberStatus
    %%field ClassOffering.level enum: ClassLevel
    %%field ClassSession.status enum: SessionStatus
    %%field Booking.status enum: BookingStatus
    %%field WaitlistEntry.status enum: WaitlistStatus
    %%field ClassPack.status enum: PackStatus
    %%field Payment.method enum: PaymentMethod

    %%index ClassSession(starts_at, status)
    %%index Booking(class_session_id, status)
    %%index Booking(member_id, status)
    %%index WaitlistEntry(class_session_id, queue_position)
    %%index ClassPack(member_id, status)

    %%rbac role:member|receptionist|manager on Member.read
    %%rbac role:receptionist|manager on Member.update
    %%rbac role:manager on Member.delete
    %%rbac role:member|receptionist|instructor|manager on Instructor.read
    %%rbac role:manager on Instructor.update
    %%rbac role:receptionist|manager on Room.read
    %%rbac role:manager on Room.update
    %%rbac role:member|receptionist|instructor|manager on ClassOffering.read
    %%rbac role:manager on ClassOffering.update
    %%rbac role:member|receptionist|instructor|manager on ClassSession.read
    %%rbac role:receptionist|manager on ClassSession.update
    %%rbac role:manager on ClassSession.cancel
    %%rbac role:member|receptionist|instructor|manager on Booking.read
    %%rbac role:member|receptionist|manager on Booking.create
    %%rbac role:instructor|receptionist|manager on Booking.attend
    %%rbac role:manager on Booking.waive
    %%rbac role:member|receptionist|manager on WaitlistEntry.read
    %%rbac role:member|receptionist|manager on ClassPack.read
    %%rbac role:receptionist|manager on ClassPack.create
    %%rbac role:receptionist|manager on Payment.read
    %%rbac role:receptionist|manager on Payment.create

%% ---- The reporting pass (llmdetailed §10.5.1) -----------------------------
%%
%% What the derived pack already gives this model without being asked: a
%% register per entity, a breakdown per %%enum-bound column, created-per-month,
%% a lifecycle report over both state machines in the diagram's own order, and
%% children-per-parent for all 10 relationships. None of that needed anyone who
%% understands how a studio fills a room.
%%
%% These do. Each of the four roles on the %%rbac matrix above is walked through
%% the four questions — what they open first, what tells them something is wrong
%% today, what they are asked for weekly, and what rots silently if nobody
%% looks — so each can do its whole job from what it can see.

%% -- member: their own classes and credits -----------------------------------
    %%report member-upcoming-bookings title: Places held for upcoming classes entity: Booking help: The screen a member opens to check what they have committed to this week. A held place is a seat nobody else can take, so a member who has forgotten one costs the studio the room. sql: SELECT m.full_name AS member, o.name AS class, i.full_name AS instructor, s.starts_at FROM bus_booking b JOIN bus_member m ON m.id = b.member_id JOIN bus_class_session s ON s.id = b.class_session_id JOIN bus_class_offering o ON o.id = s.class_offering_id LEFT JOIN bus_instructor i ON i.id = s.instructor_id WHERE b.deleted_at IS NULL AND s.deleted_at IS NULL AND b.status = 'held' AND s.starts_at > now() ORDER BY s.starts_at
    %%report member-classes-with-places title: Upcoming classes that still have room entity: ClassSession help: What a member actually wants: not a list of classes, but the ones they can still get into. Capacity minus places already held, so a full class never appears. sql: SELECT o.name AS class, o.level, i.full_name AS instructor, s.starts_at, s.capacity - COUNT(b.id) AS places_left FROM bus_class_session s JOIN bus_class_offering o ON o.id = s.class_offering_id LEFT JOIN bus_instructor i ON i.id = s.instructor_id LEFT JOIN bus_booking b ON b.class_session_id = s.id AND b.deleted_at IS NULL AND b.status = 'held' WHERE s.deleted_at IS NULL AND s.status = 'scheduled' AND s.starts_at > now() GROUP BY s.id, o.name, o.level, i.full_name, s.starts_at, s.capacity HAVING s.capacity - COUNT(b.id) > 0 ORDER BY s.starts_at
    %%report member-credits-expiring title: Credits about to expire unused entity: ClassPack help: A pack expires on a date nobody is told about, and the credits simply stop existing. Thirty days is enough notice to book them and not so much that the warning is ignored. sql: SELECT m.full_name AS member, p.credits_remaining, p.expires_on, (p.expires_on - now()::date) AS days_left FROM bus_class_pack p JOIN bus_member m ON m.id = p.member_id WHERE p.deleted_at IS NULL AND p.status = 'active' AND p.credits_remaining > 0 AND p.expires_on BETWEEN now()::date AND (now() + interval '30 days')::date ORDER BY p.expires_on
    %%report member-waitlist-standing title: Where each member sits on a waitlist entity: WaitlistEntry help: A member on a waitlist wants one number: how many people are ahead of them. Without it they book a second class they do not need, and then cancel one of the two late. sql: SELECT m.full_name AS member, o.name AS class, s.starts_at, w.queue_position FROM bus_waitlist_entry w JOIN bus_member m ON m.id = w.member_id JOIN bus_class_session s ON s.id = w.class_session_id JOIN bus_class_offering o ON o.id = s.class_offering_id WHERE w.deleted_at IS NULL AND s.deleted_at IS NULL AND w.status = 'waiting' AND s.starts_at > now() ORDER BY s.starts_at, w.queue_position

%% -- receptionist: the desk, today -------------------------------------------
    %%report reception-today-roster title: Today's classes and who is coming entity: ClassSession help: The first thing opened at the desk each morning, and the sheet the register is taken from. Held rather than attended, because attendance is what the day is about to record. sql: SELECT o.name AS class, i.full_name AS instructor, r.name AS room, s.starts_at, s.capacity, COUNT(b.id) AS booked FROM bus_class_session s JOIN bus_class_offering o ON o.id = s.class_offering_id LEFT JOIN bus_instructor i ON i.id = s.instructor_id LEFT JOIN bus_room r ON r.id = s.room_id LEFT JOIN bus_booking b ON b.class_session_id = s.id AND b.deleted_at IS NULL AND b.status = 'held' WHERE s.deleted_at IS NULL AND s.status IN ('scheduled', 'running') AND s.starts_at >= date_trunc('day', now()) AND s.starts_at < date_trunc('day', now()) + interval '1 day' GROUP BY s.id, o.name, i.full_name, r.name, s.starts_at, s.capacity ORDER BY s.starts_at
    %%report reception-waitlist-with-space title: People waiting for a class that has room entity: WaitlistEntry help: The exception that should never exist. Somebody is waiting on a session with an empty place, which means the promotion saga did not run or a cancellation freed a seat nobody handed on. Fix it by hand today. sql: SELECT m.full_name AS member, o.name AS class, s.starts_at, w.queue_position, s.capacity - COUNT(b.id) AS places_free FROM bus_waitlist_entry w JOIN bus_member m ON m.id = w.member_id JOIN bus_class_session s ON s.id = w.class_session_id JOIN bus_class_offering o ON o.id = s.class_offering_id LEFT JOIN bus_booking b ON b.class_session_id = s.id AND b.deleted_at IS NULL AND b.status = 'held' WHERE w.deleted_at IS NULL AND s.deleted_at IS NULL AND w.status = 'waiting' AND s.status = 'scheduled' AND s.starts_at > now() GROUP BY w.id, m.full_name, o.name, s.starts_at, w.queue_position, s.capacity HAVING s.capacity - COUNT(b.id) > 0 ORDER BY s.starts_at, w.queue_position
    %%report reception-packs-without-payment title: Class packs with no payment recorded entity: ClassPack help: Credits were issued and no money was ever attached to them. Almost always a card that failed after the pack was created, and it is invisible from the member screen. sql: SELECT m.full_name AS member, p.credits_purchased, p.purchased_on, p.status FROM bus_class_pack p JOIN bus_member m ON m.id = p.member_id LEFT JOIN bus_payment y ON y.class_pack_id = p.id AND y.deleted_at IS NULL WHERE p.deleted_at IS NULL GROUP BY p.id, m.full_name, p.credits_purchased, p.purchased_on, p.status HAVING COUNT(y.id) = 0 ORDER BY p.purchased_on DESC
    %%report reception-lapsed-holding-credits title: Lapsed members who still hold credits entity: Member help: Someone stopped coming while still owning classes they paid for. It is the cheapest call the desk can make, and the member is usually glad to be reminded. sql: SELECT m.full_name AS member, m.email, m.phone, SUM(p.credits_remaining) AS credits, MIN(p.expires_on) AS first_expiry FROM bus_member m JOIN bus_class_pack p ON p.member_id = m.id AND p.deleted_at IS NULL AND p.status = 'active' AND p.credits_remaining > 0 WHERE m.deleted_at IS NULL AND m.status = 'lapsed' GROUP BY m.id, m.full_name, m.email, m.phone ORDER BY credits DESC
    %%report reception-recent-no-shows title: No-shows worth a phone call entity: Booking help: A no-show costs the studio a seat and usually costs the member a credit. Called the same week it is a courtesy; called a month later it is an argument about a refund. sql: SELECT m.full_name AS member, m.phone, o.name AS class, s.starts_at, b.fee_waived FROM bus_booking b JOIN bus_member m ON m.id = b.member_id JOIN bus_class_session s ON s.id = b.class_session_id JOIN bus_class_offering o ON o.id = s.class_offering_id WHERE b.deleted_at IS NULL AND b.status = 'no_show' AND s.starts_at > now() - interval '14 days' ORDER BY s.starts_at DESC

%% -- instructor: the room they are about to walk into ------------------------
    %%report instructor-upcoming-roster title: Each instructor's next classes and headcount entity: ClassSession help: What an instructor checks the night before. Numbers change how a class is taught — four people is a workshop, twenty is a routine — and the room assignment is how they know where to go. sql: SELECT i.full_name AS instructor, o.name AS class, o.level, r.name AS room, s.starts_at, COUNT(b.id) AS booked, s.capacity FROM bus_class_session s JOIN bus_instructor i ON i.id = s.instructor_id JOIN bus_class_offering o ON o.id = s.class_offering_id LEFT JOIN bus_room r ON r.id = s.room_id LEFT JOIN bus_booking b ON b.class_session_id = s.id AND b.deleted_at IS NULL AND b.status = 'held' WHERE s.deleted_at IS NULL AND s.status = 'scheduled' AND s.starts_at BETWEEN now() AND now() + interval '7 days' GROUP BY s.id, i.full_name, o.name, o.level, r.name, s.starts_at, s.capacity ORDER BY s.starts_at
    %%report instructor-under-filled-sessions title: Classes too empty to run entity: ClassSession help: A class within three days that has almost nobody in it is a decision — cancel it now and free the instructor, or promote it. Left alone it runs at a loss and the instructor finds out on arrival. sql: SELECT o.name AS class, i.full_name AS instructor, s.starts_at, COUNT(b.id) AS booked, s.capacity FROM bus_class_session s JOIN bus_class_offering o ON o.id = s.class_offering_id LEFT JOIN bus_instructor i ON i.id = s.instructor_id LEFT JOIN bus_booking b ON b.class_session_id = s.id AND b.deleted_at IS NULL AND b.status = 'held' WHERE s.deleted_at IS NULL AND s.status = 'scheduled' AND s.starts_at BETWEEN now() AND now() + interval '3 days' GROUP BY s.id, o.name, i.full_name, s.starts_at, s.capacity HAVING COUNT(b.id) < 3 ORDER BY s.starts_at
    %%report instructor-attendance-rate title: Attendance against places held, by instructor entity: Instructor chart: bar x: instructor y: attendance_pct help: How many of the people who booked actually came. A consistently low rate is not the instructor's fault, but it is their signal — a class scheduled at the wrong hour, or one people book to keep a habit and skip. sql: SELECT i.full_name AS instructor, COUNT(*) FILTER (WHERE b.status = 'attended') AS attended, COUNT(*) AS places, ROUND(100.0 * COUNT(*) FILTER (WHERE b.status = 'attended') / NULLIF(COUNT(*), 0)) AS attendance_pct FROM bus_booking b JOIN bus_class_session s ON s.id = b.class_session_id JOIN bus_instructor i ON i.id = s.instructor_id WHERE b.deleted_at IS NULL AND s.deleted_at IS NULL AND s.status = 'completed' AND b.status IN ('attended', 'no_show', 'forfeited') GROUP BY i.id, i.full_name ORDER BY attendance_pct

%% -- manager: whether the studio is working ----------------------------------
    %%report manager-revenue-by-month title: Money taken by month entity: Payment chart: line x: month y: revenue help: The one number the owner asks for, and the only report here that a bank would recognise. Taken from payments received rather than packs sold, so an unpaid pack never counts as income. sql: SELECT to_char(date_trunc('month', y.received_at), 'YYYY-MM') AS month, SUM(y.amount) AS revenue, COUNT(*) AS payments FROM bus_payment y WHERE y.deleted_at IS NULL AND y.received_at > now() - interval '12 months' GROUP BY 1 ORDER BY 1
    %%report manager-room-utilisation title: How full each room actually runs entity: Room chart: bar x: room y: fill_pct help: Places sold against places built, per room. A room consistently under half full is either the wrong size for what is scheduled in it or a slot nobody wants, and both are fixable from the timetable. sql: SELECT r.name AS room, r.capacity AS seats, COUNT(b.id) AS booked, ROUND(100.0 * COUNT(b.id) / NULLIF(SUM(s.capacity), 0)) AS fill_pct FROM bus_class_session s JOIN bus_room r ON r.id = s.room_id LEFT JOIN bus_booking b ON b.class_session_id = s.id AND b.deleted_at IS NULL AND b.status IN ('held', 'attended') WHERE s.deleted_at IS NULL AND s.status IN ('scheduled', 'completed') AND s.starts_at > now() - interval '90 days' GROUP BY r.id, r.name, r.capacity ORDER BY fill_pct
    %%report manager-cancelled-sessions title: Classes the studio cancelled, and why entity: ClassSession help: Every cancelled session is members told no. The reason column is the point: a handful of instructor illnesses is life, a pattern of under-booking is a timetable that needs changing. sql: SELECT o.name AS class, i.full_name AS instructor, s.starts_at, s.cancellation_reason FROM bus_class_session s JOIN bus_class_offering o ON o.id = s.class_offering_id LEFT JOIN bus_instructor i ON i.id = s.instructor_id WHERE s.deleted_at IS NULL AND s.status = 'cancelled' AND s.starts_at > now() - interval '90 days' ORDER BY s.starts_at DESC
    %%report manager-offering-demand title: Which classes people actually book entity: ClassOffering chart: bar x: class y: booked help: What to put more of on the timetable and what to retire. Bookings per offering over a quarter, which is long enough that one bad week does not decide it. sql: SELECT o.name AS class, o.level, COUNT(b.id) AS booked, COUNT(DISTINCT s.id) AS sessions FROM bus_class_offering o LEFT JOIN bus_class_session s ON s.class_offering_id = o.id AND s.deleted_at IS NULL AND s.starts_at > now() - interval '90 days' LEFT JOIN bus_booking b ON b.class_session_id = s.id AND b.deleted_at IS NULL AND b.status IN ('held', 'attended') WHERE o.deleted_at IS NULL AND o.is_active GROUP BY o.id, o.name, o.level ORDER BY booked DESC
    %%report manager-members-drifting title: Active members who have stopped coming entity: Member help: The report that rots silently. A member still marked active who has not attended in sixty days has already left; nobody has told the system and nobody has phoned them. This is the list churn is prevented from. sql: SELECT m.full_name AS member, m.email, m.joined_on, MAX(s.starts_at) AS last_attended FROM bus_member m LEFT JOIN bus_booking b ON b.member_id = m.id AND b.deleted_at IS NULL AND b.status = 'attended' LEFT JOIN bus_class_session s ON s.id = b.class_session_id AND s.deleted_at IS NULL WHERE m.deleted_at IS NULL AND m.status = 'active' GROUP BY m.id, m.full_name, m.email, m.joined_on HAVING MAX(s.starts_at) IS NULL OR MAX(s.starts_at) < now() - interval '60 days' ORDER BY last_attended NULLS FIRST
    %%report manager-waived-fees title: Cancellation fees written off entity: Booking help: Every waiver is money the studio chose not to take, and the reason is free text because the judgement is human. Read together they show whether the cutoff rule is being applied or quietly ignored. sql: SELECT m.full_name AS member, o.name AS class, s.starts_at, b.waiver_reason FROM bus_booking b JOIN bus_member m ON m.id = b.member_id JOIN bus_class_session s ON s.id = b.class_session_id JOIN bus_class_offering o ON o.id = s.class_offering_id WHERE b.deleted_at IS NULL AND b.fee_waived AND b.cancelled_at > now() - interval '90 days' ORDER BY b.cancelled_at DESC

%% ---- Business rules — booking eligibility and the cancellation cutoff -------
%%meta name: Booking Eligibility
%%meta kind: rules
%%rule bookingGate on Booking event: beforeCreate priority: 10
flowchart TD
    A([Start: place requested]) --> B{Pack covers the credit cost?}
    B -->|No| R1[Refuse: insufficient credits]
    B -->|Yes| C{Session still scheduled and not full?}
    C -->|No| R2[Refuse: session unavailable]
    C -->|Yes| P(Hold the place)
    R1 --> E([End])
    R2 --> E
    P --> E

    %%action requirePackOrDropIn validation-error when: class_pack_id == null and status == "held" message: A place needs either an active class pack or a drop-in payment recorded at the desk.
    %%action requireWaiverReason validation-error when: fee_waived == true and waiver_reason == null message: A waived forfeit needs a reason — it appears on the monthly exceptions report.
    %%action stampBookingHeld transform when: true field: status value: held

%% ---- Business rules — cancellation cutoff ---------------------------------
%%meta name: Cancellation Cutoff
%%meta kind: rules
%%rule cancellationCutoff on Booking event: beforeUpdate priority: 20
flowchart TD
    A([Start: cancellation requested]) --> B{More than 12 hours before start?}
    B -->|Yes| C[Return the credit]
    B -->|No| D[Forfeit the credit]
    C --> E([End])
    D --> E

    %%action promoteFromWaitlist trigger-workflow when: status == "cancelled" workflow: WaitlistPromotion
    %%action forfeitLateCancellation transform when: status == "forfeited" field: fee_waived value: false

