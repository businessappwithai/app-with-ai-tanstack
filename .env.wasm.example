# Settings for generating a browser application with `appwithai-wasm`.
#
# Copy to .env.wasm and edit. This file belongs to the *generator*, not to the
# application it produces — a generated app has its own .env and no use for
# these. Only the CLI reads it; the hosted browser generator has no filesystem.
#
# Precedence, highest first: command-line flag, process environment, this file,
# built-in default.

# Rows of sample data seeded per entity on first boot. 0 turns it off.
# Values are typed from the Application Dictionary: a Table Direct column gets
# the id of a row that exists, a %%enum column gets one of its declared values,
# and email, phone, url, colour, money, date and text columns each get their own
# kind of value.
WASM_SEED_RECORDS=10

# Fixes the pseudo-random stream. The same model and the same seed produce the
# same rows every time, so a regenerated application diffs cleanly.
# Defaults to the project name.
# WASM_SEED_SEED=acme-dance-studio

# How often an OPTIONAL column is left empty, 0-1. Some blank cells are what
# makes a generated screen look like a real one.
WASM_SEED_NULL_RATE=0.15
