%% ---- 18 workflow — rule-triggered saga: Formula set, copy, both targets ----
%%meta name: Session Cancellation Refund
%%meta kind: workflow
%%workflow SessionCancellationRefund entity: ClassSession kind: saga trigger: rule
flowchart TD
    A([Session cancelled]) --> B(Name the closure note)
    B --> C(Carry the studio's reason across)
    C --> D[Close the session to further booking]
    D --> F[Cancel every held place]
    F --> G([Refunded])

    %%step B Formula target: closureNote operation: set value: Cancelled by the studio, every held place credited back.
    %%step C Formula target: keptReason operation: copy source: cancellation_reason
    %%step D UpdateEntity field: capacity value: 0
    %%step F UpdateEntity entity: Booking targetField: class_session_id field: status value: cancelled

%% ---- 19 workflow — every Formula arithmetic operation ----------------------
%%meta name: Pack Credit Drawdown
%%meta kind: workflow
%%workflow PackCreditDrawdown entity: Booking kind: saga trigger: automatic operation: CREATE
