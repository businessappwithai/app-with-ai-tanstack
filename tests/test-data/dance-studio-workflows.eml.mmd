%% ============================================================================
%% QA EXTENSION — twenty-five further behaviour constructs
%%
%% Everything below is added on top of the shipped Acme Dance Studio model to
%% exercise one distinct workflow or business-rule construct each. Numbered
%% 01-25 so a finding can name the construct that produced it.
%% ============================================================================

%% ---- 01 rules — validation-error plus transform on beforeUpdate ------------
%%meta name: Member Suspension Gate
%%meta kind: rules
%%rule memberSuspensionGate on Member event: beforeUpdate priority: 10
flowchart TD
    A([Start: member record changed]) --> B{Moving to suspended?}
    B -->|No| E([End])
    B -->|Yes| C{Phone number on file?}
    C -->|No| R1[Refuse: no way to tell them]
    C -->|Yes| D[Suspend and stop the mailings]
    R1 --> E
    D --> E

    %%action requireSuspensionContact validation-error when: status == "suspended" and phone == null message: A suspended member needs a phone number on file. The suspension notice is a call, not an email.
    %%action clearMarketingOnSuspend transform when: status == "suspended" field: marketing_opt_in value: false

%% ---- 02 rules — refuse-then-stamp on beforeCreate --------------------------
%%meta name: Pack Opening Balance
%%meta kind: rules
%%rule packOpeningBalance on ClassPack event: beforeCreate priority: 10
flowchart TD
    A([Start: pack purchased]) --> B{Credits above zero?}
    B -->|No| R1[Refuse: an empty pack is not a sale]
    B -->|Yes| C[Open the pack active]
    R1 --> E([End])
    C --> E

    %%action rejectEmptyPack validation-error when: credits_purchased <= 0 message: A pack must carry at least one credit. Record a zero-value sale as a payment, not as a pack.
    %%action openPackActive transform when: credits_purchased > 0 field: status value: active

%% ---- 03 rules — trigger-workflow action gating a rule-triggered saga -------
%%meta name: Session Cancellation Fanout
%%meta kind: rules
%%rule sessionCancellationFanout on ClassSession event: beforeUpdate priority: 20
flowchart TD
    A([Start: session edited]) --> B{Moving to cancelled?}
    B -->|No| E([End])
    B -->|Yes| C{Reason supplied?}
    C -->|No| R1[Refuse: members are owed an explanation]
    C -->|Yes| D[Run the credit-return process]
    R1 --> E
    D --> E

    %%action requireCancellationReason validation-error when: status == "cancelled" and cancellation_reason == null message: A cancelled session needs a reason. Every booked member is sent it verbatim.
    %%action returnCreditsOnCancel trigger-workflow when: status == "cancelled" workflow: SessionCancellationRefund

%% ---- 04 rules — several conditions over one entity in one table ------------
%%meta name: Payment Recording Rules
%%meta kind: rules
%%rule paymentRecording on Payment event: beforeCreate priority: 10
flowchart TD
    A([Start: money recorded]) --> B{Does the method leave a trail?}
    B -->|Yes| C{Reference supplied?}
    B -->|No| D[Stamp it counted into the till]
    C -->|No| R1[Refuse: nothing to reconcile against]
    C -->|Yes| F[Record it]
    R1 --> E([End])
    D --> E
    F --> E

    %%action requireCardReference validation-error when: method == "card" and reference == null message: A card payment needs its authorisation code. The nightly reconciliation matches on it.
    %%action requireTransferReference validation-error when: method == "bank_transfer" and reference == null message: A bank transfer needs its bank reference. Without it the statement line cannot be matched.
    %%action stampCashReference transform when: method == "cash" field: reference value: counted-into-till

%% ---- 05 rules — the node-graph form, no %%action directives ----------------
%%meta name: Waitlist Admission Priority
%%meta kind: rules
%%rule waitlistAdmissionPriority on WaitlistEntry event: beforeCreate priority: 10
flowchart TD
    A([Start: member asks to wait]) --> B{Member active?}
    B -->|No| R1[Refuse: lapsed and suspended members do not queue]
    B -->|Yes| C{Already in this queue?}
    C -->|Yes| R2[Refuse: one place per member per session]
    C -->|No| D((Compute the next queue position))
    D --> F[Join the queue waiting]
    R1 --> E([End])
    R2 --> E
    F --> E

%% ---- 06 rules — beforeDelete guard -----------------------------------------
%%meta name: Booking Deletion Guard
%%meta kind: rules
%%rule bookingDeletionGuard on Booking event: beforeDelete priority: 10
flowchart TD
    A([Start: deletion requested]) --> B{Terminal and evidential?}
    B -->|Yes| R1[Refuse: history is not a draft]
    B -->|No| C[Allow the delete]
    R1 --> E([End])
    C --> E

    %%action blockAttendedDelete validation-error when: status == "attended" message: An attended booking cannot be deleted. The attendance sheet is what the insurer asks for, so cancel it instead.
    %%action blockNoShowDelete validation-error when: status == "no_show" message: A no-show cannot be deleted. It counts toward suspension, so removing it rewrites the member's history.

