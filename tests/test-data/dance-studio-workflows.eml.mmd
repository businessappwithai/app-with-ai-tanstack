    %%rbac role:instructor|receptionist|manager on Booking.attend
    %%rbac role:manager on Booking.waive
    %%rbac role:member|receptionist|manager on WaitlistEntry.read
    %%rbac role:member|receptionist|manager on ClassPack.read
    %%rbac role:receptionist|manager on ClassPack.create
    %%rbac role:receptionist|manager on Payment.read
    %%rbac role:receptionist|manager on Payment.create

    %% -- 11 access — who may cross the edges the new state machines draw ------
    %%rbac role:receptionist|manager on Member.lapse
