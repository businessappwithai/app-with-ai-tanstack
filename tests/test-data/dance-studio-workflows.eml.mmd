%%meta kind: workflow
%%workflow PackCreditReconciliation entity: ClassPack kind: saga trigger: automatic operation: UPDATE
flowchart TD
    A([Pack changed]) --> L1
    subgraph L1[Repeat while credits remain]
      B(Take one credit off the running total)
      C[Write the reduced total back]
    end
    L1 --> D[Close the pack once it is spent]
    D --> F([Reconciled])

    %%loop L1 while: credits_remaining gt 0 max: 25
    %%step B Formula target: nextCredits source: credits_remaining operation: subtract operand: 1 in: L1
    %%step C UpdateEntity field: credits_remaining source: nextCredits in: L1
