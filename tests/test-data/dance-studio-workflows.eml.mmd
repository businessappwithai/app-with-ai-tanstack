%% ---- Business rules — booking eligibility and the cancellation cutoff -------
%%meta name: Booking Eligibility
%%meta kind: rules
%%rule bookingGate on Booking event: beforeCreate priority: 10
flowchart TD
    A([Start: place requested]) --> B{Pack covers the credit cost?}
    B -->|No| R1[Refuse: insufficient credits]
    B -->|Yes| C{Session still scheduled and not full?}
    C -->|No| R2[Refuse: session unavailable]
    C -->|Yes| P(Hold the place)
    R1 --> E([End])
    R2 --> E
    P --> E

    %%action requirePackOrDropIn validation-error when: class_pack_id == null and status == "held" message: A place needs either an active class pack or a drop-in payment recorded at the desk.
    %%action requireWaiverReason validation-error when: fee_waived == true and waiver_reason == null message: A waived forfeit needs a reason — it appears on the monthly exceptions report.
    %%action stampBookingHeld transform when: true field: status value: held

%% ---- Business rules — cancellation cutoff ---------------------------------
%%meta name: Cancellation Cutoff
%%meta kind: rules
%%rule cancellationCutoff on Booking event: beforeUpdate priority: 20
flowchart TD
    A([Start: cancellation requested]) --> B{More than 12 hours before start?}
    B -->|Yes| C[Return the credit]
    B -->|No| D[Forfeit the credit]
    C --> E([End])
    D --> E

    %%action promoteFromWaitlist trigger-workflow when: status == "cancelled" workflow: WaitlistPromotion
    %%action forfeitLateCancellation transform when: status == "forfeited" field: fee_waived value: false

