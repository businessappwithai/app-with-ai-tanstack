/**
 * Business Data Seed
 * Sample records for each business entity for E2E testing
 *
 * Generated: {{now}}
 */

import { Kysely, sql } from 'kysely';
import { v4 as uuidv4 } from 'uuid';

const SAMPLE_COUNT = 4;

/*
 * A column the model bound to a %%enum is seeded from that enum's own values
 * (see `enumSeedValue`), not from the name-keyed vocabulary the other columns
 * use. Anything else puts a value in the column that the dictionary does not
 * offer, the dropdown cannot select, and — for a status backing a state
 * machine — no declared transition leads out of.
 */

/**
 * Primary keys are generated up front for every table so foreign key columns
 * can point at rows that actually exist, in either direction, regardless of the
 * order the tables are seeded in. Without this the sample data has no usable
 * relationships and nothing that traverses them (lookups, cascade rules,
 * cross-entity workflows) can be exercised on a freshly generated app.
 */
const ids: Record<string, string[]> = {
  {{#each entities}}
  '{{tableName}}': Array.from({ length: SAMPLE_COUNT }, () => uuidv4()),
  {{/each}}
};

const FK_COLUMN_TABLE_MAP: Record<string, string> = {
  {{#each fkOverrides}}
  '{{column}}': '{{table}}',
  {{/each}}
};

function fk(column: string, index: number): string | null {
  if (FK_COLUMN_TABLE_MAP[column]) {
    const pool = ids[FK_COLUMN_TABLE_MAP[column]];
    if (pool && pool.length > 0) return pool[index % pool.length];
  }
  if (column.endsWith('_by_id') || column.endsWith('_by')) {
    for (const suffix of ['_by_id', '_by']) {
      if (!column.endsWith(suffix)) continue;
      const stem = `bus_${column.slice(0, -suffix.length)}`;
      const pool = ids[stem];
      if (pool && pool.length > 0) return pool[index % pool.length];
    }
    const userPool = ids['bus_user'] || ids['bus_staff'];
    if (userPool && userPool.length > 0) return userPool[index % userPool.length];
  }
  const parent = `bus_${column.replace(/_id$/, '')}`;
  const pool = ids[parent];
  return pool && pool.length > 0 ? pool[index % pool.length] : null;
}

export async function seed(db: Kysely<any>): Promise<void> {
  const now = new Date();

  // Constraint checking is disabled so tables can be truncated and repopulated
  // in any order; the rows themselves are referentially consistent.
  await sql`SET session_replication_role = replica`.execute(db);

  {{#each entities}}
  // {{displayName}} ({{tableName}})
  await db.deleteFrom('{{tableName}}').execute();

  const {{camelCase name}}Records = [
    {{#each (range 1 4)}}
    {
      id: ids['{{../tableName}}'][{{@index}}],
      {{#each ../attributes}}
      {{#unless (eq name ../../primaryKey)}}
      {{#unless (eq name 'created_at')}}
      {{#unless (eq name 'updated_at')}}
      {{#unless (eq name 'deleted_at')}}
      {{#unless (eq name 'version')}}
      {{#switch (typeToReferenceId type)}}
        {{#case 10}}{{name}}: {{#if isForeignKey}}fk('{{name}}', {{@../index}}){{else}}'{{#if (eq name "email")}}test{{@../index}}@example.com{{else}}{{#if enumValues}}{{enumSeedValue enumValues @../index}}{{else}}{{seedValue name @../index ../../displayName}}{{/if}}{{/if}}'{{/if}},{{/case}}
        {{#case 30}}{{name}}: 'test{{@../index}}@example.com',{{/case}}
        {{#case 31}}{{name}}: '555-{{@../index}}101',{{/case}}
        {{#case 11}}{{name}}: {{#if isForeignKey}}fk('{{name}}', {{@../index}}){{else}}{{@../index}}{{/if}},{{/case}}
        {{#case 12}}{{name}}: {{@../index}}.50,{{/case}}
        {{! Numeric args, not a string: '200X-0X-15' produced month 00 for the first record, which Postgres rejects. Month is 0-based here, so % 12 is always valid. }}
        {{#case 15}}{{name}}: new Date(2000 + {{@../index}}, {{@../index}} % 12, 15),{{/case}}
        {{#case 16}}{{name}}: new Date(Date.now() + {{@../index}} * 3600000),{{/case}}
        {{#case 20}}{{name}}: {{#if (eq @../index 2)}}false{{else}}true{{/if}},{{/case}}
        {{#case 13}}{{name}}: {{#if isForeignKey}}fk('{{name}}', {{@../index}}){{else}}uuidv4(){{/if}},{{/case}}
        {{#case 14}}{{name}}: 'Sample {{name}} text {{@../index}}',{{/case}}
        {{#default}}{{name}}: '{{#if enumValues}}{{enumSeedValue enumValues @../index}}{{else}}{{seedValue name @../index ../../displayName}}{{/if}}',{{/default}}
      {{/switch}}
      {{/unless}}
      {{/unless}}
      {{/unless}}
      {{/unless}}
      {{/unless}}
      {{/each}}
      version: 1,
      created_at: now,
      updated_at: now,
      deleted_at: null,
    },
    {{/each}}
  ];

  await db.insertInto('{{tableName}}').values({{camelCase name}}Records).execute();

  {{/each}}

  // Re-enable FK constraint checking
  await sql`SET session_replication_role = DEFAULT`.execute(db);

  console.log('✓ Business sample data seeded');
}
