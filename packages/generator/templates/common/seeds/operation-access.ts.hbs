/**
 * Access grant seed — the model's `%%rbac` directives, made enforceable.
 *
 * Each row of `sys_access_grant` closes one `(table, operation)` pair, or one
 * move of a record's lifecycle, to one role. A pair with no rows is
 * unrestricted, so this seed only ever *narrows*, and only where the model asked
 * for it. A user holding several roles has the union of their grants.
 *
 * Two things happen here, in order:
 *
 *   1. Every role named by a directive is created in `sys_role` if absent, so
 *      an administrator can see and assign it. A rule naming a role that exists
 *      nowhere would otherwise be a restriction no user could ever satisfy.
 *   2. The rules themselves are written, replacing any previous model-declared
 *      set.
 *
 * Step 2 deletes only rows carrying `entity_type = 'D'` (declared by the
 * model). Rules an administrator adds in the running application are marked
 * 'U' and survive regeneration — the same ownership split the workflow
 * definitions use, and for the same reason: regenerating must not silently
 * discard access rules a human wrote.
 *
 * Generated: {{now}}
 * Project: {{project.name}}
 */

import { sql, type Kysely } from 'kysely';
import { v4 as uuidv4 } from 'uuid';

interface TransitionAccessSeed {
  tableName: string;
  transition: string;
  statusField: string;
  /** `move` along a drawn edge, or `reopen` — a Final record back to Draft. */
  edges: Array<{ from: string; to: string; kind: 'move' | 'reopen' }>;
  roles: string[];
}

interface OperationAccessSeed {
  tableName: string;
  operation: 'create' | 'read' | 'update' | 'delete';
  roles: string[];
}

/** Roles named by at least one rule. Created before the rules reference them. */
const RBAC_ROLES: string[] = [{{#each rbacRoles}}'{{this}}'{{#unless @last}}, {{/unless}}{{/each}}];

const OPERATION_ACCESS: OperationAccessSeed[] = [
{{#each compiledRbac}}
  {
    tableName: '{{tableName}}',
    operation: '{{operation}}',
    roles: [{{#each roles}}'{{this}}'{{#unless @last}}, {{/unless}}{{/each}}],
  },
{{/each}}
];

const TRANSITION_ACCESS: TransitionAccessSeed[] = [
{{#each compiledRbacTransitions}}
  {
    tableName: '{{tableName}}',
    transition: '{{transition}}',
    statusField: '{{statusField}}',
    edges: [{{#each edges}}{ from: '{{from}}', to: '{{to}}', kind: '{{kind}}' }{{#unless @last}}, {{/unless}}{{/each}}],
    roles: [{{#each roles}}'{{this}}'{{#unless @last}}, {{/unless}}{{/each}}],
  },
{{/each}}
];

export async function seed(db: Kysely<any>): Promise<void> {
  if (OPERATION_ACCESS.length === 0 && TRANSITION_ACCESS.length === 0) {
    console.log('  ⚠ No %%rbac directives declared — every operation stays open');
    return;
  }

  // ---------------------------------------------------------------------------
  // 1. Roles
  // ---------------------------------------------------------------------------
  for (const roleName of RBAC_ROLES) {
    // The guard folds case and treats `_`, `-` and spaces alike
    // (`entity-access.guard`), so this does too. The seeded roles are title-cased
    // with spaces (`Airport Manager`) and a model writes `role:airport_manager`:
    // comparing only case created a second role beside every real one — ten roles
    // seeded, nine more written here — and left an administrator guessing which
    // of each pair to assign.
    const existing = await db
      .selectFrom('sys_role')
      .select('sys_role_id')
      .where(
        sql`lower(regexp_replace(trim(name), '[[:space:]_-]+', ' ', 'g'))` as any,
        '=',
        roleName.trim().toLowerCase().replace(/[\s_-]+/g, ' ')
      )
      .executeTakeFirst();

    if (existing) continue;

    await db
      .insertInto('sys_role')
      .values({
        sys_role_id: uuidv4(),
        name: roleName,
        description: `Declared by %%rbac in the model`,
        user_level: 'C',
        is_master_role: false,
        is_active: true,
        entity_type: 'D',
        created_by: 'system',
        updated_by: 'system',
      } as any)
      .execute();
    console.log(`  ✓ Created role: ${roleName}`);
  }

  // ---------------------------------------------------------------------------
  // 2. Grants — operations and moves, in the one table
  // ---------------------------------------------------------------------------
  await db.deleteFrom('sys_access_grant').where('entity_type', '=', 'D').execute();

  const grant = (row: Record<string, string>) =>
    db
      .insertInto('sys_access_grant')
      .values({
        sys_access_grant_id: uuidv4(),
        status_field: '',
        from_state: '',
        to_state: '',
        ...row,
        entity_type: 'D',
        is_active: true,
        created_by: 'system',
        updated_by: 'system',
      } as any)
      .onConflict((oc: any) =>
        oc.columns(['kind', 'table_name', 'action', 'from_state', 'to_state', 'role_name']).doNothing()
      )
      .execute();

  let written = 0;
  for (const rule of OPERATION_ACCESS) {
    for (const roleName of rule.roles) {
      await grant({
        kind: 'op',
        table_name: rule.tableName,
        action: rule.operation,
        role_name: roleName,
      });
      written += 1;
    }
    console.log(
      `  ✓ ${rule.tableName}.${rule.operation} restricted to: ${rule.roles.join(', ')}`
    );
  }
  console.log(`  ✓ Seeded ${written} operation grant(s)`);

  // A move with no grant is open to anyone who may update the record; one with
  // grants is the button only those roles see. A reopen with none is the
  // administrator's alone.
  let movesWritten = 0;
  for (const rule of TRANSITION_ACCESS) {
    for (const edge of rule.edges) {
      for (const roleName of rule.roles) {
        await grant({
          kind: edge.kind,
          table_name: rule.tableName,
          action: rule.transition,
          status_field: rule.statusField,
          from_state: edge.from,
          to_state: edge.to,
          role_name: roleName,
        });
        movesWritten += 1;
      }
    }
    console.log(
      `  ✓ ${rule.tableName}.${rule.transition} granted to: ${rule.roles.join(', ')}`
    );
  }
  if (movesWritten > 0) {
    console.log(`  ✓ Seeded ${movesWritten} move grant(s)`);
  }
}
