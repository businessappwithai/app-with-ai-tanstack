export async function seed(db: Kysely<any>): Promise<void> {
  let inserted = 0;
  let skipped = 0;

  for (const row of rows) {
    const existing = await db
      .selectFrom('sys_system')
      .select('sys_system_id')
      .where('config_key', '=', row.config_key)
      .executeTakeFirst();

    if (existing) {
      skipped++;
      continue;
    }

    await db
      .insertInto('sys_system')
      .values({
        sys_system_id: sql`gen_random_uuid()`,
        config_key: row.config_key,
        config_value: row.config_value,
        data_type: row.data_type,
        category: row.category,
        description: row.description,
        is_sensitive: row.is_sensitive,
        is_active: true,
        created_at: sql`NOW()`,
        updated_at: sql`NOW()`,
      })
      .execute();

    inserted++;
  }

  console.log(`  - ${inserted} system config rows inserted, ${skipped} already existed`);
}
