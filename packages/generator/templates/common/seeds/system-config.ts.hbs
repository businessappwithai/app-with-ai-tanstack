  // ── App Identity ─────────────────────────────────────────────────────
  {
    config_key: 'APP_NAME',
    config_value: '{{project.name}}',
    data_type: 'string',
    category: 'app_identity',
    description: 'Application name displayed in the dashboard header and browser title.',
    is_sensitive: false,
  },
  {
    config_key: 'APP_DESCRIPTION',
    config_value: `{{#if project.description}}{{{project.description}}}{{else}}A business application generated by APPWITHAI.{{/if}}`,
    data_type: 'text',
    category: 'app_identity',
    description: 'Detailed summary of what this application does: its business domain, entities, workflows, and value. Displayed in the admin dashboard and the generated manual.',
    is_sensitive: false,
  },

  // ── AI ───────────────────────────────────────────────────────────────
  {
    config_key: 'AI_BASE_URL',
    config_value: 'http://127.0.0.1:8000/v1',
    data_type: 'string',
    category: 'ai',
    description: 'Base URL of the OpenAI-compatible LLM API endpoint.',
    is_sensitive: false,
  },
  {
    config_key: 'AI_API_KEY',
    config_value: 'local',
    data_type: 'string',
    category: 'ai',
    description: 'API key for the LLM endpoint. Masked in the admin UI.',
    is_sensitive: true,
  },
  {
    config_key: 'AI_EMBEDDING_MODEL',
    config_value: 'bge-small-en-v1.5',
    data_type: 'string',
    category: 'ai',
    description: 'Name of the embedding model used for vector search.',
    is_sensitive: false,
  },
  {
    config_key: 'AI_EMBEDDING_DIMENSIONS',
    config_value: '384',
    data_type: 'number',
    category: 'ai',
    description: 'Dimensionality of the embedding vectors.',
    is_sensitive: false,
  },
  {
    config_key: 'ENABLE_MODEL_CONTEXT',
    config_value: 'true',
    data_type: 'boolean',
    category: 'ai',
    description: 'When true, the AI model-context assistant is available.',
    is_sensitive: false,
  },

  // ── Features ─────────────────────────────────────────────────────────
  {
