    is_sensitive: false,
  },
  {
    config_key: 'AUDIT_READS',
    config_value: 'false',
    data_type: 'boolean',
    category: 'features',
    description: 'When true, read operations are logged to the audit trail.',
    is_sensitive: false,
  },

  // ── Rate Limiting ────────────────────────────────────────────────────
  {
