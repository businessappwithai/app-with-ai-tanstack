/**
 * System Configuration Seed
 *
 * Populates sys_system with default configuration rows so the admin UI
 * has something to show on first boot. Each row corresponds to an
 * environment variable that can be managed from the database instead of
 * (or in addition to) the .env file.
 *
 * Fallback chain: DB row (active + non-empty) -> process.env -> default.
 *
 * Generated: {{now}}
 */

import { type Kysely, sql } from 'kysely';

interface ConfigRow {
  config_key: string;
  config_value: string;
  data_type: string;
  category: string;
  description: string;
  is_sensitive: boolean;
}

