/**
 * Default Report Designs Seed
 *
 * Seeds one default AnkaReport layout per entity into sys_report_designs.
 * The layout renders a two-column (label | value) view of every field.
 * Administrators can open Admin → Report Designs to customise any layout.
 *
 * Generated: {{now}}
 */

import { type Kysely } from 'kysely';

interface FieldRow {
  label: string;
  field: string;
}

interface ReportItem {
  type: string;
  x: number;
  y: number;
  width: number;
  height: number;
  text?: string;
  binding?: string;
  style?: Record<string, string | number>;
}

interface ReportLayout {
  headerSection: { height: number; items: ReportItem[] };
  contentSection: { height: number; binding: string; items: ReportItem[] };
  footerSection: { height: number; items: ReportItem[] };
}

function toLabel(columnName: string): string {
  return columnName
    .replace(/_id$/, '')
    .replace(/_/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase());
}

function buildLayout(entityName: string, fields: FieldRow[]): ReportLayout {
  const ROW_H = 24;
  const GAP = 4;
  const LABEL_W = 180;
  const VALUE_W = 370;
  const START_Y = 8;
  const contentH = Math.max(fields.length * (ROW_H + GAP) + START_Y + 12, 60);

  const items: ReportItem[] = [];
  fields.forEach((f, i) => {
    const y = START_Y + i * (ROW_H + GAP);
    items.push({ type: 'text', x: 10, y, width: LABEL_W, height: ROW_H, text: `${f.label}:`, style: { fontWeight: 'bold', fontSize: 11, color: '#374151' } });
    items.push({ type: 'text', x: LABEL_W + 20, y, width: VALUE_W, height: ROW_H, binding: f.field, style: { fontSize: 11, color: '#111827' } });
  });

  return {
    headerSection: {
      height: 56,
      items: [{ type: 'text', x: 10, y: 14, width: 560, height: 32, text: `${entityName} Report`, style: { fontSize: 20, fontWeight: 'bold', color: '#0f4c75' } }],
    },
    contentSection: { height: contentH, binding: 'records', items },
    footerSection: {
      height: 28,
      items: [{ type: 'text', x: 10, y: 6, width: 560, height: 20, text: 'Generated by APPWITHAI', style: { fontSize: 9, color: '#9ca3af', textAlign: 'center' } }],
    },
  };
}

const entityReports: Array<{ tableName: string; displayName: string; columns: string[] }> = [
  {{#each entities}}
  {
    tableName: '{{tableName}}',
    displayName: '{{displayName}}',
    columns: [
      {{#each attributes}}
      {{#unless (eq name ../primaryKey)}}
      {{#unless (eq name 'created_at')}}
      {{#unless (eq name 'updated_at')}}
      {{#unless (eq name 'deleted_at')}}
      {{#unless (eq name 'version')}}
      '{{name}}',
      {{/unless}}
      {{/unless}}
      {{/unless}}
      {{/unless}}
      {{/unless}}
      {{/each}}
    ],
  },
  {{/each}}
];

export async function seed(db: Kysely<any>): Promise<void> {
  for (const entity of entityReports) {
    if (entity.columns.length === 0) continue;
    const fields: FieldRow[] = entity.columns.map((col) => ({ label: toLabel(col), field: col }));
    const layout = buildLayout(entity.displayName, fields);
    await db
      .insertInto('sys_report_designs')
      .values({
        table_name: entity.tableName,
        name: `${entity.displayName} Default Report`,
        layout: JSON.stringify(layout),
      })
      .onConflict((oc) => oc.column('table_name').doNothing())
      .execute();
  }
  console.log('✓ Default report designs seeded');
}
