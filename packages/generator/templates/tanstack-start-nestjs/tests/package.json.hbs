{
  "name": "{{kebabCase project.name}}-tests",
  "version": "{{project.version}}",
  "description": "{{project.description}} - end-to-end tests (bun:test)",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun run run.ts",
    "test:small": "bun run run.ts --small",
    "test:full": "bun run run.ts --full",
    "test:fast": "bun run run.ts --fast",
    "test:attach": "bun run run.ts --no-server",
    "clean": "bun run cleanup.ts",
    "clean:all": "bun run cleanup.ts --all",
    "clean:dry": "bun run cleanup.ts --dry-run",
    "test:health": "bun test suites/00-health.test.ts",
    "test:auth": "bun test suites/01-auth.test.ts",
    "test:dictionary": "bun test suites/02-dictionary.test.ts",
    "test:crud": "bun run run.ts --only crud",
    "test:seed": "bun run run.ts --only bulk-seed",
    "test:rules": "bun run run.ts --only rules",
    "test:workflows": "bun run run.ts --only workflow",
    "test:users": "bun test suites/08-users-roles.test.ts",
    "test:watch": "bun test --watch suites",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^9.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.3.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
