{
  "name": "{{kebabCase project.name}}-tests",
  "version": "{{project.version}}",
  "description": "{{project.description}} - end-to-end tests (node:test)",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node run.ts",
    "test:small": "node run.ts --small",
    "test:full": "node run.ts --full",
    "test:fast": "node run.ts --fast",
    "test:attach": "node run.ts --no-server",
    "clean": "node cleanup.ts",
    "clean:all": "node cleanup.ts --all",
    "clean:dry": "node cleanup.ts --dry-run",
    "test:health": "node --test suites/00-health.test.ts",
    "test:auth": "node --test suites/01-auth.test.ts",
    "test:dictionary": "node --test suites/02-dictionary.test.ts",
    "test:crud": "node run.ts --only crud",
    "test:seed": "node run.ts --only bulk-seed",
    "test:rules": "node run.ts --only rules",
    "test:workflows": "node run.ts --only workflow",
    "test:users": "node --test suites/08-users-roles.test.ts",
    "test:watch": "node --test --watch suites",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^9.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
