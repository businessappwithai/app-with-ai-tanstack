/**
 * Read performance against whatever volume the run seeded.
 *
 * Runs last, so the tables are as full as this run will make them. Each phase
 * is one query shape repeated enough times for a p99 to be an observation
 * rather than a guess, and every sample lands in the same report as the writes.
 *
 * The point is the shape of the curve, not the absolute milliseconds. A laptop
 * and a CI box will disagree about every number here; what neither can hide is
 * a phase whose cost grows in step with the row count, because that is a scan
 * where an index was expected.
 *
 * Which is why the entity benchmarked is the one with the most rows: a phase
 * measured against a hundred rows tells you nothing about a hundred thousand.
 *
 * Generated: {{now}}
 * Project: {{project.name}}
 */

import { afterAll, beforeAll, describe, expect, it } from "bun:test";
import { config, entities, firstTextField, harness, scalarFields, timed } from "../harness";

/** Repetitions per phase. 30 is enough for a median and a believable p95. */
const REPS = Number(process.env.E2E_BENCH_REPS ?? 30);

/** Page size the phases read with — a realistic screenful, not a whole table. */
const PAGE = 25;

interface ListResponse {
  data: Array<Record<string, unknown>>;
  meta: { total: number; page?: number; limit?: number };
}

describe("read benchmark", () => {
  /** The entity with the most rows, and a text column to filter on. */
  let target: (typeof entities)[number] | null = null;
  let total = 0;
  let textField: string | null = null;
  let sortField: string | null = null;
  /** A value known to exist, so the filter phases match rather than miss. */
  let exactValue: string | null = null;

  beforeAll(async () => {
    await harness.setup();

    // Ask each entity how many rows it has and benchmark the largest. The
    // count is one request per entity and is not itself measured.
    let best = -1;
    for (const entity of entities) {
      const response = await harness.client.get<ListResponse>(
        `/bus/${entity.route}?page=1&limit=1`,
        { allowFailure: true }
      );
      if (!response.ok) continue;
      const rows = Number(response.data?.meta?.total ?? 0);
      if (rows > best) {
        best = rows;
        target = entity;
      }
    }

    total = Math.max(best, 0);
    if (!target) return;

    textField = firstTextField(target)?.name ?? null;
    sortField = scalarFields(target)[0]?.name ?? null;

    if (textField) {
      const sample = await harness.client.get<ListResponse>(
        `/bus/${target.route}?page=1&limit=1`,
        { allowFailure: true }
      );
      const value = sample.data?.data?.[0]?.[textField];
      if (typeof value === "string" && value.length > 0) exactValue = value;
    }

    console.log(
      `\n  benchmarking ${target.displayName}: ${total} rows, ${REPS} reps per phase\n`
    );
  });

  afterAll(async () => {
    await harness.teardown();
  });

  /** Run one phase `REPS` times. Skips cleanly when the data cannot support it. */
  async function phase(name: string, path: () => string): Promise<number> {
    let ok = 0;
    for (let index = 0; index < REPS; index++) {
      const response = await timed(name, () =>
        harness.client.get<ListResponse>(path(), { allowFailure: true })
      );
      if (response.ok) ok++;
    }
    return ok;
  }

  it("has a populated entity to measure", () => {
    expect(target).not.toBeNull();
    // Under `--fast` the bulk seed is skipped and only the CRUD fixtures exist.
    // The phases still run; they just describe a small table.
    expect(total).toBeGreaterThan(0);
  });

  it("list first page", async () => {
    if (!target) return;
    const ok = await phase("list first page", () => `/bus/${target!.route}?page=1&limit=${PAGE}`);
    expect(ok).toBe(REPS);
  });

  // The one phase whose work genuinely grows with the table: the last page sits
  // behind every row before it. Sublinear growth here means the pager is not
  // walking them one at a time.
  it("list deep page", async () => {
    if (!target) return;
    const lastPage = Math.max(1, Math.floor(total / PAGE));
    const ok = await phase(
      "list deep page",
      () => `/bus/${target!.route}?page=${lastPage}&limit=${PAGE}`
    );
    expect(ok).toBe(REPS);
  });

  it("count only", async () => {
    if (!target) return;
    const ok = await phase("count only", () => `/bus/${target!.route}?page=1&limit=1`);
    expect(ok).toBe(REPS);
  });

  it("sort by column", async () => {
    if (!target || !sortField) return;
    const ok = await phase(
      "sort by column",
      () => `/bus/${target!.route}?page=1&limit=${PAGE}&orderBy=${sortField}&orderDir=asc`
    );
    expect(ok).toBe(REPS);
  });

  it("filter exact", async () => {
    if (!target || !textField || !exactValue) return;
    const encoded = encodeURIComponent(exactValue);
    const ok = await phase(
      "filter exact",
      () => `/bus/${target!.route}?limit=${PAGE}&filter.${textField}=equals:${encoded}`
    );
    expect(ok).toBe(REPS);
  });

  // Contains and search are the two that cannot use a plain B-tree index, so
  // they are the ones to watch as the table grows.
  it("filter contains", async () => {
    if (!target || !textField || !exactValue) return;
    const needle = encodeURIComponent(exactValue.slice(0, Math.min(5, exactValue.length)));
    const ok = await phase(
      "filter contains",
      () => `/bus/${target!.route}?limit=${PAGE}&filter.${textField}=contains:${needle}`
    );
    expect(ok).toBe(REPS);
  });

  it("search substring", async () => {
    if (!target || !exactValue) return;
    const needle = encodeURIComponent(exactValue.slice(0, Math.min(5, exactValue.length)));
    const ok = await phase(
      "search substring",
      () => `/bus/${target!.route}?limit=${PAGE}&search=${needle}`
    );
    expect(ok).toBe(REPS);
  });

  it("records the volume it measured", () => {
    // Printed rather than asserted: the number is the run's context, and
    // failing on it would make a small run look broken.
    console.log(`  measured against ${total} ${target?.displayName ?? "?"} rows`);
    expect(config.recordsPerEntity).toBeGreaterThan(0);
  });
});
