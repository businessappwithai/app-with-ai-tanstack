/**
 * State machines — the edges the model drew, and only those.
 *
 * `%%workflow … kind: state` declares a lifecycle: which state a record starts
 * in, which moves are legal from there, and which states it can end in. The
 * backend stores those edges in `sys_workflow_transitions` and the
 * entity-access guard refuses any status write with no matching edge.
 *
 * There are two ways for that to be wrong, and both look like a working
 * application from the outside:
 *
 *   the table is empty      — every transition is allowed, because the guard
 *                             only enforces a topology it can find. A record
 *                             jumps from draft straight to approved and no rule
 *                             or workflow in between ever runs.
 *   the table disagrees     — an edge the diagram drew is missing, so a move
 *     with the model           the model calls routine is refused in production.
 *
 * So this suite checks both directions: every edge the model declared is
 * offered and accepted, and a move the model never drew is refused. It walks
 * each machine breadth-first from its initial state rather than assuming a
 * record can be created directly in the state under test.
 *
 * Generated: {{now}}
 * Project: {{project.name}}
 */

import { afterAll, beforeAll, describe, expect, it } from "../harness/testing.ts";
import { config } from "../harness/config.ts";
import {
  getEntity,
  harness,
  illegalTargetFrom,
  pathTo,
  stateMachines,
  statesOf,
  successorsOf,
  type StateMachine,
} from "../harness/index.ts";

interface TransitionRow {
  table_name: string;
  status_field: string;
  from_state: string;
  to_state: string;
  transition_name?: string | null;
}

interface TransitionsResponse {
  data: TransitionRow[];
  byTable: Record<string, Array<{ from: string; to: string }>>;
}

/** `from→to`, the shape both the model and the API are reduced to for compare. */
function edgeKey(from: string, to: string): string {
  return `${from}→${to}`;
}

/**
 * The state a record is actually in, which is not always the one just written.
 *
 * A model's own rules and workflows may advance the status as a side effect of
 * the write: the CRM example's Lead moves itself from `qualified` straight on
 * to `converted`. Assuming the write sticks made this suite attempt an edge
 * from a state the record had already left, and read the resulting — entirely
 * correct — 403 as the guard refusing an edge the model had drawn.
 *
 * A write answers with the record it produced, so the state after a move is
 * usually already in hand. `stateOf` reads it out of whatever a create, patch
 * or read answered; `currentState` is the extra round trip, for the cases where
 * it is not — and each one of those costs the walk a request per step, which is
 * what put this suite over its timeout on the larger machines.
 */
function stateOf(payload: unknown, field: string): string | null {
  if (!payload || typeof payload !== "object") return null;
  const record = payload as Record<string, unknown>;
  const body = (record.data ?? record) as Record<string, unknown>;
  const value = body?.[field];
  return value === undefined || value === null ? null : String(value);
}

async function currentState(route: string, id: string, field: string): Promise<string | null> {
  const response = await harness.client.get<Record<string, unknown>>(`/bus/${route}/${id}`, {
    allowFailure: true,
  });
  if (!response.ok) return null;
  return stateOf(response.data, field);
}

/**
 * How long the walk may take, in milliseconds.
 *
 * The work is one create plus a short walk per edge, and every one of those
 * writes runs the entity's rules and workflows. So the cost is a property of
 * the diagram, not of this suite, and a flat ceiling means a model fails the
 * moment it draws one state too many. Scaled per edge instead, with a floor for
 * the small machines and `E2E_SUITE_TIMEOUT_MS` still the minimum.
 */
const PER_EDGE_BUDGET_MS = Number(process.env.E2E_TRANSITION_EDGE_BUDGET_MS ?? 15_000);

function walkBudget(machine: StateMachine): number {
  return Math.max(config.suiteTimeoutMs, machine.edges.length * PER_EDGE_BUDGET_MS);
}

describe("state machines", () => {
  let served: TransitionRow[] = [];
  let endpointAvailable = false;

  beforeAll(async () => {
    await harness.setup();
    const response = await harness.client.get<TransitionsResponse>("/workflows/transitions", {
      allowFailure: true,
    });
    endpointAvailable = response.ok;
    served = response.ok ? (response.data?.data ?? []) : [];
  });

  afterAll(async () => {
    await harness.teardown();
  });

  it("exposes the declared transitions", () => {
    expect(endpointAvailable).toBe(true);
  });

  // A model with no state diagrams is legitimate; the suite then has nothing
  // to assert and says so rather than passing silently on an empty loop.
  it("has a state machine to drive, or declares none", () => {
    if (stateMachines.length === 0) {
      console.log("  the model declares no state machines — nothing to drive");
      return;
    }
    expect(served.length).toBeGreaterThan(0);
  });

  for (const machine of stateMachines) {
    describe(machine.entity, () => {
      const entity = getEntity(machine.entity);

      it("stores every edge the model drew", () => {
        const declared = machine.edges.map((edge) => edgeKey(edge.from, edge.to)).sort();
        const stored = served
          .filter((row) => row.table_name === machine.tableName)
          .map((row) => edgeKey(row.from_state, row.to_state))
          .sort();
        expect([...new Set(stored)]).toEqual([...new Set(declared)]);
      });

      it("stores them against the status column the guard reads", () => {
        const fields = new Set(
          served
            .filter((row) => row.table_name === machine.tableName)
            .map((row) => row.status_field)
        );
        expect([...fields]).toEqual([machine.statusField]);
      });

      it(
        "accepts every legal move, walking from the initial state",
        async () => {
          const refused: string[] = [];
          /** Edges whose start state the model's automations would not let us hold. */
          const carriedOn: string[] = [];

          for (const edge of machine.edges) {
            // Reach `edge.from` first. A machine whose initial state cannot reach
            // it has nothing to test for that edge — a disconnected diagram,
            // which the model, not this record, would have to fix.
            const approach = pathTo(machine, edge.from);
            if (approach === null) continue;

            const record = await harness.createWithParents(entity, {
              [machine.statusField]: machine.initial,
            });
            if (!record?.id) continue;

            // Where the record actually is, tracked across the walk rather than
            // re-read before every step. The model's own rules and workflows may
            // move it: the CRM example's Contract leaves `in_approval` for
            // `expiring` on its own. Once that happens the rest of the planned
            // walk is asking the guard about edges leading out of a state the
            // record is no longer in, and the 403 it rightly answers is not
            // evidence of anything.
            //
            // So the two outcomes are kept apart. A refusal of an edge the record
            // *was* correctly positioned for is a real failure and names that
            // edge. Being carried elsewhere is reported and skipped.
            let at =
              stateOf(record, machine.statusField) ??
              (await currentState(entity.route, String(record.id), machine.statusField));
            let diverted: string | null = null;
            let blocked: string | null = null;

            for (const step of approach) {
              // Carried straight to where this edge starts: the rest of the
              // planned walk is moot and the edge is testable after all.
              if (at === edge.from) break;
              if (at !== step.from) {
                diverted = `${edgeKey(edge.from, edge.to)} (carried to ${at ?? "?"})`;
                break;
              }
              const response = await harness.client.patch(
                `/bus/${entity.route}/${record.id}`,
                { [machine.statusField]: step.to },
                { allowFailure: true }
              );
              if (!response.ok) {
                if (response.status === 403) {
                  blocked = `${edgeKey(step.from, step.to)} (reached while approaching ${edge.from})`;
                } else {
                  diverted = `${edgeKey(edge.from, edge.to)} (approach answered ${response.status})`;
                }
                break;
              }
              // The write answers with the record it produced, so the state
              // after the move is already here; only fall back to a read when
              // it is not.
              at =
                stateOf(response.data, machine.statusField) ??
                (await currentState(entity.route, String(record.id), machine.statusField));
            }

            if (blocked) {
              refused.push(blocked);
              continue;
            }
            if (diverted) {
              carriedOn.push(diverted);
              continue;
            }

            // And confirm it came to rest where the edge starts, rather than being
            // moved on by whatever ran on the last write.
            if (at !== edge.from) {
              carriedOn.push(`${edgeKey(edge.from, edge.to)} (landed in ${at ?? "?"})`);
              continue;
            }

            const move = await harness.client.patch(
              `/bus/${entity.route}/${record.id}`,
              { [machine.statusField]: edge.to },
              { allowFailure: true }
            );
            // 403 is the guard refusing an edge the model drew — the failure this
            // test is for. Any other error is the record, not the topology.
            if (move.status === 403) refused.push(edgeKey(edge.from, edge.to));
          }

          if (carriedOn.length > 0) {
            console.log(
              `  ${machine.entity}: ${carriedOn.length} edge(s) not exercised — ` +
                `a rule or workflow moved the record on: ${carriedOn.join(", ")}`
            );
          }
          expect(refused).toEqual([]);
        },
        walkBudget(machine)
      );

      it("refuses a move the model never drew", async () => {
        const from = machine.initial || machine.edges[0]?.from;
        if (!from) return;

        const illegal = illegalTargetFrom(machine, from);
        if (!illegal) {
          // Every state is reachable from here in one step, so there is no
          // illegal move to attempt. Not a failure — a very permissive machine.
          console.log(`  ${machine.entity}: every state is legal from "${from}"`);
          return;
        }

        const record = await harness.createWithParents(entity, {
          [machine.statusField]: from,
        });
        expect(record?.id).toBeTruthy();
        if (!record?.id) return;

        // The create may itself have set the record moving; the illegal move
        // has to be attempted from wherever it settled, and `illegal` recomputed
        // for that state, or the 403 this asserts could be the right answer to
        // the wrong question.
        const settled =
          stateOf(record, machine.statusField) ??
          (await currentState(entity.route, String(record.id), machine.statusField));
        const target = settled === from ? illegal : settled ? illegalTargetFrom(machine, settled) : null;
        if (!settled || !target) {
          console.log(`  ${machine.entity}: no illegal move to attempt from "${settled ?? "?"}"`);
          return;
        }

        const response = await harness.client.patch(
          `/bus/${entity.route}/${record.id}`,
          { [machine.statusField]: target },
          { allowFailure: true }
        );

        expect(response.ok).toBe(false);
        expect(response.status).toBe(403);
      });

      it("leaves the record in its old state when a move is refused", async () => {
        const from = machine.initial || machine.edges[0]?.from;
        const illegal = from ? illegalTargetFrom(machine, from) : null;
        if (!from || !illegal) return;

        const record = await harness.createWithParents(entity, {
          [machine.statusField]: from,
        });
        if (!record?.id) return;

        // Compare against where the record actually settled, not what was asked
        // for — see the note on currentState.
        const settled =
          stateOf(record, machine.statusField) ??
          (await currentState(entity.route, String(record.id), machine.statusField));
        const target = settled === from ? illegal : settled ? illegalTargetFrom(machine, settled) : null;
        if (!settled || !target) return;

        await harness.client.patch(
          `/bus/${entity.route}/${record.id}`,
          { [machine.statusField]: target },
          { allowFailure: true }
        );

        // A refused write that still landed would be worse than one that was
        // allowed: the guard would be reporting a state the record is not in.
        const after = await harness.client.get<Record<string, unknown>>(
          `/bus/${entity.route}/${record.id}`,
          { allowFailure: true }
        );
        if (!after.ok) return;
        const body = (after.data as { data?: Record<string, unknown> })?.data ?? after.data;
        expect(String(body?.[machine.statusField] ?? "")).toBe(settled);
      });

      it("offers no way out of a terminal state", async () => {
        const terminal = machine.terminal[0];
        if (!terminal) return; // a machine that never ends

        const response = await harness.client.get<TransitionsResponse>(
          `/workflows/transitions?table=${machine.tableName}&from=${encodeURIComponent(terminal)}`,
          { allowFailure: true }
        );
        expect(response.status).toBe(200);

        // A terminal state is the model's statement that the record is done. An
        // edge out of one that the diagram never drew would let a closed record
        // reopen — and every rule and workflow keyed on "closed" would be
        // deciding about a record that had moved on.
        expect((response.data?.data ?? []).map((row) => row.to_state)).toEqual([]);
      });

      it("refuses a move out of a terminal state", async () => {
        const terminal = machine.terminal[0];
        const path = terminal ? pathTo(machine, terminal) : null;
        if (!terminal || !path) return;

        const record = await harness.createWithParents(entity);
        if (!record?.id) return;

        // Walk it to the end, then try to move it on. Each step is a legal
        // edge, so a refusal on the way is a failure of the walk rather than
        // the assertion — hence the early return rather than an expectation.
        for (const edge of path) {
          const step = await harness.client.patch(
            `/bus/${entity.route}/${record.id}`,
            { [machine.statusField]: edge.to },
            { allowFailure: true }
          );
          if (!step.ok) return;
        }

        const current = await currentState(entity.route, String(record.id), machine.statusField);
        if (current !== terminal) return; // the model moved it on by itself

        const somewhereElse = statesOf(machine).find((state) => state !== terminal);
        if (!somewhereElse) return;

        const response = await harness.client.patch(
          `/bus/${entity.route}/${record.id}`,
          { [machine.statusField]: somewhereElse },
          { allowFailure: true }
        );
        expect(response.status).toBe(403);
      });

      it("answers which moves are legal from a given state", async () => {
        const from = machine.initial || machine.edges[0]?.from;
        if (!from) return;

        const response = await harness.client.get<TransitionsResponse>(
          `/workflows/transitions?table=${machine.tableName}&from=${encodeURIComponent(from)}`,
          { allowFailure: true }
        );
        expect(response.status).toBe(200);

        const offered = (response.data?.data ?? []).map((row) => row.to_state).sort();
        expect([...new Set(offered)]).toEqual([...new Set(successorsOf(machine, from))].sort());
      });
    });
  }

  it("stores no transition for a table the model gave no state machine", () => {
    const modelled = new Set(stateMachines.map((machine: StateMachine) => machine.tableName));
    // A stray row here means something other than the model wrote the topology,
    // and the guard would be enforcing a lifecycle nobody declared.
    const stray = [...new Set(served.map((row) => row.table_name))].filter(
      (table) => !modelled.has(table)
    );
    expect(stray).toEqual([]);
  });
});
