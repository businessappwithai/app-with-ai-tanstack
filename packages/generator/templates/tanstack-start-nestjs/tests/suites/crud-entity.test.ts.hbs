/**
 * CRUD — {{entity.displayName}}
 *
 * One file per entity, so a failure names the entity that broke.
 *
 * The assertions are about behaviour rather than about status codes wherever
 * the two can be told apart. A sort that answers 200 with the rows in their
 * natural order, a filter that answers 200 having ignored the filter, and a
 * replace that answers 200 having changed nothing all pass a suite written
 * around `status < 500` — and each of them is a defect a user would notice
 * before the suite did.
 *
 * Generated: {{now}}
 * Project: {{project.name}}
 */

import { afterAll, beforeAll, describe, expect, it } from "../harness/testing.ts";
import {
  buildInvalidRecord,
  entities,
  type FieldMeta,
  firstTextField,
  getEntity,
  harness,
  HttpClient,
  numericFields,
  relationships,
  scalarFields,
  writableFields,
} from "../harness/index.ts";

const entity = getEntity("{{entity.name}}");

/** A UUID that is well-formed and belongs to nothing. */
const ABSENT_ID = "00000000-0000-4000-8000-000000000000";

/**
 * A foreign key the database really constrains.
 *
 * The migration emits a constraint for a declared `oneToMany` relationship and
 * for nothing else, so a column the ERD marks `FK` but draws no line for — a
 * `manager_id` resolved to `bus_user` by naming convention — is a reference the
 * dictionary describes and the schema does not enforce. Testing integrity on
 * one of those would be asserting a property the generated application does
 * not have; this picks a column where the constraint exists.
 */
function constrainedForeignKey(): FieldMeta | undefined {
  for (const relationship of relationships) {
    if (relationship.cardinality !== "oneToMany") continue;
    if (relationship.targetEntity !== entity.name) continue;

    const source = entities.find((candidate) => candidate.name === relationship.sourceEntity);
    if (!source) continue;

    const column = `${source.tableName.replace(/^bus_/, "")}_id`;
    const field = entity.fields.find((candidate) => candidate.name === column);
    if (field) return field;
  }
  return undefined;
}

/** Comparable form of a cell, for ordering assertions. */
function sortable(value: unknown): number | string | null {
  if (value === null || value === undefined) return null;
  if (typeof value === "number") return value;
  const asNumber = Number(value);
  if (!Number.isNaN(asNumber) && String(value).trim() !== "") return asNumber;
  return String(value);
}

describe("{{entity.displayName}} CRUD", () => {
  /** Ids created here that later tests reuse. */
  let createdId = "";

  beforeAll(async () => {
    await harness.setup();
  });

  afterAll(async () => {
    await harness.teardown();
  });

  it("lists records with pagination metadata", async () => {
    const response = await harness.client.get<{
      data: unknown[];
      meta: { total: number; page?: number; limit?: number };
    }>(`/bus/${entity.route}?page=1&limit=10`);

    expect(response.status).toBe(200);
    expect(Array.isArray(response.data.data)).toBe(true);
    expect(typeof response.data.meta.total).toBe("number");
    expect(response.data.data.length).toBeLessThanOrEqual(10);
  });

  it("creates a record", async () => {
    const created = await harness.createWithParents(entity);

    expect(created).not.toBeNull();
    expect(created?.id).toBeTruthy();

    createdId = String(created?.id);
  });

  it("reads the record back by id", async () => {
    expect(createdId).toBeTruthy();

    const response = await harness.client.get<Record<string, unknown>>(
      `/bus/${entity.route}/${createdId}`
    );

    expect(response.status).toBe(200);
    expect(response.data.id).toBe(createdId);
  });

  it("persists the values it was given", async () => {
    const textField = firstTextField(entity);
    if (!textField) return; // nothing text-shaped to assert on

    const marker = `e2e-${Date.now()}`;
    const created = await harness.createWithParents(entity, { [textField.name]: marker });
    expect(created).not.toBeNull();

    const response = await harness.client.get<Record<string, unknown>>(
      `/bus/${entity.route}/${created?.id}`
    );
    expect(String(response.data[textField.name])).toBe(marker);
  });

  it("stamps its own timestamps rather than taking the client's", async () => {
    const created = await harness.createWithParents(entity, {
      created_at: "1999-01-01T00:00:00.000Z",
      updated_at: "1999-01-01T00:00:00.000Z",
    });
    expect(created).not.toBeNull();

    // A row whose audit columns are whatever the caller sent has no audit
    // trail. Both are written by the insert itself, so the year the client
    // asked for must not survive.
    expect(String(created?.created_at)).not.toContain("1999");
    expect(String(created?.updated_at)).not.toContain("1999");
  });

  it("updates a record with PATCH", async () => {
    expect(createdId).toBeTruthy();

    const textField = firstTextField(entity);
    if (!textField) return;

    const updated = `patched-${Date.now()}`;
    const response = await harness.client.patch<Record<string, unknown>>(
      `/bus/${entity.route}/${createdId}`,
      { [textField.name]: updated }
    );

    expect(response.status).toBeLessThan(300);
    expect(String(response.data[textField.name])).toBe(updated);
  });

  it("leaves the fields it was not asked to change", async () => {
    const textField = firstTextField(entity);
    const numeric = numericFields(entity)[0];
    if (!textField || !numeric) return;

    const created = await harness.createWithParents(entity, {
      [textField.name]: `keep-${Date.now()}`,
      [numeric.name]: 7,
    });
    expect(created).not.toBeNull();

    await harness.client.patch(`/bus/${entity.route}/${created?.id}`, {
      [textField.name]: `changed-${Date.now()}`,
    });

    // A partial update that quietly nulls every column the caller did not
    // mention is data loss dressed as a successful write.
    const after = await harness.client.get<Record<string, unknown>>(
      `/bus/${entity.route}/${created?.id}`
    );
    expect(Number(after.data[numeric.name])).toBe(7);
  });

  it("bumps the version on update", async () => {
    const created = await harness.createWithParents(entity);
    expect(created).not.toBeNull();

    const before = Number(created?.version ?? 0);
    const textField = firstTextField(entity);
    if (!textField) return;

    const response = await harness.client.patch<Record<string, unknown>>(
      `/bus/${entity.route}/${created?.id}`,
      { [textField.name]: `v-${Date.now()}` }
    );

    expect(Number(response.data.version ?? 0)).toBeGreaterThan(before);
  });

  it("refuses a write against a version that is no longer current", async () => {
    const textField = firstTextField(entity);
    if (!textField) return;

    const created = await harness.createWithParents(entity);
    expect(created).not.toBeNull();

    const staleVersion = Number(created?.version ?? 0);

    // Somebody else's edit lands first.
    await harness.client.patch(`/bus/${entity.route}/${created?.id}`, {
      [textField.name]: `first-writer-${Date.now()}`,
    });

    // Ours still believes the record looks the way it did when the form
    // opened. Without the check, this is the write that silently discards
    // theirs — the classic lost update.
    const conflicted = await harness.client.patch<Record<string, unknown>>(
      `/bus/${entity.route}/${created?.id}`,
      { [textField.name]: `second-writer-${Date.now()}` },
      { headers: { "If-Match": `"v${staleVersion}"` }, allowFailure: true }
    );

    expect(conflicted.status).toBe(409);

    const after = await harness.client.get<Record<string, unknown>>(
      `/bus/${entity.route}/${created?.id}`
    );
    expect(String(after.data[textField.name])).toContain("first-writer");
  });

  it("accepts a write against the version the caller actually read", async () => {
    const textField = firstTextField(entity);
    if (!textField) return;

    const created = await harness.createWithParents(entity);
    expect(created).not.toBeNull();

    const marker = `matched-${Date.now()}`;
    const response = await harness.client.patch<Record<string, unknown>>(
      `/bus/${entity.route}/${created?.id}`,
      { [textField.name]: marker },
      { headers: { "If-Match": `"v${Number(created?.version ?? 0)}"` }, allowFailure: true }
    );

    // The counterweight to the test above: a check that refuses everything is
    // indistinguishable from one that works, until somebody tries to save.
    expect(response.status).toBeLessThan(300);
    expect(String(response.data[textField.name])).toBe(marker);
  });

  it("replaces a record with PUT", async () => {
    const textField = firstTextField(entity);
    if (!textField) return;

    const created = await harness.createWithParents(entity, {
      [textField.name]: `before-replace-${Date.now()}`,
    });
    expect(created).not.toBeNull();
    if (!created) return;

    // The replacement is the record as it stands with one field changed —
    // which is what a replace is: read, edit, put back. Building a fresh
    // payload from the factory instead invents every other value too, and an
    // invented value has to satisfy the model's own rules and state machine to
    // be accepted. On a model that refuses a discount over 40 percent, or an
    // entity whose status may only move along declared edges, the refusal was
    // correct and the test was wrong.
    const replacement: Record<string, unknown> = {};
    for (const field of writableFields(entity)) {
      if (field.name in created) replacement[field.name] = created[field.name];
    }

    const marker = `replaced-${Date.now()}`;
    replacement[textField.name] = marker;

    const response = await harness.client.put<Record<string, unknown>>(
      `/bus/${entity.route}/${created.id}`,
      replacement,
      { allowFailure: true }
    );
    expect(response.status, `PUT answered ${response.status}: ${response.raw.slice(0, 200)}`)
      .toBeLessThan(300);

    // Read back rather than trusting the echo: a handler that answers with the
    // payload it was sent looks identical to one that wrote it.
    const after = await harness.client.get<Record<string, unknown>>(
      `/bus/${entity.route}/${created.id}`
    );
    expect(String(after.data[textField.name])).toBe(marker);
    expect(after.data.id).toBe(created.id);
  });

  it("rejects a payload missing a required field", async () => {
    const invalid = buildInvalidRecord(entity);
    if (!invalid) return; // entity has no required scalar fields

    const response = await harness.client.post(`/bus/${entity.route}`, invalid.payload, {
      allowFailure: true,
    });

    expect(response.ok).toBe(false);
    expect(response.status).toBeGreaterThanOrEqual(400);
    expect(response.status).toBeLessThan(500);
  });

  it("rejects a value that is not the column's type", async () => {
    const numeric = numericFields(entity)[0];
    if (!numeric) return;

    const payload = await harness.buildValidRecord(entity, {
      [numeric.name]: "not-a-number-at-all",
    });
    const response = await harness.client.post(`/bus/${entity.route}`, payload, {
      allowFailure: true,
    });

    // 400, not 500: a column that rejects the value at the database instead of
    // at the dictionary reports a constraint violation the caller cannot read.
    expect(response.status).toBeGreaterThanOrEqual(400);
    expect(response.status).toBeLessThan(500);
  });

  it("rejects a value longer than the column holds", async () => {
    const bounded = scalarFields(entity).find(
      (field) => typeof field.maxLength === "number" && field.maxLength > 0
    );
    if (!bounded) return;

    const payload = await harness.buildValidRecord(entity, {
      [bounded.name]: "x".repeat((bounded.maxLength ?? 0) + 50),
    });
    const response = await harness.client.post(`/bus/${entity.route}`, payload, {
      allowFailure: true,
    });

    expect(response.status).toBeGreaterThanOrEqual(400);
    expect(response.status).toBeLessThan(500);
  });

  it("rejects a foreign key pointing at a record that does not exist", async () => {
    const link = constrainedForeignKey();
    if (!link) return;

    const payload = await harness.buildValidRecord(entity, { [link.name]: ABSENT_ID });
    const response = await harness.client.post(`/bus/${entity.route}`, payload, {
      allowFailure: true,
    });

    // The row must not be written. Which 4xx is a matter of taste; a 2xx is a
    // dangling reference, and a 5xx is the database's error text reaching the
    // client.
    expect(response.status).toBeGreaterThanOrEqual(400);
    expect(response.status).toBeLessThan(500);
  });

  it("returns 404 for an unknown id", async () => {
    const response = await harness.client.get(`/bus/${entity.route}/${ABSENT_ID}`, {
      allowFailure: true,
    });

    expect(response.ok).toBe(false);
    expect(response.status).toBe(404);
  });

  it("returns 404 when updating or deleting an unknown id", async () => {
    const textField = firstTextField(entity);

    const patched = await harness.client.patch(
      `/bus/${entity.route}/${ABSENT_ID}`,
      textField ? { [textField.name]: "nobody" } : {},
      { allowFailure: true }
    );
    expect(patched.status).toBe(404);

    const removed = await harness.client.delete(`/bus/${entity.route}/${ABSENT_ID}`, {
      allowFailure: true,
    });
    expect(removed.status).toBe(404);
  });

  it("rejects a malformed id", async () => {
    const response = await harness.client.get(`/bus/${entity.route}/not-a-uuid`, {
      allowFailure: true,
    });

    expect(response.ok).toBe(false);
    expect(response.status).toBeGreaterThanOrEqual(400);
  });

  it("refuses a caller with no session", async () => {
    // A separate client, so it carries no cookie from the shared harness login.
    const anonymous = new HttpClient();

    const attempts = [
      await anonymous.get(`/bus/${entity.route}?limit=1`, { allowFailure: true }),
      await anonymous.get(`/bus/${entity.route}/${createdId || ABSENT_ID}`, {
        allowFailure: true,
      }),
      await anonymous.post(`/bus/${entity.route}`, {}, { allowFailure: true }),
      await anonymous.delete(`/bus/${entity.route}/${ABSENT_ID}`, { allowFailure: true }),
    ];

    const served = attempts.filter((response) => response.status < 400).map((r) => r.status);
    expect(served).toEqual([]);
  });

  it("sorts by a numeric column", async () => {
    const sortableField = numericFields(entity)[0];
    if (!sortableField) return;

    const response = await harness.client.get<{ data: Array<Record<string, unknown>> }>(
      `/bus/${entity.route}?limit=20&orderBy=${sortableField.name}&orderDir=asc`,
      { allowFailure: true }
    );
    expect(response.status).toBe(200);

    const values = response.data.data
      .map((row) => sortable(row[sortableField.name]))
      .filter((value): value is number => typeof value === "number");

    // A numeric column, deliberately: text ordering belongs to the database's
    // collation, and asserting it here with a JavaScript comparator tests the
    // comparator. Numbers have one order, so an `orderBy` that is accepted and
    // then ignored — the rows come back in insertion order, 200 and all — has
    // nowhere to hide.
    for (let index = 1; index < values.length; index++) {
      const previous = values[index - 1] as number;
      const current = values[index] as number;
      expect(previous <= current, `${previous} came before ${current} under orderDir=asc`).toBe(
        true
      );
    }
  });

  it("reverses the order when asked to", async () => {
    const sortableField = numericFields(entity)[0] ?? scalarFields(entity)[0];
    if (!sortableField) return;

    const ascending = await harness.client.get<{
      data: Array<Record<string, unknown>>;
      meta: { total: number };
    }>(`/bus/${entity.route}?limit=20&orderBy=${sortableField.name}&orderDir=asc`);
    const descending = await harness.client.get<{
      data: Array<Record<string, unknown>>;
      meta: { total: number };
    }>(`/bus/${entity.route}?limit=20&orderBy=${sortableField.name}&orderDir=desc`);

    const first = ascending.data.data.map((row) => String(row[sortableField.name]));
    const second = descending.data.data.map((row) => String(row[sortableField.name]));

    if (first.length > 1 && new Set(first).size > 1) {
      expect(second).not.toEqual(first);

      // When the whole table fits on one page the two are exact mirrors, in
      // whatever collation the database uses — which is the assertion the
      // ordering test above cannot make about text without guessing at it.
      if (ascending.data.meta.total <= 20) {
        expect(second).toEqual([...first].reverse());
      }
    }
  });

  it("searches by text", async () => {
    const textField = firstTextField(entity);
    if (!textField) return;

    const needle = `find-${Date.now()}`;
    await harness.createWithParents(entity, { [textField.name]: needle });

    const response = await harness.client.get<{ data: Array<Record<string, unknown>> }>(
      `/bus/${entity.route}?search=${encodeURIComponent(needle)}&limit=10`,
      { allowFailure: true }
    );

    expect(response.status).toBeLessThan(500);
    if (response.ok) {
      const hit = response.data.data.some((row) => String(row[textField.name]).includes(needle));
      expect(hit).toBe(true);
    }
  });

  it("filters with an equals operator", async () => {
    const textField = firstTextField(entity);
    if (!textField) return;

    const value = `filter-${Date.now()}`;
    const created = await harness.createWithParents(entity, { [textField.name]: value });
    if (!created) return;

    const response = await harness.client.get<{
      data: Array<Record<string, unknown>>;
      meta: { total: number };
    }>(`/bus/${entity.route}?filter.${textField.name}=equals:${encodeURIComponent(value)}`, {
      allowFailure: true,
    });

    expect(response.status).toBe(200);

    // Both directions. A filter that is parsed and dropped returns every row —
    // including rows that do not match — and a filter that is too eager
    // returns none, and the record just written is the one that proves it.
    expect(response.data.data.map((row) => row.id)).toContain(created.id);
    const mismatched = response.data.data.filter(
      (row) => String(row[textField.name]) !== value
    );
    expect(mismatched.map((row) => String(row[textField.name]))).toEqual([]);
  });

  it("pages without repeating or losing a row", async () => {
    // Enough rows to have a second page of.
    for (let index = 0; index < 6; index++) await harness.createWithParents(entity);

    const first = await harness.client.get<{
      data: Array<{ id: string }>;
      meta: { total: number };
    }>(`/bus/${entity.route}?page=1&limit=5&orderBy=id&orderDir=asc`);
    const second = await harness.client.get<{
      data: Array<{ id: string }>;
      meta: { total: number };
    }>(`/bus/${entity.route}?page=2&limit=5&orderBy=id&orderDir=asc`);

    expect(first.status).toBe(200);
    expect(second.status).toBe(200);
    expect(first.data.data.length).toBeLessThanOrEqual(5);

    // A pagination bug that offsets by page instead of by page × limit shows up
    // as an overlap here, and one that offsets too far shows up as a gap in the
    // totals. Both look like a working list from a single page.
    const firstIds = new Set(first.data.data.map((row) => row.id));
    const overlap = second.data.data.filter((row) => firstIds.has(row.id));
    expect(overlap.map((row) => row.id)).toEqual([]);
    expect(second.data.meta.total).toBe(first.data.meta.total);
  });

  // A delete removes the row and reports the workflows that ran clearing it.
  // It used to stamp `deleted_at` and answer 204, which read the same from the
  // outside — the record was gone from every query either way — while leaving
  // the row and its foreign keys in the table.
  it("deletes a record and reports what ran", async () => {
    const created = await harness.createWithParents(entity);
    expect(created).not.toBeNull();

    const response = await harness.client.delete<{
      deleted: boolean;
      message?: string;
      promotion: { operation: string; docStatus: string; ranWorkflows: string[] };
    }>(`/bus/${entity.route}/${created?.id}`, { allowFailure: true });

    // A record another record depends on cannot be deleted, and 409 is the
    // right answer — the model may declare an `afterCreate` hook that creates a
    // child pointing back with a NOT NULL foreign key, so this record was born
    // undeletable. DeviationReport in the drug-discovery example is exactly
    // that: creating one runs a workflow whose CreateEntity step writes a CAPA.
    //
    // What this test is actually for is the delete that *lies*: one that stamps
    // `deleted_at`, answers 204, and leaves the row and its foreign keys in the
    // table. Both a real delete and an honest refusal are correct; neither
    // silently reports success it did not achieve.
    if (response.status === 409) {
      // The global exception filter normalises an error into
      // `{statusCode, message, error, ...}`, so the refusal is read from the
      // message rather than from a `deleted: false` field.
      expect(String(response.data.message ?? "")).not.toBe("");
      // Refused means unchanged: the record is still there to be read.
      const still = await harness.client.get(`/bus/${entity.route}/${created?.id}`, {
        allowFailure: true,
      });
      expect(still.ok).toBe(true);
      return;
    }

    expect(response.status).toBe(200);
    expect(response.data.deleted).toBe(true);
    expect(response.data.promotion.operation).toBe("delete");
    expect(response.data.promotion.docStatus).toBe("deleted");

    const after = await harness.client.get(`/bus/${entity.route}/${created?.id}`, {
      allowFailure: true,
    });
    expect(after.ok).toBe(false);
  });

  it("stops listing a record once it is deleted", async () => {
    const textField = firstTextField(entity);
    if (!textField) return;

    const marker = `deleted-${Date.now()}`;
    const created = await harness.createWithParents(entity, { [textField.name]: marker });
    if (!created) return;

    const deleted = await harness.client.delete(`/bus/${entity.route}/${created.id}`, {
      allowFailure: true,
    });
    // Nothing to assert about a record that is still there on purpose — see the
    // delete test above for why a 409 is a correct answer.
    if (deleted.status === 409) return;

    // Reachable by id and absent from the list is one bug; gone from the list
    // and still returned by a filter is another. The list is what a screen
    // shows, so it is the one that has to be right.
    const listed = await harness.client.get<{ data: Array<{ id: string }> }>(
      `/bus/${entity.route}?filter.${textField.name}=equals:${encodeURIComponent(marker)}`,
      { allowFailure: true }
    );
    if (listed.ok) {
      expect(listed.data.data.map((row) => row.id)).not.toContain(created.id);
    }
  });

  it("exposes every writable field through the API", async () => {
    const created = await harness.createWithParents(entity);
    expect(created).not.toBeNull();

    const response = await harness.client.get<Record<string, unknown>>(
      `/bus/${entity.route}/${created?.id}`
    );

    const returned = new Set(Object.keys(response.data));
    const missing = writableFields(entity)
      .map((f) => f.name)
      .filter((name) => !returned.has(name));

    expect(missing).toEqual([]);
  });
});
