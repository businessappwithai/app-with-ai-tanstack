/**
 * A record from creation to deletion, and the trail it leaves.
 *
 * The generated application does four things to a row that no CRUD test looks
 * for, because none of them change what a `GET` returns:
 *
 *   - it *promotes* the row after a write, running the model's rules and
 *     workflows and setting `doc_status` to `final` or leaving it `draft`;
 *   - it bumps `version`, which is what makes a concurrent update detectable;
 *   - it deletes softly, so the row leaves the listing but stays for the audit;
 *   - it records the write, and lets a reader attach notes to the record.
 *
 * Each was silently wrong at some point. `doc_status` in particular: the seed
 * inserts straight into the table, so no promotion runs, and every sample row
 * in a freshly generated application carried a `DRAFT` badge on data that was
 * complete.
 *
 * Generated: {{now}}
 * Project: {{project.name}}
 */

import { afterAll, beforeAll, describe, expect, it } from "../harness/testing.ts";
import { entities, firstTextField, harness } from "../harness/index.ts";

interface Row {
  id?: string;
  version?: number;
  doc_status?: string;
  deleted_at?: string | null;
  promotion?: { docStatus?: string; promoted?: boolean; ranRules?: unknown; ranWorkflows?: unknown };
  [column: string]: unknown;
}

function rows<T>(body: unknown): T[] {
  if (Array.isArray(body)) return body as T[];
  if (body && typeof body === "object") {
    const record = body as Record<string, unknown>;
    if (Array.isArray(record.data)) return record.data as T[];
  }
  return [];
}

describe("record lifecycle", () => {
  beforeAll(async () => {
    await harness.setup();
  });

  afterAll(async () => {
    await harness.teardown();
  });

  for (const entity of entities) {
    describe(entity.name, () => {
      it("reports what the write set off", async () => {
        const created = (await harness.createWithParents(entity)) as Row | null;
        if (!created) return;

        // The promotion result is how a client explains a refusal without a
        // second request. Its absence is not cosmetic: the form has nothing to
        // show when a rule holds a record back.
        expect(created.promotion).toBeDefined();
        expect(typeof created.promotion?.docStatus).toBe("string");
      });

      it("finalises a record nothing held back", async () => {
        const created = (await harness.createWithParents(entity)) as Row | null;
        if (!created) return;

        const promotion = created.promotion;
        if (!promotion) return;

        // A record whose rules all passed is `final`. One that a rule stopped
        // is legitimately still `draft` — assert the two agree rather than
        // demanding an outcome the model may not permit.
        if (promotion.promoted === true) {
          expect(created.doc_status).toBe("final");
        } else {
          expect(created.doc_status).toBe("draft");
        }
      });

      it("starts version at 1 and moves it on update", async () => {
        const created = (await harness.createWithParents(entity)) as Row | null;
        if (!created?.id) return;

        expect(created.version).toBe(1);

        const text = firstTextField(entity);
        if (!text) return;

        const updated = await harness.client.patch<Row>(
          `/bus/${entity.route}/${created.id}`,
          { [text.name]: `e2e-version-${Date.now().toString(36)}` },
          { allowFailure: true }
        );
        if (!updated.ok) return;

        expect(Number(updated.data.version)).toBeGreaterThan(1);
      });

      it("deletes softly — gone from the listing, still on the row", async () => {
        const created = (await harness.createWithParents(entity)) as Row | null;
        if (!created?.id) return;
        const id = created.id;

        const removed = await harness.client.delete(`/bus/${entity.route}/${id}`, {
          allowFailure: true,
        });

        const listed = await harness.client.get(`/bus/${entity.route}?limit=500`, {
          allowFailure: true,
        });
        const ids = listed.ok ? rows<Row>(listed.data).map((row) => row.id) : [];

        /*
         * Both outcomes are asserted, because the one that was wrong was the
         * refusal. A child row with a NOT NULL foreign key back to this record
         * makes the cascade impossible, the transaction rolls back correctly —
         * and the answer used to be 200 with `{ deleted: false }` in the body,
         * so every client that reads the status reported the record gone while
         * it was still there.
         *
         * So: a delete that says it happened must remove the row, and one that
         * says it did not must leave it. What is not allowed is the two
         * disagreeing.
         */
        if (removed.ok) {
          if (listed.ok) expect(ids.includes(id)).toBe(false);

          // Fetching it directly answers 404 as well: the row is retained for
          // the trail, not for the API.
          const fetched = await harness.client.get(`/bus/${entity.route}/${id}`, {
            allowFailure: true,
          });
          expect(fetched.status).toBe(404);
          return;
        }

        // Refused — and it has to say so as a refusal, not as a success.
        expect(removed.status).toBe(409);
        if (listed.ok) expect(ids.includes(id)).toBe(true);

        const stillThere = await harness.client.get(`/bus/${entity.route}/${id}`, {
          allowFailure: true,
        });
        expect(stillThere.status).toBe(200);
      });

      it("carries the write into the audit trail", async () => {
        const created = (await harness.createWithParents(entity)) as Row | null;
        if (!created?.id) return;

        /*
         * Ask for this record's rows, not for a page of the entity's.
         *
         * The endpoint orders by `timestamp desc`, and this used to read the
         * newest 50 for the entity type and look for the id among them. On an
         * entity the bulk seed touched, dozens of rows share a timestamp to the
         * resolution stored, ties break arbitrarily, and the row written a
         * moment ago lands outside the first fifty — so the suite failed on
         * whichever two entities happened to lose the tie, and passed on the
         * next run. `entity_id` is an indexed column and the filter is
         * supported; there is no reason to page through anything.
         */
        const trail = await harness.client.get(
          `/audit?entity_type=${entity.tableName}&entity_id=${created.id}&limit=50`,
          { allowFailure: true }
        );
        if (!trail.ok) return;

        const entries = rows<{ entity_id?: string; record_id?: string; action?: string }>(
          trail.data
        );
        const found = entries.some(
          (entry) => entry.entity_id === created.id || entry.record_id === created.id
        );
        expect(found).toBe(true);
      });

      it("serves the record's own history", async () => {
        const created = (await harness.createWithParents(entity)) as Row | null;
        if (!created?.id) return;

        const history = await harness.client.get(
          `/records/${entity.route}/${created.id}/history`,
          { allowFailure: true }
        );
        expect(history.status).toBe(200);
      });

      it("takes a note against the record and gives it back", async () => {
        const created = (await harness.createWithParents(entity)) as Row | null;
        if (!created?.id) return;

        const body = `e2e note ${Date.now().toString(36)}`;
        const posted = await harness.client.post(
          `/records/${entity.route}/${created.id}/notes`,
          { note: body, body, content: body },
          { allowFailure: true }
        );
        if (!posted.ok) return;

        const listed = await harness.client.get(
          `/records/${entity.route}/${created.id}/notes`,
          { allowFailure: true }
        );
        expect(listed.status).toBe(200);

        const text = JSON.stringify(listed.data ?? "");
        expect(text.includes(body)).toBe(true);
      });
    });
  }
});
