/**
 * Application Dictionary — the window, tab and field layout.
 *
 * `02-dictionary` checks that every column the ERD declares reached
 * `sys_column`. That is the data half. This is the presentation half: a column
 * nothing draws is a column nobody can edit, and the three tables that decide
 * what gets drawn are `sys_window` (the screen), `sys_tab` (the section of it
 * bound to a table) and `sys_field` (the control bound to a column).
 *
 * The failure this suite exists to catch is silent by construction. A missing
 * `sys_field` row does not error anywhere — the form simply renders without
 * that input, the API keeps accepting the column, and the only symptom is a
 * field a user cannot fill in. Same for a window with no tab: the screen opens
 * empty and the application looks like it has no data.
 *
 * Generated: {{now}}
 * Project: {{project.name}}
 */

import { afterAll, beforeAll, describe, expect, it } from "../harness/testing.ts";
import { entities, harness, writableFields } from "../harness/index.ts";

interface WindowRow {
  sys_window_id: string;
  name: string;
  description?: string | null;
  help?: string | null;
  window_type?: string | null;
  is_active?: boolean;
}

interface TabRow {
  sys_tab_id: string;
  sys_window_id: string;
  sys_table_id: string;
  name: string;
  seq_no?: number;
  is_active?: boolean;
}

interface MetaResponse {
  table: { sys_table_id: string; table_name: string; name?: string };
  columns: Array<{
    sys_field_id?: string;
    column_name: string;
    name: string;
    seq_no?: number;
    seq_no_grid?: number;
    is_displayed?: boolean;
    is_displayed_grid?: boolean;
  }>;
  window?: WindowRow | null;
}

/** `/sys/...` list endpoints answer either a bare array or `{ data: [...] }`. */
function rows<T>(body: unknown): T[] {
  if (Array.isArray(body)) return body as T[];
  if (body && typeof body === "object") {
    const record = body as Record<string, unknown>;
    if (Array.isArray(record.data)) return record.data as T[];
  }
  return [];
}

describe("application dictionary — window, tab and field", () => {
  let windows: WindowRow[] = [];
  let tabs: TabRow[] = [];
  /** entity route → its `/meta` payload, fetched once and shared. */
  const metaByRoute = new Map<string, MetaResponse>();

  beforeAll(async () => {
    await harness.setup();

    const [windowResponse, tabResponse] = await Promise.all([
      harness.client.get("/sys/windows?limit=500", { allowFailure: true }),
      harness.client.get("/sys/tabs?limit=500", { allowFailure: true }),
    ]);
    windows = windowResponse.ok ? rows<WindowRow>(windowResponse.data) : [];
    tabs = tabResponse.ok ? rows<TabRow>(tabResponse.data) : [];

    for (const entity of entities) {
      const response = await harness.client.get<MetaResponse>(`/bus/${entity.route}/meta`, {
        allowFailure: true,
      });
      if (response.ok) metaByRoute.set(entity.route, response.data);
    }
  });

  afterAll(async () => {
    await harness.teardown();
  });

  it("serves the window registry", () => {
    expect(windows.length).toBeGreaterThan(0);
  });

  it("serves the tab registry", () => {
    expect(tabs.length).toBeGreaterThan(0);
  });

  it("registers a window for every entity", () => {
    const missing = entities.filter((entity) => !metaByRoute.get(entity.route)?.window).map(
      (entity) => entity.tableName
    );
    expect(missing).toEqual([]);
  });

  // A tab whose sys_table_id names no registered table draws a section bound
  // to nothing — the screen renders a heading and no rows.
  it("binds every tab to a registered table", () => {
    const tableIds = new Set(
      [...metaByRoute.values()].map((meta) => meta.table?.sys_table_id).filter(Boolean)
    );
    // Only tabs belonging to entity windows are checked: the Application
    // Dictionary's own screens (Audit Log, Workflow Designer…) describe how the
    // application is built and have no bus_ table behind them.
    const entityWindowIds = new Set(
      [...metaByRoute.values()].map((meta) => meta.window?.sys_window_id).filter(Boolean)
    );
    const orphans = tabs
      .filter((tab) => entityWindowIds.has(tab.sys_window_id))
      .filter((tab) => !tab.sys_table_id || !tableIds.has(tab.sys_table_id))
      .map((tab) => tab.name);
    expect(orphans).toEqual([]);
  });

  it("gives every window a distinct name", () => {
    const names = windows.map((window) => window.name);
    const duplicates = names.filter((name, index) => names.indexOf(name) !== index);
    expect([...new Set(duplicates)]).toEqual([]);
  });

  for (const entity of entities) {
    describe(entity.displayName, () => {
      it("has a window carrying a name and help", () => {
        const meta = metaByRoute.get(entity.route);
        expect(meta?.window).toBeTruthy();
        expect(typeof meta?.window?.name).toBe("string");
        expect((meta?.window?.name ?? "").length).toBeGreaterThan(0);
      });

      it("has at least one tab under that window", () => {
        const meta = metaByRoute.get(entity.route);
        const windowId = meta?.window?.sys_window_id;
        expect(windowId).toBeTruthy();
        const owned = tabs.filter((tab) => tab.sys_window_id === windowId);
        expect(owned.length).toBeGreaterThan(0);
      });

      it("binds its tab to its own table", () => {
        const meta = metaByRoute.get(entity.route);
        const windowId = meta?.window?.sys_window_id;
        const owned = tabs.filter((tab) => tab.sys_window_id === windowId);
        // Every tab on an entity's window must point at that entity's table.
        // A tab bound to a *different* table is the bug this catches: the
        // screen opens and lists somebody else's records.
        const foreign = owned
          .filter((tab) => tab.sys_table_id !== meta?.table?.sys_table_id)
          .map((tab) => tab.name);
        expect(foreign).toEqual([]);
      });

      it("draws a field for every column the model declares", async () => {
        const response = await harness.client.get<Array<{ column_name: string }>>(
          `/bus/${entity.route}/fields/form?includeHidden=true`
        );
        const drawn = new Set(response.data.map((field) => field.column_name));
        const missing = writableFields(entity)
          .map((field) => field.name)
          .filter((name) => !drawn.has(name));
        expect(missing).toEqual([]);
      });

      // Two fields sharing a sequence leave the form's order down to whatever
      // the database returns first, which is not stable between runs.
      it("gives its form fields distinct sequence numbers", async () => {
        const response = await harness.client.get<Array<{ seq_no?: number }>>(
          `/bus/${entity.route}/fields/form?includeHidden=true`
        );
        const sequences = response.data
          .map((field) => field.seq_no)
          .filter((seq): seq is number => typeof seq === "number");
        expect(sequences.length).toBe(new Set(sequences).size);
      });

      it("labels every field with something other than the raw column name", async () => {
        const response = await harness.client.get<
          Array<{ column_name: string; name?: string }>
        >(`/bus/${entity.route}/fields/form?includeHidden=true`);

        // `smiles` and `id` are already words; the check is that a column with
        // underscores in it was turned into a label, not printed as stored.
        const raw = response.data
          .filter((field) => field.column_name.includes("_"))
          .filter((field) => !field.name || field.name === field.column_name)
          .map((field) => field.column_name);
        expect(raw).toEqual([]);
      });

      // Grid columns are drawn from the same field rows as the form, so a grid
      // field that is not also a form field is a row the form cannot reach.
      it("draws its grid from fields the form also knows", async () => {
        const [form, grid] = await Promise.all([
          harness.client.get<Array<{ column_name: string }>>(
            `/bus/${entity.route}/fields/form?includeHidden=true`
          ),
          harness.client.get<Array<{ column_name: string }>>(`/bus/${entity.route}/fields/grid`),
        ]);
        const known = new Set(form.data.map((field) => field.column_name));
        const unknown = grid.data
          .map((field) => field.column_name)
          .filter((name) => !known.has(name));
        expect(unknown).toEqual([]);
      });

      it("shows at least one column in the grid", async () => {
        const response = await harness.client.get<Array<unknown>>(
          `/bus/${entity.route}/fields/grid`
        );
        // A grid with no columns is a list screen that renders empty rows.
        expect(response.data.length).toBeGreaterThan(0);
      });

      it("answers the window-help request its screens make", async () => {
        const response = await harness.client.get<{
          window?: { name?: string };
          tabs?: unknown[];
          fields?: unknown[];
        }>(`/sys/window-help/${entity.tableName}`, { allowFailure: true });

        expect(response.status).toBe(200);
        expect(response.data?.window?.name).toBeTruthy();
      });
    });
  }
});
