# {{project.name}} - Backend Configuration
# Generated: {{now}}

# Server
PORT={{config.port}}
NODE_ENV=development

# Database (PostgreSQL)
# Uses local socket auth by default — no password needed on most dev machines
# The Node "pg" driver (unlike psql) does not infer the OS user or Unix socket
# path automatically, so both are made explicit here based on this machine's
# local Postgres install.
DATABASE_URL=postgresql://{{osUser}}@localhost/{{snakeCase project.name}}{{pgSocketParam}}

# Alternatively, set individual vars (used when DATABASE_URL is not set):
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER={{osUser}}
# DB_PASSWORD=
# DB_NAME={{snakeCase project.name}}

# CORS
CORS_ORIGIN=http://localhost:{{config.frontendPort}}

# Admin user (auto-created on first start)
ADMIN_EMAIL=admin@admin.com
# At least 8 characters — see minPasswordLength in src/lib/better-auth.ts.
ADMIN_PASSWORD=admin123

# AI assistant — retrieval over this application's own model
#
# One endpoint serves it: OpenAI-compatible `POST /v1/embeddings`. A local model
# (Ollama, LM Studio, llama.cpp, vLLM), OpenAI, or any gateway speaking that
# shape all work. Unreachable, the assistant logs one warning and every other
# screen is unaffected.
#
# The Claude API is not an option here on its own: it has no embeddings
# endpoint, and it is `POST /v1/messages` with `x-api-key` rather than
# `POST /v1/embeddings` with a bearer token.
AI_BASE_URL=http://127.0.0.1:8000/v1
AI_API_KEY=local
AI_EMBEDDING_MODEL=bge-small-en-v1.5
# The pgvector column width, fixed when the index is created. Changing it later
# means re-creating the index and re-ingesting — set it before the first start.
# OpenAI's text-embedding-3-small is 1536.
AI_EMBEDDING_DIMENSIONS=384
# Turn the assistant off entirely; the application is fully functional without it.
# ENABLE_MODEL_CONTEXT=false

# Logging
LOG_LEVEL=debug

# Immudb (cryptographic audit trail) — set to true if you have immudb running
IMMUDB_ENABLED=false
IMMUDB_HOST=127.0.0.1
IMMUDB_PORT=8088

# Session Configuration
# BetterAuth session expires in 1 day (86400 seconds)
BETTER_AUTH_SECRET=change-me-in-production-use-a-long-random-string

# ElectricSQL — streams the Application Dictionary to each client.
#
# Set this to a running Electric server to turn dictionary sync on. Left unset,
# GET /v1/shape answers 503 and the frontend reads the dictionary over the HTTP
# API instead: slower per screen, but fully functional.
#
# Electric must be pointed at this same database with logical replication on
# (wal_level=logical). Only the sys_ dictionary tables are ever exposed through
# the proxy, and only the rows the caller's roles allow.
# ELECTRIC_URL=http://127.0.0.1:3000
