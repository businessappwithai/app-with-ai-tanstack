import { Module } from '@nestjs/common';
import { ConfigModule } from '@nestjs/config';
import { APP_FILTER, APP_INTERCEPTOR, APP_GUARD } from '@nestjs/core';
import { UserThrottlerGuard } from './common/guards/user-throttler.guard';
import { ThrottlerModule } from '@nestjs/throttler';

import { DatabaseModule } from './database/database.module';
import { SysModule } from './modules/sys/sys.module';
import { BusModule } from './modules/bus/bus.module';
import { AuthModule } from './modules/auth/auth.module';
import { RulesModule } from './modules/rules/rules.module';
import { WorkflowModule } from './modules/workflow/workflow.module';
import { WorkflowDefinitionsModule } from './modules/workflow-definitions/workflow-definitions.module';
import { ModelContextModule } from './modules/model-context/model-context.module';
import { JobQueueModule } from './modules/jobs/job-queue.module';
import { ElectricModule } from './modules/electric/electric.module';
import { AuditModule } from './modules/audit/audit.module';
import { AuditInterceptor } from './modules/audit/audit.interceptor';
import { NotificationsModule } from './modules/notifications/notifications.module';

import { HttpExceptionFilter } from './common/filters/http-exception.filter';
import { TransformInterceptor } from './common/interceptors/transform.interceptor';

@Module({
  imports: [
    // Configuration
    ConfigModule.forRoot({
      isGlobal: true,
      // Use __dirname-relative paths so .env is found regardless of process cwd
      envFilePath: [
        `${__dirname}/../.env.local`,
        `${__dirname}/../.env`,
        '.env.local',
        '.env',
      ],
    }),

    /*
     * Rate limiting, per caller.
     *
     * The limit is per route handler per caller, and `UserThrottlerGuard`
     * decides who a caller is: the session for anyone signed in, the source
     * address for anyone not. That distinction is the whole point — the
     * default tracker is the IP, and behind the reverse proxy this application
     * is deployed with, every user has the *same* IP. A generated application
     * refused legitimate traffic at 31 concurrent users because of it, while
     * answering in 3ms.
     *
     * THROTTLE_TTL / THROTTLE_LIMIT override the defaults — raise the limit for
     * bulk data loads and end-to-end runs, which legitimately exceed 1000/min.
     */
    ThrottlerModule.forRoot([
      {
        ttl: Number(process.env.THROTTLE_TTL ?? 60000),
        limit: Number(
          process.env.THROTTLE_LIMIT ?? (process.env.NODE_ENV === 'production' ? 300 : 1000),
        ),
      },
    ]),

    // Database (Knex.js)
    DatabaseModule,

    // Authentication (BetterAuth with PostgreSQL)
    AuthModule,

    // Business Rules Engine (GoRules zen-engine)
    RulesModule,

    // Workflow orchestration (Trigger.dev v3 + GoRules + BPMN executor)
    WorkflowModule,

    // Visual BPMN workflow definitions (crud for sys_workflow_definitions)
    WorkflowDefinitionsModule,
    ModelContextModule,

    // Background job processing (Trigger.dev v3)
    JobQueueModule,

    // Electric shape proxy — streams the role-scoped Application Dictionary
    ElectricModule,

    // System/Dictionary module (sys_ tables)
    SysModule,

    // Business entity module (bus_ tables)
    BusModule,

    // Immutable audit trail (immudb + PostgreSQL audit_log)
    AuditModule,

    // The bell beside Log out — a user's own record transactions, read back
    // out of the audit trail. Imported after AuditModule because that is where
    // the rows it serves are written.
    NotificationsModule,
  ],
  providers: [
    // Global exception filter
    {
      provide: APP_FILTER,
      useClass: HttpExceptionFilter,
    },

    // Global transform interceptor
    {
      provide: APP_INTERCEPTOR,
      useClass: TransformInterceptor,
    },

    // Global audit interceptor.
    //
    // Global, not per-controller: it used to hang off BusController alone, so
    // the audit page showed record edits and nothing else — business rule
    // changes, workflow definition changes, role grants and dictionary edits
    // all went unrecorded. An audit trail with holes in it is worse than none,
    // because it looks complete.
    {
      provide: APP_INTERCEPTOR,
      useClass: AuditInterceptor,
    },

    /* The only global guard, so it runs before the per-controller auth guards
       — which is why it reads the session cookie itself rather than
       `request.user`, and why that detail is load-bearing. */
    {
      provide: APP_GUARD,
      useClass: UserThrottlerGuard,
    },
  ],
})
export class AppModule {}
