/**
 * Seed System Reference Data (Roles, Tables, Columns, etc.)
 *
 * NOTE: Admin user (admin@admin.com / password: admin) is created by backend bootstrap
 * in main.ts using auth.api.signUpEmail() to ensure proper better-auth password hashing.
 *
 * This seed file creates system reference data only:
 * - System roles
 * - Table/Column/Window/Tab/Field definitions
 *
 * Generated: {{now}}
 */

import { Kysely } from 'kysely';

export async function seed(db: Kysely<any>): Promise<void> {
  // ========================================
  // Create System Roles
  // ========================================

  const roles = [
    {
      name: 'System Administrator',
      description: 'Full system access with all permissions',
      user_level: 'S',
      is_master_role: true,
    },
    {
      name: 'Administrator',
      description: 'Administrative access to all modules',
      user_level: 'C',
      is_master_role: false,
    },
    {
      name: 'User',
      description: 'Standard user access',
      user_level: 'C',
      is_master_role: false,
    },
    {
      name: 'Read Only',
      description: 'Read-only access to data',
      user_level: 'C',
      is_master_role: false,
    },
  ];

  console.log('🔐 Seeding system roles...');

  for (const role of roles) {
    await db
      .insertInto('sys_role')
      .values({
        sys_role_id: require('uuid').v4(),
        ...role,
        is_active: true,
        is_personal_lock: false,
        is_personal_access: false,
        max_query_records: 0,
        is_show_accounting: role.is_master_role,
        entity_type: 'D',
        created_by: 'system',
        updated_by: 'system',
        created_at: new Date(),
        updated_at: new Date(),
      })
      .onConflict((oc) => oc.doNothing())
      .execute();
  }

  console.log(`✓ System roles seeded (admin user created via bootstrap)`);
}
