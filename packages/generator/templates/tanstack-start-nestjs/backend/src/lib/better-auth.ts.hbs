/**
 * BetterAuth Configuration
 *
 * Modern authentication for {{projectName}}
 * - Email/Password authentication
 * - Session management
 * - Role-based access control
 */

import { betterAuth } from 'better-auth';
import { Kysely, PostgresDialect } from 'kysely';
import { Pool } from 'pg';
import { config } from 'dotenv';
import * as path from 'path';

// Load .env from backend root regardless of cwd
config({ path: path.join(__dirname, '..', '..', '.env'), override: true });
config({ path: path.join(__dirname, '..', '..', '.env.local'), override: true });

let authInstance: any = null;

function buildPool() {
  const url = process.env.DATABASE_URL;
  if (url) {
    return new Pool({ connectionString: url });
  }
  return new Pool({
    host: process.env.DB_HOST ?? '127.0.0.1',
    port: Number(process.env.DB_PORT ?? 5432),
    user: process.env.DB_USER ?? '{{projectSnake}}',
    password: process.env.DB_PASSWORD ?? '',
    database: process.env.DB_NAME ?? '{{projectSnake}}',
  });
}

/**
 * The options this application configures Better Auth with.
 *
 * Exported separately from the instance so the schema migration can ask the
 * library what tables these options require without standing up a second auth
 * instance — the diff has to be taken against the same configuration the app
 * will query with, or it reconciles the wrong schema.
 */
export function buildAuthOptions(): any {
  const kysely = new Kysely<any>({ dialect: new PostgresDialect({ pool: buildPool() }) });

  return {
      // `{ db, type }` rather than `kyselyAdapter(db)`. Handed a bare adapter,
      // Better Auth cannot tell what it is talking to and falls back to SQLite
      // — against Postgres that produces queries the database answers with
      // nothing, so every sign-in came back "Invalid email or password" while
      // the row sat there in the table. Naming the dialect also lets the
      // library run its own migrations, which is how 0010 keeps this schema
      // level with the installed version.
      database: { db: kysely, type: 'postgres' },
      baseURL: process.env.BETTER_AUTH_URL || `http://localhost:${process.env.PORT || '{{config.port}}'}`,
      // Better Auth rejects a state-changing request whose Origin is not listed
      // here, and the front end's /api/auth proxy passes the browser's Origin
      // through unchanged — so this list has to contain the address people
      // actually type. The defaults cover a local run; anywhere else, name it:
      //
      //   CORS_ORIGIN=http://app.internal:{{config.frontendPort}}
      //
      // Getting this wrong looks like a wrong password, not a misconfiguration,
      // which is why the list is deliberately generous about localhost.
      // The localhost entries are development conveniences and are only
      // trusted in development. Listing them unconditionally meant a deployed
      // application accepted requests claiming a localhost origin — a slice of
      // CSRF surface with nothing to pay for it, since nobody signs into
      // production from http://localhost. A deployment names its real origin
      // in CORS_ORIGIN, which is where this list should come from.
      trustedOrigins: [
        ...(process.env.CORS_ORIGIN ? process.env.CORS_ORIGIN.split(',').map((o: string) => o.trim()) : []),
        ...(process.env.NODE_ENV === 'production'
          ? []
          : [
              `http://localhost:${process.env.PORT || '{{config.port}}'}`,
              'http://localhost:{{config.frontendPort}}',
              'http://127.0.0.1:{{config.frontendPort}}',
              'http://localhost:3001',
              'http://localhost:3000',
            ]),
      ].filter(Boolean),
      secret: (() => {
        const s = process.env.BETTER_AUTH_SECRET;
        if (!s) throw new Error('BETTER_AUTH_SECRET environment variable is required');
        return s;
      })(),
      emailAndPassword: {
        enabled: true,
        // Sign-up stays enabled *here* on purpose. `disableSignUp` turns off
        // `auth.api.signUpEmail` as well as the HTTP route, and that server-side
        // call is how the administrator-only endpoint writes a password — with
        // the flag set, nobody can be created at all. The public route is
        // blocked in main.ts instead, where it only affects HTTP callers.
        requireEmailVerification: false,
        minPasswordLength: 8,
        sendResetPassword: async ({ user, url: _url }: { user: { email?: string; id: string; name: string }; url: string; token: string }) => {
          console.log('Password reset requested for:', user.email || user.id);
        },
        sendVerificationEmail: async ({ user, url: _url }: { user: { email?: string; id: string; name: string }; url: string; token: string }) => {
          console.log('Verification email sent to:', user.email || user.id);
        },
      },
      session: {
        expiresIn: 60 * 60 * 24,
        updateAge: 60 * 60 * 12,
        cookieCache: {
          enabled: true,
          maxAge: 5 * 60,
        },
      },
      account: {
        accountLinking: {
          enabled: false,
        },
      },
      user: {
        additionalFields: {
          /*
           * `input: false` on both, and it is load-bearing.
           *
           * Better Auth accepts an additional field from the client unless the
           * field says otherwise, on sign-up AND on `updateUser`. `main.ts`
           * forwards the whole of `/api/auth/*` to this library and blocks only
           * `/sign-up`, so `POST /api/auth/update-user` is reachable by anyone
           * who is signed in.
           *
           * `role` is not decoration: `roles.guard.ts` folds `user.role` into
           * the caller's role set and `dictionary-write.guard.ts` does the same.
           * Without this flag, `{"role":"admin"}` sent to update-user made the
           * sender an administrator of their own application — a one-request
           * privilege escalation in every generated application.
           *
           * `sysUserId` is the same shape of problem pointed at a different
           * target: it is the link to `sys_user`, which is where the
           * application's own roles hang, so letting a client write it lets
           * them adopt somebody else's.
           *
           * Both are written server-side — by the bootstrap in `main.ts` and by
           * the administrator-only user-management endpoint — and neither has
           * any reason to arrive from a browser.
           */
          role: {
            type: 'string',
            required: false,
            defaultValue: 'user',
            input: false,
          },
          sysUserId: {
            type: 'string',
            required: false,
            input: false,
          },
        },
      },
      /*
       * Rate limiting for /api/auth/* — better-auth's own, because nothing
       * else covers these routes.
       *
       * The application's Nest-level limiter (`UserThrottlerGuard`) is an
       * APP_GUARD, so it only sees requests that go through a Nest controller.
       * better-auth is mounted in `main.ts` as a raw Fastify route —
       * `fastifyInstance.all('/api/auth/*', …)` — which is deliberate (its
       * handler wants the untouched Request) and has the consequence that the
       * guard never runs on it. Sign-in therefore accepted unlimited password
       * guesses: a load test put 140 wrong passwords through in nine seconds
       * and every one of them was answered.
       *
       * `window` is in SECONDS here, unlike THROTTLE_TTL, which Nest takes in
       * milliseconds. Getting that wrong silently buys a 60x wider window.
       *
       * The custom rule on sign-in is the one that matters, and its number is a
       * compromise rather than a maximum. Counting is per IP, and without
       * TRUST_PROXY set every user behind the deployment's proxy counts as the
       * same IP — so a limit tuned for one person locks out a shift change. 30
       * a minute survives fifty nurses arriving at 7am and still reduces a
       * password-spraying attack to half a guess a second, which is not an
       * attack. Set TRUST_PROXY where a real proxy sits in front and the count
       * becomes per client, which is what the number is actually for.
       *
       * This is a floor, not a substitute for per-account lockout, which this
       * application does not have. Everything else under /api/auth gets the
       * default, which is mostly the session reads the front end makes on
       * every page.
       */
      rateLimit: {
        enabled: true,
        window: Number(process.env.AUTH_RATE_WINDOW ?? 60),
        max: Number(process.env.AUTH_RATE_MAX ?? 120),
        customRules: {
          '/sign-in/email': {
            window: Number(process.env.AUTH_SIGNIN_WINDOW ?? 60),
            max: Number(process.env.AUTH_SIGNIN_MAX ?? 30),
          },
          '/sign-up/email': {
            window: Number(process.env.AUTH_SIGNIN_WINDOW ?? 60),
            max: Number(process.env.AUTH_SIGNUP_MAX ?? 10),
          },
        },
      },

      advanced: {
        cookiePrefix: '{{projectSnake}}_app',
        crossSubDomainCookies: {
          enabled: false,
        },
        /*
         * Which address the rate limit above counts against.
         *
         * Only when TRUST_PROXY says a proxy really is in front, and for the
         * same reason `main.ts` gates Fastify's own `trustProxy`: a client
         * that may set its own `X-Forwarded-For` can give itself a fresh
         * bucket per request, which turns a sign-in limit into decoration.
         *
         * Left off, better-auth counts against the connection's address —
         * the proxy's, in a proxied deployment, so the whole installation
         * shares one sign-in budget. That errs towards locking people out
         * rather than towards letting an attacker through, which is the right
         * way round for this one; set TRUST_PROXY to get per-client counting.
         */
        ...(process.env.TRUST_PROXY
          ? {
              ipAddress: {
                ipAddressHeaders: (
                  process.env.TRUST_PROXY_IP_HEADERS ?? 'x-forwarded-for'
                )
                  .split(',')
                  .map((header) => header.trim().toLowerCase())
                  .filter(Boolean),
              },
            }
          : {}),
      },
  };
}

export async function initAuth() {
  if (!authInstance) {
    authInstance = betterAuth(buildAuthOptions());
  }

  return authInstance;
}

export function getAuth(): any {
  if (!authInstance) {
    throw new Error('Auth not initialized. Call initAuth() first.');
  }
  return authInstance;
}

export { getAuth as auth };
export type Session = any;
