/**
 * Entity Promotion — Trigger.dev v3 Task
 *
 * Runs the draft → final pipeline out of process so it survives an API restart
 * and picks up Trigger.dev's retry policy.
 *
 * The task is deliberately thin. All of the behaviour — discovering associated
 * rules and workflows, running them in one transaction, promoting to final or
 * leaving a draft with an explanation — lives in EntityPromotionService, which
 * runs identically when Trigger.dev is not configured. Keeping the logic out of
 * the task is what makes it testable without a Trigger.dev instance.
 *
 * Generated: {{now}}
 * Project: {{project.name}}
 */

import { task } from '@trigger.dev/sdk/v3';
import { NestFactory } from '@nestjs/core';
import { AppModule } from '../app.module';
import { EntityPromotionService } from '../modules/bus/entity-promotion.service';
import type { PromotionResult } from '../modules/bus/entity-promotion.service';

export interface EntityPromotionPayload {
  entityName: string;
  entityId: string;
  operation: 'create' | 'update' | 'delete';
  entityData: Record<string, unknown>;
  userId?: string;
}

/**
 * One Nest context per worker process, reused across runs. Building it per run
 * would open a new database pool every time.
 */
let contextPromise: Promise<{ get: <T>(t: any) => T; close: () => Promise<void> }> | null = null;

async function getPromotionService(): Promise<EntityPromotionService> {
  if (!contextPromise) {
    contextPromise = NestFactory.createApplicationContext(AppModule, {
      logger: ['error', 'warn'],
    }) as any;
  }
  const ctx = await contextPromise;
  return ctx.get(EntityPromotionService);
}

export const entityPromotion = task({
  id: 'entity-promotion',
  run: async (payload: EntityPromotionPayload): Promise<PromotionResult> => {
    const service = await getPromotionService();

    const result = await service.promote(
      payload.entityName,
      payload.entityId,
      payload.operation,
      payload.entityData,
    );

    // Surfaced in the Trigger.dev run list. The record is already updated either
    // way, so a failed promotion is a completed run with promoted: false — not a
    // thrown task, which would retry work the user may need to fix by hand first.
    console.log(
      `[entity-promotion] ${result.entityName}:${result.entityId} → ${result.docStatus}` +
        (result.promoted ? '' : ` (${result.failedStep}: ${result.error})`),
    );

    return result;
  },
});
