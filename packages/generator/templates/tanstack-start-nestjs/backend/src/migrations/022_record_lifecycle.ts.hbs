      CONSTRAINT sys_access_grant_kind CHECK (kind IN ('op', 'move', 'reopen')),
      CONSTRAINT sys_access_grant_unique
        UNIQUE (kind, table_name, action, from_state, to_state, role_name)
    )
  `.execute(db);
  // The two lookups: one user's grants (through the view), and the policy — which
  // (table, kind, action) are restricted at all, the same for every user.
  await sql`
    CREATE INDEX IF NOT EXISTS idx_sys_access_grant_role
    ON sys_access_grant (role_key, table_name, kind) WHERE is_active
  `.execute(db);
  await sql`
    CREATE INDEX IF NOT EXISTS idx_sys_access_grant_policy
    ON sys_access_grant (table_name, kind, action) WHERE is_active
  `.execute(db);

  // ── The old tables: copied in, then views ──────────────────────────────────
  if (await isTable(db, 'sys_operation_access')) {
    await sql`
      INSERT INTO sys_access_grant
        (kind, table_name, action, role_name, entity_type, is_active, created_by, updated_by)
