    await sql`DROP TABLE sys_operation_access`.execute(db);
  }
  if (await isTable(db, 'sys_transition_access')) {
    await sql`
      INSERT INTO sys_access_grant
        (kind, table_name, action, status_field, from_state, to_state, role_name,
         entity_type, is_active, created_by, updated_by)
      SELECT 'move', table_name, transition, status_field, from_state, to_state, role_name,
