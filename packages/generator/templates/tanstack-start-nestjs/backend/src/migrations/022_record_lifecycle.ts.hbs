      role_key VARCHAR(100) GENERATED ALWAYS AS (${GRANT_ROLE_KEY}) STORED,
      entity_type VARCHAR(40) NOT NULL DEFAULT 'D',
      is_active BOOLEAN NOT NULL DEFAULT true,
      created_by VARCHAR(100) NOT NULL DEFAULT 'system',
