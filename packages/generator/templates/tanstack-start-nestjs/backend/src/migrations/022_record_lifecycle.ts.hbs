      FROM sys_transition_access
      ON CONFLICT DO NOTHING
    `.execute(db);
    await sql`DROP TABLE sys_transition_access`.execute(db);
  }
  await sql`
    CREATE OR REPLACE VIEW sys_operation_access AS
    SELECT sys_access_grant_id AS sys_operation_access_id, table_name, action AS operation,
           role_name, entity_type, is_active, created_by, updated_by, created_at, updated_at
    FROM sys_access_grant WHERE kind = 'op'
  `.execute(db);
  await sql`
    CREATE OR REPLACE VIEW sys_transition_access AS
    SELECT sys_access_grant_id AS sys_transition_access_id, table_name, action AS transition,
           status_field, from_state, to_state, role_name, entity_type, is_active,
           created_by, updated_by, created_at, updated_at
    FROM sys_access_grant WHERE kind IN ('move', 'reopen')
  `.execute(db);

  // ── One join chain: what a user may do ─────────────────────────────────────
  await sql`
    CREATE OR REPLACE VIEW sys_user_capability AS
