/**
 * The record lifecycle — Draft, the status flow, Final — and who may move a record.
 *
 * ## One grant table
 *
 * `sys_operation_access` (may this role create / read / update / delete this
 * table) and `sys_transition_access` (may this role press this move) said the
 * same kind of thing in two shapes, and the second was filled by nothing. They are
 * one table now, `sys_access_grant`:
 *
 *   kind = 'op'      action is create | read | update | delete
 *   kind = 'move'    action is the move's event (or `from->to`), along a drawn edge
 *   kind = 'reopen'  action is `reopen`: a Final record back to Draft
 *
 * The two old names stay, as read-only views over it, so a report or a screen that
 * reads them keeps working.
 *
 * ## One query answers "what may this user do"
 *
 * `sys_user_capability` is one join chain — the user's roles, to the role, to its
 * grants — on a role key both sides store already folded (`Sales Manager`,
 * `sales_manager` and `sales-manager` are one role), so the join compares plain
 * values on an index rather than folding in code on every request. A user with
 * several roles gets the union of their grants: a role only ever adds access.
 *
 * `sys_access_version` is bumped by a trigger on any change to roles, role
 * assignments or grants, and the trigger sends `pg_notify('access_changed')`, so
 * every backend instance drops its cached capabilities on the next request.
 *
 * ## The rest
 *
 *   - `sys_record_transitions` — every move pressed, refused ones included
 *   - `assigned_to` / `assigned_role` on every business table — who a record is with
 *   - a draft that carries a failure message was an error all along; it says so now
 *
 * Generated: {{now}}
 * Project: {{project.name}}
 */

import { Kysely, sql } from 'kysely';

/** Every business table, for the per-table columns. */
const BUS_TABLES: string[] = [
{{#each entities}}
  '{{tableName}}',
{{/each}}
];

/** The fold every role name is compared under — one statement, in SQL. */
const ROLE_KEY = sql.raw(`lower(regexp_replace(trim(name), '[[:space:]_-]+', ' ', 'g'))`);
const GRANT_ROLE_KEY = sql.raw(`lower(regexp_replace(trim(role_name), '[[:space:]_-]+', ' ', 'g'))`);

async function isTable(db: Kysely<any>, name: string): Promise<boolean> {
  const { rows } = await sql<{ kind: string }>`
    SELECT c.relkind AS kind FROM pg_class c
    JOIN pg_namespace n ON n.oid = c.relnamespace
    WHERE c.relname = ${name} AND n.nspname = current_schema()
  `.execute(db);
  return rows[0]?.kind === 'r';
}

export async function up(db: Kysely<any>): Promise<void> {
  // ── Role keys ──────────────────────────────────────────────────────────────
  await sql`
    ALTER TABLE sys_role
    ADD COLUMN IF NOT EXISTS role_key VARCHAR(100) GENERATED ALWAYS AS (${ROLE_KEY}) STORED
  `.execute(db);
  await sql`CREATE INDEX IF NOT EXISTS idx_sys_role_role_key ON sys_role (role_key)`.execute(db);
  await sql`
    CREATE INDEX IF NOT EXISTS idx_sys_user_roles_user
    ON sys_user_roles (sys_user_id) WHERE is_active
