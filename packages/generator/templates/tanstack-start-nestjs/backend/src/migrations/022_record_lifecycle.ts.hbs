      PERFORM pg_notify('access_changed', TG_TABLE_NAME);
      RETURN NULL;
    END;
    $$ LANGUAGE plpgsql
  `.execute(db);
  for (const table of ['sys_role', 'sys_user_roles', 'sys_access_grant']) {
    await sql.raw(`DROP TRIGGER IF EXISTS trg_${table}_access_changed ON ${table}`).execute(db);
    await sql.raw(`
      CREATE TRIGGER trg_${table}_access_changed
      AFTER INSERT OR UPDATE OR DELETE OR TRUNCATE ON ${table}
      FOR EACH STATEMENT EXECUTE FUNCTION sys_access_changed()
    `).execute(db);
  }

  // ── Every move pressed ─────────────────────────────────────────────────────
  await sql`
    CREATE TABLE IF NOT EXISTS sys_record_transitions (
      sys_record_transition_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
      table_name VARCHAR(100) NOT NULL,
      record_id UUID NOT NULL,
      event VARCHAR(100),
