      assigned_to UUID,
      assigned_role VARCHAR(100),
      created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
      CONSTRAINT sys_record_transitions_outcome
        CHECK (outcome IN ('moved', 'refused', 'failed'))
    )
  `.execute(db);
  await sql`
    CREATE INDEX IF NOT EXISTS idx_sys_record_transitions_record
    ON sys_record_transitions (table_name, record_id, created_at DESC)
  `.execute(db);

  // ── Who a record is with, and errors called errors ─────────────────────────
  for (const table of BUS_TABLES) {
    await sql.raw(`
      ALTER TABLE ${table}
        ADD COLUMN IF NOT EXISTS assigned_to UUID,
        ADD COLUMN IF NOT EXISTS assigned_role VARCHAR(100)
    `).execute(db);
    await sql.raw(`
      UPDATE ${table} SET doc_status = 'error'
      WHERE doc_status = 'draft' AND doc_status_message IS NOT NULL
    `).execute(db);
  }
}

