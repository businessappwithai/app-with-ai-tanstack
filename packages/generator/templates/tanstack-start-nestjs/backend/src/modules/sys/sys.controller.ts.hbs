    // built from when no categories are configured.
    return this.sysService.findAllTables({ page: page ? (parseInt(page, 10) || 1) : 1, limit: limit ? (parseInt(limit, 10) || 100) : 100, search, prefix }, parseFilters(rawFilters), user as never);
