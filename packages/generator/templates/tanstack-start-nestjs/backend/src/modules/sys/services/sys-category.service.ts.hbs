/**
 * SysCategory Service
 *
 * Entity categories for the Application Dictionary. A category groups business
 * entities into a named section; the dashboard renders one block per category,
 * ordered by name.
 *
 * Generated: {{now}}
 * Project: {{project.name}}
 */

import { BadRequestException, ConflictException, Injectable, NotFoundException } from '@nestjs/common';
import { sql } from 'kysely';
import { v4 as uuidv4 } from 'uuid';
import { DatabaseService } from '../../../database/database.service';

export interface SysCategoryRecord {
  sys_category_id: string;
  name: string;
  code: string;
  description: string | null;
  icon: string | null;
  color: string | null;
  seq_no: number;
  is_default: boolean;
  is_active: boolean;
}

export interface CreateCategoryDto {
  name: string;
  code?: string;
  description?: string;
  icon?: string;
  color?: string;
  seq_no?: number;
  is_default?: boolean;
  is_active?: boolean;
}

export type UpdateCategoryDto = Partial<CreateCategoryDto>;

/** Derive a stable code from a display name when the caller does not supply one. */
function slugify(name: string): string {
  return name
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 50);
}

@Injectable()
export class SysCategoryService {
  constructor(private readonly db: DatabaseService) {}

  /**
   * All categories, ordered by name — the order the dashboard renders them in.
   */
  async findAll(options: { includeInactive?: boolean; search?: string } = {}) {
    const { includeInactive = false, search } = options;

    const data = await this.db.kysely
      .selectFrom('sys_category')
      .selectAll()
      .$if(!includeInactive, (qb) => qb.where('is_active', '=', true))
      .$if(!!search, (qb) =>
        qb.where((eb) =>
          eb.or([
            eb('name', 'ilike', `%${search}%`),
            eb('code', 'ilike', `%${search}%`),
            eb('description', 'ilike', `%${search}%`),
          ]),
        ),
      )
      .orderBy('name', 'asc')
      .execute();

    return { data, meta: { total: data.length } };
  }

  async findById(id: string) {
    const category = await this.db.kysely
      .selectFrom('sys_category')
      .selectAll()
      .where('sys_category_id', '=', id)
      .executeTakeFirst();

    if (!category) throw new NotFoundException(`Category ${id} not found`);
    return category;
  }

  /**
   * Categories with their entities attached, ordered by category name then
   * entity name. This is the single call the dashboard needs to render its
   * grouped layout.
   *
   * Entities with no category are returned under a synthetic "Uncategorized"
   * group so nothing silently disappears from the dashboard.
   */
  /**
   * The dashboard, in one statement.
   *
   * Everything the dashboard's business-entity section renders: the categories,
   * the entities inside each, and the entities belonging to no category. It
   * replaces four round trips — `sys_category`, `sys_table`,
   * `sys_operation_access` and `sys_tab ⋈ sys_table`, the last two awaited one
   * after the other — with a single query whose result the code below only
   * has to bucket.
   *
   * The four predicates that decide what a reader sees are all still here, and
   * each is the same rule it was before, expressed in SQL:
   *
   *   business only     `bus_` prefix or `entity_type = 'U'`. The dictionary's
   *                     own `sys_*` tables are the Application Dictionary, not
   *                     the application, and they have their own section.
   *   not a line item   `%%entity <Child> parent: <Parent>` gives the child no
   *                     window and puts its tab inside the parent's at
   *                     `tab_level` 1. A line item is reached by opening a
   *                     parent record, so it is not a place to navigate to —
   *                     the NOT EXISTS below is that rule, read off `sys_tab`
   *                     rather than recomputed so this screen and the detail
   *                     screen cannot disagree.
   *   readable          `%%rbac … .read`. A table no read directive names is
   *                     unrestricted and stays visible; a table some directive
   *                     restricts is visible only to a role that holds it.
   *                     `EntityAccessGuard` enforces the same rule on the way
   *                     in — this applies it one screen earlier, because a
   *                     dashboard that offers nine entities and then answers
   *                     403 on them cannot be told from a broken one.
   *   active            `is_active` on both sides.
   *
   * A FULL OUTER JOIN over a filtered CTE rather than a plain join, because
   * both unmatched sides are wanted: a category with no visible entity (which
   * a master still sees, as an empty section it can fill) and an entity with no
   * category (the `Uncategorized` bucket).
   *
   * Role names are folded the same way `EntityAccessGuard` folds them — case
   * and separators both, because `sys_operation_access` holds the model's
   * spelling (`computational_chemist`) and `sys_role` the displayed one
   * (`Computational Chemist`). Folding case alone makes every multi-word role
   * unequal to itself.
   *
   * Nothing the caller sends reaches this SQL. `isMaster` is a boolean and the
   * role list is bound as a parameter array.
   */
  private async dashboardRows(user?: {
    isMaster?: boolean;
    roles?: string[];
    sysRoles?: string[];
    role?: string;
  }) {
    const foldRole = (role: string) => role.trim().toLowerCase().replace(/[\s\-_]+/g, '');
    const held: string[] = [];
    for (const value of [...(user?.sysRoles ?? []), ...(user?.roles ?? []), user?.role]) {
      if (typeof value === 'string' && value) held.push(foldRole(value));
    }

    // No user at all means no scoping decision to make — the same fail-open the
    // guard takes on a database that predates the rbac migration.
    const unscoped = !user || user.isMaster === true;

    const rows = await sql<{
      sys_category_id: string | null;
      category_name: string | null;
      code: string | null;
      category_description: string | null;
      category_icon: string | null;
      color: string | null;
      seq_no: number | null;
      sys_table_id: string | null;
      table_name: string | null;
      entity_name: string | null;
      entity_description: string | null;
      entity_icon: string | null;
      entity_type: string | null;
    }>`
      WITH visible AS (
        SELECT t.sys_table_id,
               t.table_name,
               t.name        AS entity_name,
               t.description AS entity_description,
               t.icon        AS entity_icon,
               t.entity_type,
               t.sys_category_id
          FROM sys_table t
         WHERE t.is_active
           AND (t.table_name LIKE 'bus\_%' ESCAPE '\' OR t.entity_type = 'U')
           AND NOT EXISTS (
                 SELECT 1 FROM sys_tab tb
                  WHERE tb.sys_table_id = t.sys_table_id
                    AND tb.tab_level > 0)
           AND (
                 ${unscoped}
                 OR NOT EXISTS (
                      SELECT 1 FROM sys_operation_access oa
                       WHERE oa.table_name = t.table_name
                         AND oa.operation = 'read'
                         AND oa.is_active)
                 OR EXISTS (
                      SELECT 1 FROM sys_operation_access oa
                       WHERE oa.table_name = t.table_name
                         AND oa.operation = 'read'
                         AND oa.is_active
                         AND lower(regexp_replace(oa.role_name, '[[:space:]_-]+', '', 'g'))
                             = ANY(${held}))
               )
      )
      SELECT c.sys_category_id,
             c.name        AS category_name,
             c.code,
             c.description AS category_description,
             c.icon        AS category_icon,
             c.color,
             c.seq_no,
             v.sys_table_id,
             v.table_name,
             v.entity_name,
             v.entity_description,
             v.entity_icon,
             v.entity_type
        FROM sys_category c
        FULL OUTER JOIN visible v ON v.sys_category_id = c.sys_category_id
       WHERE c.sys_category_id IS NULL OR c.is_active
       ORDER BY c.name NULLS LAST, v.entity_name
    `.execute(this.db.kysely);

    return { rows: rows.rows, unscoped };
  }

  async findAllWithEntities(user?: { isMaster?: boolean; roles?: string[]; sysRoles?: string[]; role?: string }) {
    const { rows, unscoped } = await this.dashboardRows(user);

    const groups = new Map<string, any>();
    const orphans: any[] = [];

    for (const row of rows) {
      const entity = row.sys_table_id
        ? {
            sys_table_id: row.sys_table_id,
            table_name: row.table_name,
            name: row.entity_name,
            description: row.entity_description,
            icon: row.entity_icon,
            entity_type: row.entity_type,
            sys_category_id: row.sys_category_id,
            is_active: true,
          }
        : null;

      // An entity with no category: the FULL JOIN's unmatched right side.
      if (!row.sys_category_id) {
        if (entity) orphans.push(entity);
        continue;
      }

      const group =
        groups.get(row.sys_category_id) ??
        {
          sys_category_id: row.sys_category_id,
          name: row.category_name,
          code: row.code,
          description: row.category_description,
          icon: row.category_icon,
          color: row.color,
          seq_no: row.seq_no ?? 0,
          is_default: false,
          is_active: true,
          entities: [] as any[],
        };
      if (entity) group.entities.push(entity);
      groups.set(row.sys_category_id, group);
    }

    // A group whose every entity belongs to another role is not an empty group,
    // it is somebody else's. A card reading "0 entities" tells a scoped reader
    // nothing they can act on — but an unscoped one is looking at the dictionary
    // itself, where an empty category is a category waiting to be filled.
    const result = [...groups.values()].filter((g) => unscoped || g.entities.length > 0);

    if (orphans.length > 0) {
      result.push({
        sys_category_id: null,
        name: 'Uncategorized',
        code: 'uncategorized',
        description: 'Entities not yet assigned to a category',
        icon: 'circle-help',
        color: null,
        seq_no: 9999,
        is_default: false,
        is_active: true,
        entities: orphans,
      });
    }

    // Alphabetical by name, with Uncategorized last regardless of spelling.
    result.sort((a: any, b: any) => {
      if (a.sys_category_id === null) return 1;
      if (b.sys_category_id === null) return -1;
      return String(a.name).localeCompare(String(b.name));
    });

    return { data: result, meta: { total: result.length } };
  }

  async create(dto: CreateCategoryDto) {
    if (!dto.name?.trim()) throw new BadRequestException('name is required');

    const code = (dto.code?.trim() || slugify(dto.name));
    if (!code) throw new BadRequestException('code could not be derived from name');

    const clash = await this.db.kysely
      .selectFrom('sys_category')
      .select('sys_category_id')
      .where((eb) => eb.or([eb('name', '=', dto.name.trim()), eb('code', '=', code)]))
      .executeTakeFirst();

    if (clash) throw new ConflictException(`A category with that name or code already exists`);

    if (dto.is_default) await this.clearDefault();

    const id = uuidv4();
    await this.db.kysely
      .insertInto('sys_category')
      .values({
        sys_category_id: id,
        name: dto.name.trim(),
        code,
        description: dto.description ?? null,
        icon: dto.icon ?? null,
        color: dto.color ?? null,
        seq_no: dto.seq_no ?? 0,
        is_default: dto.is_default ?? false,
        is_active: dto.is_active ?? true,
        created_at: new Date(),
        updated_at: new Date(),
      } as any)
      .execute();

    return this.findById(id);
  }

  async update(id: string, dto: UpdateCategoryDto) {
    await this.findById(id);

    if (dto.name !== undefined && !dto.name.trim()) {
      throw new BadRequestException('name cannot be empty');
    }

    if (dto.name || dto.code) {
      const clash = await this.db.kysely
        .selectFrom('sys_category')
        .select('sys_category_id')
        .where('sys_category_id', '!=', id)
        .where((eb) => {
          const conditions = [] as any[];
          if (dto.name) conditions.push(eb('name', '=', dto.name.trim()));
          if (dto.code) conditions.push(eb('code', '=', dto.code.trim()));
          return eb.or(conditions);
        })
        .executeTakeFirst();

      if (clash) throw new ConflictException('A category with that name or code already exists');
    }

    if (dto.is_default) await this.clearDefault(id);

    const patch: Record<string, unknown> = { updated_at: new Date() };
    for (const key of ['name', 'code', 'description', 'icon', 'color', 'seq_no', 'is_default', 'is_active'] as const) {
      if (dto[key] !== undefined) patch[key] = typeof dto[key] === 'string' ? (dto[key] as string).trim() : dto[key];
    }

    await this.db.kysely
      .updateTable('sys_category')
      .set(patch as any)
      .where('sys_category_id', '=', id)
      .execute();

    return this.findById(id);
  }

  /**
   * Deactivate a category. Entities pointing at it are detached rather than
   * deleted — losing an entity because its grouping was removed would be a
   * surprising amount of collateral damage.
   */
  async remove(id: string) {
    await this.findById(id);

    await this.db.kysely
      .updateTable('sys_table')
      .set({ sys_category_id: null } as any)
      .where('sys_category_id', '=', id)
      .execute();

    await this.db.kysely
      .updateTable('sys_category')
      .set({ is_active: false, updated_at: new Date() } as any)
      .where('sys_category_id', '=', id)
      .execute();

    return { message: 'Category deactivated and its entities detached' };
  }

  /** Assign a set of entities to a category (or to none, when categoryId is null). */
  async assignEntities(categoryId: string | null, tableIds: string[]) {
    if (categoryId) await this.findById(categoryId);
    if (tableIds.length === 0) return { updated: 0 };

    await this.db.kysely
      .updateTable('sys_table')
      .set({ sys_category_id: categoryId } as any)
      .where('sys_table_id', 'in', tableIds)
      .execute();

    return { updated: tableIds.length };
  }

  /** Entities belonging to one category. */
  async entitiesFor(id: string) {
    await this.findById(id);
    return this.db.kysely
      .selectFrom('sys_table')
      .select(['sys_table_id', 'table_name', 'name', 'description', 'entity_type'])
      .where('sys_category_id', '=', id)
      .where('is_active', '=', true)
      .orderBy('name', 'asc')
      .execute();
  }

  private async clearDefault(exceptId?: string) {
    let query = this.db.kysely.updateTable('sys_category').set({ is_default: false } as any);
    if (exceptId) query = query.where('sys_category_id', '!=', exceptId);
    await query.execute();
  }
}
