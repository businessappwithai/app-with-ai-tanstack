/**
 * System Configuration Service
 *
 * Reads configuration from sys_system with a fallback chain:
 *   DB row (active + non-empty) -> process.env -> hardcoded default.
 *
 * The in-memory cache is loaded on startup and refreshed on admin writes,
 * so a read never hits the database during normal request handling.
 *
 * Generated: {{now}}
 */

import { Injectable, OnModuleInit, Inject } from '@nestjs/common';
import { Kysely } from 'kysely';
import { KYSELY_CONNECTION } from '../../../database/database.constants';

interface CachedConfig {
  value: string;
  dataType: string;
  isActive: boolean;
}

@Injectable()
export class SystemConfigService implements OnModuleInit {
  private cache = new Map<string, CachedConfig>();

  // KYSELY_CONNECTION is the token DatabaseModule actually provides; nothing in
  // the tree has ever provided 'DATABASE_CONNECTION', so injecting that name
  // failed Nest's dependency resolution at boot and the application did not
  // start at all.
  constructor(@Inject(KYSELY_CONNECTION) private readonly db: Kysely<any>) {}

  async onModuleInit(): Promise<void> {
    await this.refresh();
  }

  async refresh(): Promise<void> {
    const rows = await this.db
      .selectFrom('sys_system')
      .select(['config_key', 'config_value', 'data_type', 'is_active'])
      .execute();

    this.cache.clear();
    for (const row of rows) {
      this.cache.set(row.config_key as string, {
        value: (row.config_value ?? '') as string,
        dataType: (row.data_type ?? 'string') as string,
        isActive: row.is_active as boolean,
      });
    }
  }

  get(key: string, fallback?: string): string {
    const cached = this.cache.get(key);
    if (cached?.isActive && cached.value !== '') {
      return cached.value;
    }
    return process.env[key] ?? fallback ?? '';
  }

  getNumber(key: string, fallback: number): number {
    const raw = this.get(key, String(fallback));
    const parsed = Number(raw);
    return Number.isNaN(parsed) ? fallback : parsed;
  }

  getBoolean(key: string, fallback: boolean): boolean {
    const raw = this.get(key, String(fallback));
    return raw === 'true' || raw === '1';
  }

  getAppDescription(): string {
    return this.get('APP_DESCRIPTION', 'A business application generated by APPWITHAI.');
  }

  getAppName(): string {
    return this.get('APP_NAME', '{{project.name}}');
  }

  async list(): Promise<any[]> {
    return this.db
      .selectFrom('sys_system')
      .selectAll()
      .orderBy('category')
      .orderBy('config_key')
      .execute();
  }

  async update(
    id: string,
    data: { config_value?: string; is_active?: boolean; description?: string },
    userId?: string
  ): Promise<any> {
    const result = await this.db
      .updateTable('sys_system')
      .set({
        ...data,
        updated_by: userId,
        updated_at: new Date().toISOString(),
      })
      .where('sys_system_id', '=', id)
      .returningAll()
      .executeTakeFirst();

    await this.refresh();
    return result;
  }

  async create(
    data: {
      config_key: string;
      config_value?: string;
      data_type?: string;
      category?: string;
      description?: string;
      is_sensitive?: boolean;
    },
    userId?: string
  ): Promise<any> {
    const result = await this.db
      .insertInto('sys_system')
      .values({
        ...data,
        is_active: true,
        created_by: userId,
        updated_by: userId,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
      })
      .returningAll()
      .executeTakeFirst();

    await this.refresh();
    return result;
  }

  async remove(id: string): Promise<void> {
    await this.db
      .deleteFrom('sys_system')
      .where('sys_system_id', '=', id)
      .execute();

    await this.refresh();
  }
}
