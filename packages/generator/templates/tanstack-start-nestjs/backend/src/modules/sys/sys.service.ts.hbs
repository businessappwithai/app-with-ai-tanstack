  async getFormFields(tableName: string, includeHidden = false) {
    const cacheKey = `form_fields:${tableName}:${includeHidden}`;
    return this.getCached(cacheKey, async () => {
      const table = await this.findTableByName(tableName);

      let query = this.db.kysely
        .selectFrom('sys_field')
        .innerJoin('sys_column', 'sys_column.sys_column_id', 'sys_field.sys_column_id')
        .leftJoin('sys_reference', 'sys_reference.sys_reference_id', 'sys_column.sys_reference_id' as any)
        .leftJoin('sys_ref_table', 'sys_ref_table.sys_reference_id', 'sys_column.sys_reference_id' as any)
        .leftJoin('sys_table as ref_table', 'ref_table.sys_table_id', 'sys_ref_table.sys_table_id')
        .leftJoin('sys_column as key_column', 'key_column.sys_column_id', 'sys_ref_table.key_column_id')
        .leftJoin('sys_column as display_column', 'display_column.sys_column_id', 'sys_ref_table.display_column_id')
        .leftJoin('sys_field_group', 'sys_field_group.sys_field_group_id', 'sys_field.sys_field_group_id' as any)
        .select([
          'sys_field.sys_field_id',
          'sys_field.name',
          'sys_field.seq_no',
          'sys_field.is_displayed',
          'sys_field.is_displayed_grid',
          'sys_field.is_read_only',
          'sys_field.sys_field_group_id as field_group_id',
          'sys_column.column_name',
          'sys_column.name as display_name',
          'sys_column.is_mandatory',
          'sys_column.field_length',
          'sys_reference.name as reference_name',
          'ref_table.table_name as ref_table_name',
          'key_column.column_name as ref_key_column',
          'display_column.column_name as ref_display_column',
          'sys_field_group.name as group_name',
          'sys_field_group.columns as group_columns',
          'sys_field_group.description as group_description',
          'sys_field.help',
        ])
        .where('sys_column.sys_table_id', '=', table.sys_table_id)
        .where('sys_field.is_active', '=', true);

      if (!includeHidden) {
        query = query.where('sys_field.is_displayed', '=', true);
      }

      return query.orderBy('sys_field.seq_no').execute();
    });
  }

  async getGridFields(tableName: string, includeHidden = false) {
    const cacheKey = `grid_fields:${tableName}:${includeHidden}`;
    return this.getCached(cacheKey, async () => {
      const table = await this.findTableByName(tableName);

      let query = this.db.kysely
        .selectFrom('sys_field')
        .innerJoin('sys_column', 'sys_column.sys_column_id', 'sys_field.sys_column_id')
        .leftJoin('sys_reference', 'sys_reference.sys_reference_id', 'sys_column.sys_reference_id' as any)
        .leftJoin('sys_ref_table', 'sys_ref_table.sys_reference_id', 'sys_column.sys_reference_id' as any)
        .leftJoin('sys_table as ref_table', 'ref_table.sys_table_id', 'sys_ref_table.sys_table_id')
        .leftJoin('sys_column as key_column', 'key_column.sys_column_id', 'sys_ref_table.key_column_id')
        .leftJoin('sys_column as display_column', 'display_column.sys_column_id', 'sys_ref_table.display_column_id')
        .select([
          'sys_field.sys_field_id',
          'sys_field.name',
          'sys_field.seq_no_grid',
          'sys_field.is_displayed_grid',
          'sys_field.is_read_only',
          'sys_column.column_name',
          'sys_column.name as display_name',
          'sys_column.is_mandatory',
          'sys_reference.name as reference_name',
          'ref_table.table_name as ref_table_name',
          'key_column.column_name as ref_key_column',
          'display_column.column_name as ref_display_column',
        ])
        .where('sys_column.sys_table_id', '=', table.sys_table_id)
        .where('sys_field.is_active', '=', true);

      if (!includeHidden) {
        query = query.where('sys_field.is_displayed_grid', '=', true);
      }

      return query.orderBy('sys_field.seq_no_grid').execute();
    });
  }

  async getWindowHelp(tableName: string) {
    const table = await this.db.kysely
      .selectFrom('sys_table')
      .select(['sys_table_id', 'sys_window_id'])
      .where('table_name', '=', tableName)
      .where('is_active', '=', true)
      .executeTakeFirst();

    // The Application Dictionary windows — Business Rules, Workflow Designer,
    // Audit Log and the rest — describe how the application is built rather
    // than an entity, so they have no sys_table row to look up. Fall back to
    // the window's own name, which is what those screens pass, so they can
    // carry help like every other window instead of being the only screens in
    // the application that cannot explain themselves. A route (`/admin/roles`,
    // an administrative window's description) is accepted too, and an
    // administrative window wins a tie: a model may declare an entity named
    // like one, and the seed then names the administrative window
    // "Role Management", so the plain name would find the model's window.
    const windowId =
      table?.sys_window_id ??
      (
        await this.db.kysely
          .selectFrom('sys_window')
          .select(['sys_window_id'])
          .where((eb) => eb.or([eb('name', '=', tableName), eb('description', '=', tableName)]))
          .where('is_active', '=', true)
          .orderBy(sql`entity_type = 'S'`, 'desc')
          .executeTakeFirst()
      )?.sys_window_id;

    if (!windowId) return null;

    const [window, tabs, fields] = await Promise.all([
      this.db.kysely
        .selectFrom('sys_window')
        .select(['sys_window_id', 'name', 'description', 'help'])
        .where('sys_window_id', '=', windowId)
        .executeTakeFirst(),
      this.db.kysely
        .selectFrom('sys_tab')
        .select(['sys_tab_id', 'name', 'description', 'help', 'seq_no', 'tab_level'])
        .where('sys_window_id', '=', windowId)
        .where('is_active', '=', true)
        .orderBy('seq_no')
        .execute(),
      // Field help completes the picture the window and tab text only sketches:
      // which columns are mandatory, unique, or lookups into another entity.
      this.db.kysely
        .selectFrom('sys_field')
        .innerJoin('sys_tab', 'sys_tab.sys_tab_id', 'sys_field.sys_tab_id')
        .innerJoin('sys_column', 'sys_column.sys_column_id', 'sys_field.sys_column_id')
        .select([
          'sys_field.sys_field_id',
          'sys_field.sys_tab_id',
          'sys_field.name',
          'sys_field.help',
          'sys_field.seq_no',
          'sys_column.column_name',
          'sys_column.is_mandatory',
        ])
        .where('sys_tab.sys_window_id', '=', windowId)
        .where('sys_field.is_active', '=', true)
        .where('sys_field.is_displayed', '=', true)
        .where('sys_field.help', 'is not', null)
        .orderBy('sys_field.seq_no')
        .execute(),
    ]);

    return { window, tabs, fields };
  }

  async findAllSysUsers() {
    const rows = await this.db.kysely
      .selectFrom('sys_user as u')
      .leftJoin('sys_user_roles as ur', (join) =>
        join.onRef('ur.sys_user_id', '=', 'u.sys_user_id').on('ur.is_active', '=', true),
      )
      .leftJoin('sys_role as r', 'r.sys_role_id', 'ur.sys_role_id')
      .select([
        'u.sys_user_id',
        'u.name',
        'u.email',
        'u.is_active',
        'u.created_at',
        'r.name as role_name',
      ])
      .orderBy('u.name')
      .execute();

    const map = new Map<string, any>();
    for (const row of rows) {
      if (!map.has(row.sys_user_id)) {
        map.set(row.sys_user_id, {
          sys_user_id: row.sys_user_id,
          name: row.name,
          email: row.email,
          is_active: row.is_active,
          created_at: row.created_at,
          roles: [],
        });
      }
      if (row.role_name) map.get(row.sys_user_id).roles.push(row.role_name);
    }

    return { data: Array.from(map.values()) };
  }

  /**
   * Create a user account.
   *
   * There is no self-service sign-up: an administrator creates accounts here.
   * That means this has to do everything the bootstrap does for the first admin
   * — a Better Auth identity so the person can sign in, a `sys_user` row so the
   * dictionary and audit trail have somebody to attribute work to, the link
   * between the two, and a role.
   *
   * Better Auth owns the password. Rather than reimplement its hashing, this
   * calls its server-side sign-up directly — the public HTTP sign-up route is
   * blocked in main.ts, which closes the door to the outside without closing
   * this one, so there is exactly one place a credential is ever written.
   */
  async createSysUser(input: {
    name: string;
    email: string;
    password: string;
    roleName?: string;
  }) {
    const email = input.email.trim().toLowerCase();
    const name = input.name.trim();

    if (!email || !name) throw new ConflictException('A name and an email address are required');
    if ((input.password ?? '').length < 8) {
      throw new ConflictException('The password must be at least 8 characters');
    }

    const existing = await this.db.kysely
      .selectFrom('sys_user')
      .select('sys_user_id')
      .where('email', '=', email)
      .executeTakeFirst();
    if (existing) throw new ConflictException(`${email} already has an account`);

    // `auth` is the getter, not the instance — it throws if initAuth has not run.
    const { getAuth } = await import('../../lib/better-auth');
    try {
      await getAuth().api.signUpEmail({ body: { email, password: input.password, name } });
    } catch (error: any) {
      // Better Auth refuses duplicates itself; anything else is worth showing.
      throw new ConflictException(error?.message ?? 'Could not create the sign-in account');
    }

    const sysUserId = randomUUID();
    await this.db.kysely
      .insertInto('sys_user')
      .values({
        sys_user_id: sysUserId,
        name,
        email,
        password_hash: 'managed-by-better-auth',
        is_system_user: false,
        is_active: true,
        created_by: 'admin',
        updated_by: 'admin',
      } as any)
      .execute();

    await this.db.kysely
      .updateTable('user' as any)
      .set({ sysUserId } as any)
      .where('email' as any, '=', email)
      .execute();

    const role = await this.db.kysely
      .selectFrom('sys_role')
      .select(['sys_role_id'])
      .where('name', '=', input.roleName ?? 'User')
      .executeTakeFirst();

    if (role) {
      await this.db.kysely
        .insertInto('sys_user_roles')
        .values({
          sys_user_roles_id: randomUUID(),
          sys_user_id: sysUserId,
          sys_role_id: role.sys_role_id,
          entity_type: 'S',
          is_active: true,
          created_by: 'admin',
          updated_by: 'admin',
        } as any)
        .execute();
    }

    return { data: { sys_user_id: sysUserId, name, email, is_active: true } };
  }

  /**
   * Create a role. Administrators only (the controller's `@Roles('admin')`).
   *
   * A new role starts active and with no access of its own: what it may read
   * or change is granted afterwards, and a role nobody has granted anything
   * is a role that sees nothing — the safe default for a freshly made one.
   */
  async createSysRole(input: { name: string; description?: string; isMasterRole?: boolean }) {
    const name = (input.name ?? '').trim();
    if (!name) throw new ConflictException('A role needs a name');
    if (name.length > 100) throw new ConflictException('A role name is at most 100 characters');

    const existing = await this.db.kysely
      .selectFrom('sys_role')
      .select('sys_role_id')
      .where(sql`lower(name)`, '=', name.toLowerCase())
      .executeTakeFirst();
    if (existing) throw new ConflictException(`A role named "${name}" already exists`);

    const sysRoleId = randomUUID();
    const isMasterRole = input.isMasterRole === true;
    const description = input.description?.trim() || null;
    await this.db.kysely
      .insertInto('sys_role')
      .values({
        sys_role_id: sysRoleId,
        name,
        description,
        user_level: isMasterRole ? 'S' : 'C',
        is_master_role: isMasterRole,
        is_active: true,
        entity_type: 'D',
        created_by: 'admin',
        updated_by: 'admin',
      } as any)
      .execute();

    return {
      data: {
        sys_role_id: sysRoleId,
        name,
        description,
        is_master_role: isMasterRole,
        is_active: true,
      },
    };
  }

  async findAllSysRoles() {
    const roles = await this.db.kysely
      .selectFrom('sys_role')
      .select([
        'sys_role_id',
        'name',
        'description',
        'is_master_role',
        'is_active',
        'created_at',
      ])
      .where('is_active', '=', true)
      .orderBy('name')
      .execute();

    return { data: roles };
  }

  /** The two roles every generated application has, which the platform itself relies on. */
  private static readonly BUILT_IN_ROLES = new Set(['administrator', 'user']);

  /** Active accounts holding a role that makes them an administrator. */
  private administrators() {
    return this.db.kysely
      .selectFrom('sys_user as u')
      .innerJoin('sys_user_roles as ur', 'ur.sys_user_id', 'u.sys_user_id')
      .innerJoin('sys_role as r', 'r.sys_role_id', 'ur.sys_role_id')
      .select('u.sys_user_id')
      .distinct()
      .where('u.is_active', '=', true)
      .where('ur.is_active', '=', true)
      .where((eb) => eb.or([eb('r.is_master_role', '=', true), eb(sql`lower(r.name)`, '=', 'administrator')]));
  }

  /**
   * Tell every instance that an account's access changed, so its cached
   * answers go now. Role and grant tables announce themselves by trigger;
   * `sys_user` has none, so activating or removing an account says it here.
   */
  private async announceAccessChanged(): Promise<void> {
    await sql`select pg_notify('access_changed', 'sys_user')`.execute(this.db.kysely);
  }

  /** Refuse a change that would leave no active administrator at all. */
  private async keepAnAdministrator(id: string): Promise<void> {
    const admins = (await this.administrators().execute()).map((r) => r.sys_user_id);
    if (admins.includes(id) && admins.length === 1) {
      throw new ConflictException('This is the last administrator; give another account the role first');
    }
  }

  /**
   * Change an account. Every field is optional; what is sent is changed.
   *
   * - `email` changes the sign-in address too, so the person signs in with the
   *   new one from then on.
   * - `isActive: false` ends every session the account has, and SessionAuthGuard
   *   refuses an inactive account — deactivating is how to stop somebody now.
   * - `roleNames` replaces the account's roles. Better Auth's own `role` follows
   *   it (`admin` while Administrator is held), as the seed sets it.
   * - `password` sets a new one, hashed by Better Auth's own `hashPassword`.
   *
   * An administrator cannot deactivate themselves or take away the last
   * administrator's role: either would leave nobody able to undo it.
   */
  async updateSysUser(
    id: string,
    input: {
      name?: string;
      email?: string;
      password?: string;
      isActive?: boolean;
      roleNames?: string[];
    },
    callerSysUserId?: string,
  ) {
    const current = await this.db.kysely
      .selectFrom('sys_user')
      .select(['sys_user_id', 'name', 'email', 'is_active'])
      .where('sys_user_id', '=', id)
      .executeTakeFirst();
    if (!current) throw new NotFoundException('No such user');

    const changes: Record<string, any> = {};
    if (input.name !== undefined) {
      const name = input.name.trim();
      if (!name) throw new BadRequestException('A name is required');
      changes.name = name;
    }
    if (input.email !== undefined) {
      const email = input.email.trim().toLowerCase();
      if (!email) throw new BadRequestException('An email address is required');
      if (email !== current.email) {
        const taken = await this.db.kysely
          .selectFrom('sys_user')
          .select('sys_user_id')
          .where('email', '=', email)
          .where('sys_user_id', '!=', id)
          .executeTakeFirst();
        if (taken) throw new ConflictException(`${email} already has an account`);
        changes.email = email;
      }
    }
    if (input.password !== undefined && input.password.length < 8) {
      throw new BadRequestException('The password must be at least 8 characters');
    }

    let roleIds: string[] | undefined;
    let grantsAdmin: boolean | undefined;
    if (input.roleNames !== undefined) {
      const wanted = [...new Set(input.roleNames.map((n) => n.trim()).filter(Boolean))];
      const roles = wanted.length
        ? await this.db.kysely
            .selectFrom('sys_role')
            .select(['sys_role_id', 'name', 'is_master_role'])
            .where('is_active', '=', true)
            .where(sql`lower(name)`, 'in', wanted.map((n) => n.toLowerCase()))
            .execute()
        : [];
      const missing = wanted.filter((n) => !roles.some((r) => r.name.toLowerCase() === n.toLowerCase()));
      if (missing.length) throw new BadRequestException(`No such role: ${missing.join(', ')}`);
      roleIds = roles.map((r) => r.sys_role_id);
      grantsAdmin = roles.some((r) => r.is_master_role || r.name.toLowerCase() === 'administrator');
    }

    const deactivating = input.isActive === false && current.is_active;
    const losingAdmin = grantsAdmin === false;
    if ((deactivating || losingAdmin) && id === callerSysUserId) {
      throw new ConflictException(
        deactivating
          ? 'You cannot deactivate your own account'
          : 'You cannot remove the administrator role from your own account',
      );
    }
    if (deactivating || losingAdmin) await this.keepAnAdministrator(id);

    await this.db.kysely.transaction().execute(async (trx) => {
      const authUser = await trx
        .selectFrom('user' as any)
        .select(['id' as any])
        .where((eb: any) => eb.or([eb('sysUserId', '=', id), eb('email', '=', current.email)]))
        .executeTakeFirst() as { id: string } | undefined;

      const sysChanges: Record<string, any> = { updated_by: callerSysUserId ?? 'admin', updated_at: new Date() };
      if (changes.name !== undefined) sysChanges.name = changes.name;
      if (changes.email !== undefined) sysChanges.email = changes.email;
      if (input.isActive !== undefined) sysChanges.is_active = input.isActive;
      await trx.updateTable('sys_user').set(sysChanges as any).where('sys_user_id', '=', id).execute();

      if (authUser) {
        const authChanges: Record<string, any> = { updatedAt: new Date() };
        if (changes.name !== undefined) authChanges.name = changes.name;
        if (changes.email !== undefined) authChanges.email = changes.email;
        if (grantsAdmin !== undefined) authChanges.role = grantsAdmin ? 'admin' : 'user';
        await trx.updateTable('user' as any).set(authChanges as any).where('id' as any, '=', authUser.id).execute();

        if (input.password !== undefined) {
          const { hashPassword } = await import('better-auth/crypto');
          await trx
            .updateTable('account' as any)
            .set({ password: await hashPassword(input.password), updatedAt: new Date() } as any)
            .where('userId' as any, '=', authUser.id)
            .where('providerId' as any, '=', 'credential')
            .execute();
        }
        // A new password or a deactivation ends the sessions already open.
        if (deactivating || input.password !== undefined) {
          await trx.deleteFrom('session' as any).where('userId' as any, '=', authUser.id).execute();
        }
      }

      if (roleIds !== undefined) {
        await trx.deleteFrom('sys_user_roles').where('sys_user_id', '=', id).execute();
        for (const roleId of roleIds) {
          await trx
            .insertInto('sys_user_roles')
            .values({
              sys_user_roles_id: randomUUID(),
              sys_user_id: id,
              sys_role_id: roleId,
              entity_type: 'S',
              is_active: true,
              created_by: callerSysUserId ?? 'admin',
              updated_by: callerSysUserId ?? 'admin',
            } as any)
            .execute();
        }
      }
    });

    if (input.isActive !== undefined && input.isActive !== current.is_active) await this.announceAccessChanged();

    const users = await this.findAllSysUsers();
    return { data: users.data.find((u: any) => u.sys_user_id === id) };
  }

  /**
   * Delete an account: its sign-in identity, sessions and role links go with
   * it, and the change log keeps its rows with the person set to null. Never
   * the caller's own account, and never the last administrator.
   */
  async deleteSysUser(id: string, callerSysUserId?: string) {
    if (id === callerSysUserId) throw new ConflictException('You cannot delete your own account');
    const current = await this.db.kysely
      .selectFrom('sys_user')
      .select(['sys_user_id', 'email'])
      .where('sys_user_id', '=', id)
      .executeTakeFirst();
    if (!current) throw new NotFoundException('No such user');

    await this.keepAnAdministrator(id);

    await this.db.kysely.transaction().execute(async (trx) => {
      // session and account cascade from "user".
      await trx
        .deleteFrom('user' as any)
        .where((eb: any) => eb.or([eb('sysUserId', '=', id), eb('email', '=', current.email)]))
        .execute();
      await trx.updateTable('sys_user').set({ supervisor_id: null } as any).where('supervisor_id', '=', id).execute();
      await trx.deleteFrom('sys_user').where('sys_user_id', '=', id).execute();
    });
    await this.announceAccessChanged();
    return { success: true };
  }

  /**
   * Change a role. The description and master flag can always change. The name
   * can change only on a role no access rule names: `%%rbac` rules match a
   * role by name (sys_operation_access.role_name), so renaming one the model
   * declared would silently take its access away. Administrator and User keep
   * their names for the same reason — the platform looks them up by name.
   */
  async updateSysRole(id: string, input: { name?: string; description?: string; isMasterRole?: boolean }) {
    const role = await this.db.kysely
      .selectFrom('sys_role')
      .select(['sys_role_id', 'name', 'description', 'is_master_role', 'is_active'])
      .where('sys_role_id', '=', id)
      .executeTakeFirst();
    if (!role) throw new NotFoundException('No such role');

    const changes: Record<string, any> = { updated_at: new Date() };
    if (input.name !== undefined && input.name.trim() !== role.name) {
      const name = input.name.trim();
      if (!name) throw new BadRequestException('A role needs a name');
      if (name.length > 100) throw new BadRequestException('A role name is at most 100 characters');
      if (SysService.BUILT_IN_ROLES.has(role.name.toLowerCase())) {
        throw new ConflictException(`"${role.name}" is built in and keeps its name`);
      }
      const fold = (s: string) => s.trim().toLowerCase().replace(/[\s\-_]+/g, '');
      const ruleNames = await this.db.kysely
        .selectFrom('sys_operation_access' as any)
        .select('role_name' as any)
        .distinct()
        .execute()
        .catch(() => [] as any[]);
      if ((ruleNames as any[]).some((r) => fold(r.role_name) === fold(role.name))) {
        throw new ConflictException(
          `"${role.name}" is named by the model's access rules, so renaming it would take its access away. Change the model instead.`,
        );
      }
      const taken = await this.db.kysely
        .selectFrom('sys_role')
        .select('sys_role_id')
        .where(sql`lower(name)`, '=', name.toLowerCase())
        .where('sys_role_id', '!=', id)
        .executeTakeFirst();
      if (taken) throw new ConflictException(`A role named "${name}" already exists`);
      changes.name = name;
    }
    if (input.description !== undefined) changes.description = input.description.trim() || null;
    if (input.isMasterRole !== undefined) {
      if (role.name.toLowerCase() === 'administrator' && input.isMasterRole === false) {
        throw new ConflictException('Administrator stays a master role');
      }
      changes.is_master_role = input.isMasterRole;
      changes.user_level = input.isMasterRole ? 'S' : 'C';
    }

    await this.db.kysely.updateTable('sys_role').set(changes as any).where('sys_role_id', '=', id).execute();
    const updated = await this.db.kysely
      .selectFrom('sys_role')
      .select(['sys_role_id', 'name', 'description', 'is_master_role', 'is_active', 'created_at'])
      .where('sys_role_id', '=', id)
      .executeTakeFirstOrThrow();
    return { data: updated };
  }

  /**
   * Delete a role. Administrator and User are built in and stay. A role
   * somebody still holds is refused with how many, rather than quietly taking
   * their access away — reassign them first. Its grants go with it.
   */
  async deleteSysRole(id: string) {
    const role = await this.db.kysely
      .selectFrom('sys_role')
      .select(['sys_role_id', 'name', 'role_key'])
      .where('sys_role_id', '=', id)
      .executeTakeFirst();
    if (!role) throw new NotFoundException('No such role');
    if (SysService.BUILT_IN_ROLES.has(role.name.toLowerCase())) {
      throw new ConflictException(`"${role.name}" is built in and cannot be deleted`);
    }

    const held = await this.db.kysely
      .selectFrom('sys_user_roles')
      .select(sql<number>`count(*)`.as('n'))
      .where('sys_role_id', '=', id)
      .where('is_active', '=', true)
      .executeTakeFirst();
    const holders = Number(held?.n ?? 0);
    if (holders > 0) {
      throw new ConflictException(
        `${holders} ${holders === 1 ? 'account holds' : 'accounts hold'} "${role.name}"; give them another role first`,
      );
    }

    await this.db.kysely.transaction().execute(async (trx) => {
      await trx.updateTable('sys_user').set({ default_sys_role_id: null } as any).where('default_sys_role_id', '=', id).execute();
      if (role.role_key) {
        const sharing = await trx
          .selectFrom('sys_role')
          .select('sys_role_id')
          .where('role_key', '=', role.role_key)
          .where('sys_role_id', '!=', id)
          .executeTakeFirst();
        if (!sharing) {
          await (trx as any).deleteFrom('sys_access_grant').where('role_key', '=', role.role_key).execute();
        }
      }
      // sys_user_roles and sys_access cascade from sys_role.
      await trx.deleteFrom('sys_role').where('sys_role_id', '=', id).execute();
    });
    return { success: true };
  }

  // ============================================================
  // SYS_ELEMENT
  // ============================================================

  async findAllElements(options: PaginationOptions = {}, filters: Record<string, any> = {}) {
    const { page = 1, limit = 100 } = options;
    const offset = (page - 1) * limit;

    let query = (this.db.kysely as any).selectFrom('sys_element').selectAll();
    if (Object.keys(filters).length > 0) query = this.applyFilters(query, filters);

    const [data, countRow] = await Promise.all([
      query.orderBy('name').limit(limit).offset(offset).execute(),
      query.clearSelect().select((eb: any) => eb.fn.countAll().as('count')).executeTakeFirst(),
    ]);

    return { data, meta: { total: Number(countRow?.count ?? 0), page, pageSize: limit } };
  }

  async findElementById(id: string) {
    const el = await (this.db.kysely as any).selectFrom('sys_element').selectAll()
      .where('sys_element_id', '=', id).executeTakeFirst();
    if (!el) throw new NotFoundException(`Element with ID ${id} not found`);
    return el;
  }

  async createElement(data: Record<string, unknown>) {
    const row = await (this.db.kysely as any).insertInto('sys_element')
      .values({ ...data, created_at: new Date(), updated_at: new Date() })
      .returningAll()
      .executeTakeFirstOrThrow();
    return row;
  }

  async updateElement(id: string, data: Record<string, unknown>) {
    const row = await (this.db.kysely as any).updateTable('sys_element')
      .set({ ...data, updated_at: new Date() })
      .where('sys_element_id', '=', id)
      .returningAll()
      .executeTakeFirst();
    if (!row) throw new NotFoundException(`Element with ID ${id} not found`);
    return row;
  }

  async deleteElement(id: string) {
    await (this.db.kysely as any).deleteFrom('sys_element')
      .where('sys_element_id', '=', id)
      .execute();
  }

  /**
   * Empty every business table, and nothing else.
   *
   * A generated application arrives with seeded rows so that it can be looked
   * at, and whoever has finished looking wants their own data in it — which
   * otherwise meant deleting every record by hand, entity by entity, or
   * re-running the whole setup and losing everything else they had done.
   *
   * **Business tables only.** The dictionary, the roles, the users, the rules
   * and the workflow definitions are what the application *is*, not what it
   * holds; emptying those leaves a running application with no screens.
   *
   * One `TRUNCATE` naming every `bus_` table at once, so the foreign keys
   * between them need no ordering — and deliberately no `CASCADE`, which would
   * reach the audit trail. A purge that erased the record of itself would be
   * the wrong shape entirely.
   *
   * Administrator-only, and not by a decorator: `DictionaryWriteGuard` already
   * refuses every non-GET on this controller from anyone else.
   */
  async purgeBusinessData(): Promise<{ deleted: number; tables: number }> {
    const tables = [{{#each entities}}'{{tableName}}'{{#unless @last}}, {{/unless}}{{/each}}];
    if (tables.length === 0) return { deleted: 0, tables: 0 };

    let deleted = 0;
    for (const table of tables) {
      const row = await sql<{ count: string }>`
        SELECT COUNT(*)::int AS count FROM ${sql.id(table)}
      `.execute(this.db.kysely as any);
      deleted += Number(row.rows[0]?.count ?? 0);
    }

    await sql`
      TRUNCATE TABLE ${sql.join(tables.map((table) => sql.id(table)), sql`, `)}
    `.execute(this.db.kysely as any);

    return { deleted, tables: tables.length };
  }

  // ============================================================================
  // Report Design methods
  // ============================================================================

  async findAllReportDesigns() {
    const rows = await this.db.kysely
      .selectFrom('sys_report_designs')
      .selectAll()
      .orderBy('table_name', 'asc')
      .execute();
    return rows;
  }

  async findReportDesignByTable(tableName: string) {
    const row = await this.db.kysely
      .selectFrom('sys_report_designs')
      .selectAll()
      .where('table_name', '=', tableName)
      .executeTakeFirst();
    return row ?? null;
  }

  async upsertReportDesign(data: { table_name: string; name?: string; layout?: object }) {
    const existing = await this.findReportDesignByTable(data.table_name);
    if (existing) {
      const updated = await this.db.kysely
        .updateTable('sys_report_designs')
        .set({
          name: data.name ?? existing.name,
          layout: data.layout !== undefined ? JSON.stringify(data.layout) : existing.layout,
          updated_at: new Date(),
        })
        .where('table_name', '=', data.table_name)
        .returningAll()
        .executeTakeFirst();
      return updated;
    }
    const created = await this.db.kysely
      .insertInto('sys_report_designs')
      .values({
        table_name: data.table_name,
        name: data.name ?? 'Default Report',
        layout: data.layout !== undefined ? JSON.stringify(data.layout) : null,
      })
      .returningAll()
      .executeTakeFirst();
    return created;
  }

  async deleteReportDesign(tableName: string) {
    await this.db.kysely
      .deleteFrom('sys_report_designs')
      .where('table_name', '=', tableName)
      .execute();
    return { success: true };
  }

  // ============================================================================
  // Access Grants (sys_access_grant) — role × entity × operation matrix
  // ============================================================================

  async findAllAccessGrants(opts: { roleId?: string; tableName?: string } = {}) {
    let query = (this.db.kysely as any)
      .selectFrom('sys_access_grant as g')
      .leftJoin('sys_role as r', 'r.role_key', 'g.role_key')
      .select([
        'g.sys_access_grant_id',
        'g.kind',
        'g.table_name',
        'g.action',
        'g.status_field',
        'g.from_state',
        'g.to_state',
        'g.role_name',
        'g.role_key',
        'g.is_active',
        'r.sys_role_id',
        'r.name as role_display_name',
        'r.is_master_role',
      ])
      .where('g.is_active', '=', true)
      .orderBy('g.table_name', 'asc')
      .orderBy('g.role_name', 'asc');

    if (opts.roleId) {
      query = query.where('r.sys_role_id', '=', opts.roleId);
    }
    if (opts.tableName) {
      query = query.where('g.table_name', '=', opts.tableName);
    }

    const grants = await query.execute();
    return { data: grants };
  }

  async getAccessGrantsSummary() {
    const [roleCount, grantCount] = await Promise.all([
      (this.db.kysely as any)
        .selectFrom('sys_role')
        .select((eb: any) => eb.fn.countAll().as('count'))
        .where('is_active', '=', true)
        .executeTakeFirst(),
      (this.db.kysely as any)
        .selectFrom('sys_access_grant')
        .select((eb: any) => eb.fn.countAll().as('count'))
        .where('is_active', '=', true)
        .where('kind', '=', 'op')
        .executeTakeFirst(),
    ]);
    return {
      roles: Number(roleCount?.count ?? 0),
      grants: Number(grantCount?.count ?? 0),
    };
  }

  async createAccessGrant(data: {
    tableName: string;
    action: string;
    roleName: string;
    kind?: string;
    statusField?: string;
    fromState?: string;
    toState?: string;
  }) {
    const { v4: uuidv4 } = await import('uuid');
    const row = {
      sys_access_grant_id: uuidv4(),
      kind: (data.kind ?? 'op') as any,
      table_name: data.tableName,
      action: data.action,
      role_name: data.roleName,
      status_field: data.statusField ?? '',
      from_state: data.fromState ?? '',
      to_state: data.toState ?? '',
      entity_type: 'D',
      is_active: true,
      created_by: 'admin',
      updated_by: 'admin',
      created_at: new Date(),
      updated_at: new Date(),
    };
    await (this.db.kysely as any)
      .insertInto('sys_access_grant')
      .values(row)
      .onConflict((oc: any) => oc.doNothing())
      .execute();
    // Notify all instances to drop their capability caches
    await this.db.kysely.executeQuery({ sql: "select pg_notify('access_changed', 'sys_access_grant')", parameters: [] } as any).catch(() => {});
    return { success: true, sys_access_grant_id: row.sys_access_grant_id };
  }

  async deleteAccessGrant(id: string) {
    await (this.db.kysely as any)
      .deleteFrom('sys_access_grant')
      .where('sys_access_grant_id', '=', id)
      .execute();
    await this.db.kysely.executeQuery({ sql: "select pg_notify('access_changed', 'sys_access_grant')", parameters: [] } as any).catch(() => {});
    return { success: true };
  }
}

