        .where('sys_field_group.is_active', '=', true)
        .where('sys_field_group.sys_tab_id', '=', tab.sys_tab_id)
        .orderBy('sys_field_group.seq_no')
        .orderBy('sys_field_group.name')
        .execute();

      return { data: groups, meta: { total: groups.length } };
