/**
 * Business Rules Engine Service — GoRules (zen-engine)
 *
 * Evaluates business rules using the GoRules zen-engine and
 * JSON Decision Model (JDM) files stored in ./jdm/.
 *
 * Each entity type maps to a dedicated JDM file:
 {{#each entities}}
 *   {{tableName}}  → jdm/{{tableName}}.jdm.json
 {{/each}}
 *
 * Decision tables use hitPolicy "collect" so all matching rows are
 * returned, enabling multiple validation errors in a single call.
 *
 * NOTE: zen-engine silently drops any rule row that does not set a value for
 * every output column the table declares. When adding an output column to a
 * decision table, give every existing row an explicit "''" for it, or the whole
 * table stops matching.
 *
 * Generated: {{now}}
 * Project: {{project.name}}
 */

import { Injectable, Logger, OnModuleDestroy } from '@nestjs/common';
import { ZenEngine } from '@gorules/zen-engine';
import { readFileSync } from 'fs';
import { join } from 'path';

export interface RuleAction {
  type: 'validate' | 'notify' | 'prevent' | 'transform' | 'cascade-update' | 'cascade-delete' | 'cascade-create' | 'trigger-workflow';
  config: Record<string, unknown>;
}

export interface RuleEvaluationResult {
  ruleId: string;
  ruleName: string;
  matched: boolean;
  actions: RuleAction[];
  errors?: string[];
}

/**
 * Shape of each output row returned by a GoRules decision table.
 *
 * Everything past `ruleId` is action configuration: `workflowName` for
 * trigger-workflow, and `targetEntity` / `linkField` / `updateData` for the
 * cascade actions. Decision tables only need to emit the columns the action
 * they select actually uses.
 */
interface JdmViolation {
  action: string;
  message: string;
  ruleId: string;
  rule_id?: string;
  workflowName?: string;
  /** cascade-update | cascade-delete | cascade-create: table to act on */
  targetEntity?: string;
  /** cascade-update | cascade-delete: column on targetEntity holding this row's id */
  linkField?: string;
  /** cascade-update: column/value pairs to set (JSON object, or a JSON string) */
  updateData?: Record<string, unknown> | string;
  /** cascade-create: column/value pairs to insert (JSON object, or a JSON string) */
  createData?: Record<string, unknown> | string;
  /** transform: column/value pairs to apply to the row being written */
  transformData?: Record<string, unknown> | string;
}

@Injectable()
export class RulesEngine implements OnModuleDestroy {
  private readonly logger = new Logger(RulesEngine.name);

  /** Single ZenEngine instance — thread-safe, reused across requests */
  private readonly engine: ZenEngine;

  /** Maps entity type names to their JDM file names */
  private readonly jdmFiles: Record<string, string> = {
    {{#each entities}}
    {{tableName}}: '{{tableName}}.jdm.json',
    {{/each}}
  };

  constructor() {
    this.engine = new ZenEngine();
  }

  /** Release native resources when the NestJS module shuts down */
  onModuleDestroy(): void {
    this.engine.dispose();
  }

  /** Get the ZenEngine instance for external use */
  getEngine(): ZenEngine {
    return this.engine;
  }

  /**
   * Evaluate rules with provided JDM content (from database)
   */
  async evaluateRulesWithJDM(
    entityType: string,
    jdmContent: string,
    data: Record<string, unknown>,
    action: 'create' | 'update' | 'delete',
    dbRuleName?: string,
  ): Promise<RuleEvaluationResult[]> {
    this.logger.log(`Evaluating rules for ${entityType}:${action}`);

    // A %%rule drawn as a flowchart with no %%action rows is documentation: its
    // switch and expression nodes carry no `content`, which the engine rejects
    // with "missing field `content`". It decides nothing, so say nothing —
    // rather than logging an error on every write to the entity.
    if (this.isDiagramOnly(jdmContent)) {
      this.logger.debug(`Rule ${dbRuleName ?? ''} on ${entityType} is a diagram only; skipped`);
      return [];
    }

    try {
      const decision = this.engine.createDecision(Buffer.from(this.asJdmGraph(jdmContent)));
      // `_operation` carries the CRUD verb. It is deliberately not called
      // `action`: that name belongs to the record. A model with an `action`
      // column could never fire its own rules against it, because the engine
      // had already replaced the value with "create"/"update" — and a required
      // -field rule on such a column could never fire at all, since the
      // injected value made the field look present even when it was omitted.
      // Rules read the operation from `_operation`; the payload is passed
      // through untouched.
      const result = await decision.evaluate({ ...data, _operation: action });

      let violations: JdmViolation[] = [];

      if (Array.isArray(result.result)) {
        violations = result.result as JdmViolation[];
      } else if (result.result && typeof result.result === 'object') {
        violations = [result.result as JdmViolation];
      }

      return violations.map((v) => ({
        ruleId: dbRuleName || v.ruleId || v.rule_id || 'unknown',
        ruleName: dbRuleName || v.ruleId || v.rule_id || 'unknown',
        matched: true,
        actions: [{ type: this.actionType(v.action), config: this.toActionConfig(v) }],
      }));
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      this.logger.error(`Error evaluating rules for ${entityType}: ${message}`);
      return [
        {
          ruleId: 'engine-error',
          ruleName: 'Rules Engine Error',
          matched: false,
          actions: [],
          errors: [message],
        },
      ];
    }
  }

  /**
   * Evaluate all rules for a given entity type and action.
   *
   * @param entityType  The bus_ table name (e.g. 'bus_patient')
   * @param data        The entity data to validate
   * @param action      The CRUD operation being performed
   * @returns           Array of matched rule results (empty if no violations)
   */
  async evaluateRules(
    entityType: string,
    data: Record<string, unknown>,
    action: 'create' | 'update' | 'delete',
  ): Promise<RuleEvaluationResult[]> {
    this.logger.log(`Evaluating rules for ${entityType}:${action}`);

    const jdmFile = this.jdmFiles[entityType];
    if (!jdmFile) {
      this.logger.debug(`No JDM rules configured for entity: ${entityType}`);
      return [];
    }

    const jdmPath = join(__dirname, 'jdm', jdmFile);
    let content: Buffer;
    try {
      content = readFileSync(jdmPath);
    } catch {
      this.logger.warn(`JDM file not found for ${entityType}: ${jdmPath}`);
      return [];
    }

    let violations: JdmViolation[] = [];
    try {
      const decision = this.engine.createDecision(content);
      // `_operation` carries the CRUD verb. It is deliberately not called
      // `action`: that name belongs to the record. A model with an `action`
      // column could never fire its own rules against it, because the engine
      // had already replaced the value with "create"/"update" — and a required
      // -field rule on such a column could never fire at all, since the
      // injected value made the field look present even when it was omitted.
      // Rules read the operation from `_operation`; the payload is passed
      // through untouched.
      const result = await decision.evaluate({ ...data, _operation: action });

      // hitPolicy "collect" returns an array; single-match returns an object or null
      if (Array.isArray(result.result)) {
        violations = result.result as JdmViolation[];
      } else if (result.result && typeof result.result === 'object') {
        violations = [result.result as JdmViolation];
      }
    } catch (error: unknown) {
      const message = error instanceof Error ? error.message : String(error);
      this.logger.error(`Error evaluating rules for ${entityType}: ${message}`);
      return [
        {
          ruleId: 'engine-error',
          ruleName: 'Rules Engine Error',
          matched: false,
          actions: [],
          errors: [message],
        },
      ];
    }

    return violations.map((v) => ({
      ruleId: v.ruleId,
      ruleName: v.ruleId,
      matched: true,
      actions: [{ type: this.actionType(v.action), config: this.toActionConfig(v) }],
    }));
  }

  /**
   * A stored rule, as the graph the engine evaluates.
   *
   * The rule editor saves what it edits — a bare decision table, `{ inputs,
   * outputs, rules }` — while the engine needs a JDM graph with `nodes`. Every
   * rule created in the editor, and every model rule re-saved there, was
   * therefore reported as "missing field `nodes`" and refused nothing. A graph
   * is passed through untouched; a table is wrapped in one here, which also
   * mends the rows already saved that way.
   *
   * The editor writes cells as an author reads them: `"cancelled"` or `> 0`
   * under an input, and plain words under an outcome — `validation-error`, a
   * sentence of message. An input cell is a unary test against its field, so
   * a bare word is quoted to mean equality. An outcome cell is an expression,
   * where `validation-error` is a subtraction, so text is written as a string
   * literal unless it already is one or is a number, a boolean or an object.
   */
  /** True for a graph whose logic nodes carry no `content` (a drawn, inert rule). */
  private isDiagramOnly(jdmContent: string): boolean {
    try {
      const nodes = (JSON.parse(jdmContent) as { nodes?: Array<{ type?: string; content?: unknown }> })
        .nodes;
      if (!Array.isArray(nodes)) return false;
      return nodes.some(
        (node) =>
          node.type !== 'inputNode' && node.type !== 'outputNode' && node.content === undefined,
      );
    } catch {
      return false;
    }
  }

  /** A stored rule as the graph the engine runs — what every reader goes through. */
  prepare(jdmContent: string): string {
    return this.asJdmGraph(jdmContent);
  }

  /** Source the function sandbox must never be handed. */
  private static readonly FORBIDDEN_FUNCTION_SOURCE = /\b(?:import|require|fetch|eval|process|globalThis)\b/;

  /**
   * Why a graph the rule editor drew cannot run, one sentence each.
   *
   * The same checks the modelling tool's compiler makes, so a graph refused
   * there is refused here: a function with no handler, or one reaching for the
   * network, the module system or the process; a node with no content; an edge
   * to a node that is not there.
   */
  graphProblems(jdmContent: string): string[] {
    let graph: { nodes?: Array<Record<string, any>>; edges?: Array<Record<string, any>> };
    try {
      graph = JSON.parse(jdmContent);
    } catch {
      return ['the rule is not valid JSON'];
    }
    if (!graph || !Array.isArray(graph.nodes)) return [];
    const problems: string[] = [];
    const ids = new Set<string>();
    for (const node of graph.nodes) {
      const label = String(node.name ?? node.id);
      ids.add(String(node.id));
      if (node.type === 'inputNode' || node.type === 'outputNode') continue;
      if (node.content === undefined || node.content === null) {
        problems.push(`${node.type} "${label}" has no content, so the engine would reject it`);
      }
      if (node.type === 'functionNode') {
        const content = node.content;
        const source =
          typeof content === 'string'
            ? content
            : typeof content?.source === 'string'
              ? content.source
              : '';
        if (!/\bhandler\b/.test(source)) {
          problems.push(
            `functionNode "${label}" defines no handler; write export const handler = async (input) => ({ ... })`,
          );
        }
        if (RulesEngine.FORBIDDEN_FUNCTION_SOURCE.test(source)) {
          problems.push(
            `functionNode "${label}" uses import, require, fetch, eval, process or globalThis, which the sandbox does not allow`,
          );
        }
      }
    }
    for (const edge of graph.edges ?? []) {
      if (!ids.has(String(edge.sourceId)) || !ids.has(String(edge.targetId))) {
        problems.push(`edge "${String(edge.id)}" joins a node that is not in the graph`);
      }
    }
    return problems;
  }

  /**
   * Speak the runtime's vocabulary in a graph the editor drew.
   *
   * zen runs a function node only from `content: { source }`: a bare string is
   * refused, or returns {} and decides nothing. A transform row needs the one
   * `transformData` object the runtime applies — the editor's Field and Value
   * columns are for the author to read, not for the runtime.
   */
  private normalizeGraph(graph: { nodes: Array<Record<string, any>> }): unknown {
    const literal = (cell: unknown): string | null => {
      const match = String(cell ?? '')
        .trim()
        .match(/^(?:'(.*)'|"(.*)")$/s);
      return match ? (match[1] ?? match[2] ?? '') : null;
    };
    return {
      ...graph,
      nodes: graph.nodes.map((node) => {
        if (node.type === 'functionNode' && typeof node.content === 'string') {
          return { ...node, content: { source: node.content } };
        }
        const table = node.content as
          | {
              outputs?: Array<{ id: string; name?: string; field?: string }>;
              rules?: Array<Record<string, unknown>>;
            }
          | undefined;
        if (node.type !== 'decisionTableNode' || !Array.isArray(table?.rules)) return node;
        const outputs = table.outputs ?? [];
        const fieldColumn = outputs.find((c) => c.field === 'field');
        const valueColumn = outputs.find((c) => c.field === 'value');
        const actionColumn = outputs.find((c) => c.field === 'action');
        if (
          !fieldColumn ||
          !valueColumn ||
          !actionColumn ||
          outputs.some((c) => c.field === 'transformData')
        ) {
          return node;
        }
        const dataColumn = { id: 'transformData-auto', name: 'Transform Data', field: 'transformData' };
        return {
          ...node,
          content: {
            ...table,
            outputs: [...outputs, dataColumn],
            rules: table.rules.map((row) => {
              const target = literal(row[fieldColumn.id])?.trim();
              const isTransform = literal(row[actionColumn.id])?.trim() === 'transform';
              if (!isTransform || !target) return row;
              const value = literal(row[valueColumn.id]) ?? String(row[valueColumn.id] ?? '');
              const data = JSON.stringify({ [target]: value }).replace(/'/g, "\\'");
              return { ...row, [dataColumn.id]: `'${data}'` };
            }),
          },
        };
      }),
    };
  }

  private asJdmGraph(jdmContent: string): string {
    let parsed: unknown;
    try {
      parsed = JSON.parse(jdmContent);
    } catch {
      return jdmContent;
    }
    const table = parsed as {
      nodes?: unknown;
      hitPolicy?: string;
      inputs?: Array<{ id: string; name?: string; field?: string }>;
      outputs?: Array<{ id: string; name?: string; field?: string }>;
      rules?: Array<Record<string, string>>;
    };
    if (table && typeof table === 'object' && table.nodes) {
      return JSON.stringify(this.normalizeGraph(parsed as { nodes: Array<Record<string, any>> }));
    }
    if (!table || typeof table !== 'object') return jdmContent;
    if (!Array.isArray(table.inputs) || !Array.isArray(table.outputs) || !Array.isArray(table.rules)) {
      return jdmContent;
    }

    const quote = (text: string) => `'${text.replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`;
    const isLiteral = (text: string) =>
      /^'.*'$|^".*"$/.test(text) ||
      /^-?\d+(\.\d+)?$/.test(text) ||
      /^(true|false|null)$/.test(text) ||
      /^[[{]/.test(text);
    const inputCell = (raw: string) => {
      const text = (raw ?? '').trim();
      if (!text || isLiteral(text)) return text;
      return /^[A-Za-z_][\w-]*$/.test(text) ? quote(text) : text;
    };
    const outputCell = (raw: string) => {
      const text = (raw ?? '').trim();
      if (!text) return "''";
      return isLiteral(text) ? text : quote(text);
    };

    const rules = table.rules.map((row) => {
      const next: Record<string, string> = { _id: row._id ?? '' };
      for (const column of table.inputs ?? []) next[column.id] = inputCell(row[column.id] ?? '');
      for (const column of table.outputs ?? []) next[column.id] = outputCell(row[column.id] ?? '');
      return next;
    });

    return JSON.stringify({
      nodes: [
        { id: 'input', type: 'inputNode', name: 'Input', position: { x: 0, y: 0 } },
        {
          id: 'table',
          type: 'decisionTableNode',
          name: 'Decision table',
          position: { x: 300, y: 0 },
          content: {
            hitPolicy: table.hitPolicy === 'first' ? 'first' : 'collect',
            inputs: table.inputs.map((c) => ({ id: c.id, name: c.name ?? c.field ?? c.id, field: c.field ?? '' })),
            outputs: table.outputs.map((c) => ({ id: c.id, name: c.name ?? c.field ?? c.id, field: c.field || c.name || c.id })),
            rules,
          },
        },
        { id: 'output', type: 'outputNode', name: 'Output', position: { x: 600, y: 0 } },
      ],
      edges: [
        { id: 'e1', sourceId: 'input', targetId: 'table', type: 'edge' },
        { id: 'e2', sourceId: 'table', targetId: 'output', type: 'edge' },
      ],
    });
  }

  /**
   * A row's action, in this engine's vocabulary.
   *
   * The rule editor offers EML's words — the ones a model is written in and
   * the modelling tool's editor writes — and EML says `validation-error` where
   * this engine says `prevent`. The generator translates when it compiles a
   * model's rules, but a rule written in this application's own editor goes
   * straight into `sys_rule_definitions`, so an untranslated row matched and
   * was then dropped by `validate()`: the rule refused nothing. Accept both.
   */
  private actionType(raw: unknown): RuleAction['type'] {
    const type = typeof raw === 'string' ? raw.trim() : '';
    return (type === 'validation-error' ? 'prevent' : type) as RuleAction['type'];
  }

  /**
   * Carry the whole decision-table output row into the action config.
   *
   * Only `message` and `workflowName` used to survive this step, which left the
   * cascade actions permanently unconfigurable — they read `targetEntity`,
   * `linkField` and `updateData`, and those were always undefined no matter what
   * the decision table emitted.
   */
  private toActionConfig(v: JdmViolation): Record<string, unknown> {
    return {
      message: v.message,
      workflowName: v.workflowName,
      targetEntity: v.targetEntity,
      linkField: v.linkField,
      updateData: this.asObject(v.updateData),
      createData: this.asObject(v.createData),
      transformData: this.asObject(v.transformData),
    };
  }

  /** Decision tables can emit an object or a JSON string; accept either. */
  private asObject(value: Record<string, unknown> | string | undefined): Record<string, unknown> | undefined {
    if (!value) return undefined;
    if (typeof value !== 'string') return value;
    try {
      const parsed = JSON.parse(value);
      return parsed && typeof parsed === 'object' ? (parsed as Record<string, unknown>) : undefined;
    } catch {
      this.logger.warn(`Rule action data is not valid JSON: ${value}`);
      return undefined;
    }
  }
}
