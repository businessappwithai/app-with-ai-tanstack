/**
 * The assistant's sub-paths.
 *
 * The runtime itself lives in src/lib/copilot-runtime.ts, and the address the
 * client actually posts to — /api/copilotkit, with nothing after it — is served
 * by ../$.ts, because a splat route cannot match an empty tail. This file
 * exists for the sub-paths, which the router matches here first by virtue of
 * having more segments; it hands them to the same runtime.
 *
 * Generated: {{now}}
 * Project: {{project.name}}
 */

import { createAPIFileRoute } from '@tanstack/start/api'
// Relative rather than the `@/` alias — see the note in ../$.ts.
import { handleCopilotRequest } from '../../../lib/copilot-runtime'

const methods = {
  GET: async ({ request }: { request: Request }) => handleCopilotRequest(request),
  POST: async ({ request }: { request: Request }) => handleCopilotRequest(request),
}

export const APIRoute = createAPIFileRoute('/api/copilotkit/$')(methods)

// Both names, on purpose, and each holds its own call.
//
// The router registers an API route file by its `APIRoute` export and ignores
// anything else, so a file exporting only `Route` is silently absent — and an
// absent API route answers with the HTML of a missing page rather than a 404
// anyone would recognise as a routing problem. That is why both exist.
//
// Neither may be an alias of the other. vinxi imports this file as
// `?pick=APIRoute`, and its tree-shake pass deletes every *other* exported
// declarator outright rather than inlining it — so `export const APIRoute =
// Route` left the picked module referring to a `Route` that had just been
// removed, and every /api/* request answered 500 with
// `ReferenceError: Route is not defined`. The route generator, for its part,
// requires the `Route` export to be initialised by a call expression directly
// (`expected "Route" export to be initialized by a CallExpression`), and a
// failed generate leaves no src/routeTree.gen.ts. Two calls over one shared
// `methods` object satisfy both: each export stands alone, and `methods` is
// not exported, so the pick keeps it.
export const Route = createAPIFileRoute('/api/copilotkit/$')(methods)
