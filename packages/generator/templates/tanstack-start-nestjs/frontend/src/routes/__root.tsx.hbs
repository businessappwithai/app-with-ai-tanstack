import { createRootRoute, Outlet, Link } from '@tanstack/react-router'
import { Meta, Scripts } from '@tanstack/start'
import { Providers } from '../providers'
import { THEME_BOOT_SCRIPT } from '../components/theme/theme-provider'
import { Toaster } from 'sonner'
import globalsCssUrl from '../styles/globals.css?url'

/**
 * Hoisted, and not written inline, for a Handlebars reason rather than a React
 * one: this file is a `.hbs` template, and the inline form of
 * `dangerouslySetInnerHTML` opens with a doubled brace — which Handlebars reads
 * as a mustache expression and substitutes away before the generated
 * application ever sees any JSX. Note that this comment cannot contain the
 * doubled brace either, for exactly the same reason.
 */
const themeBootHtml = { __html: THEME_BOOT_SCRIPT }

/**
 * The same pre-paint script the layout uses. The error and not-found documents
 * are whole `<html>` trees of their own, so without it a reader on a dark
 * theme meets a white page exactly when something has already gone wrong.
 */
function ThemeBootScript() {
  // biome-ignore lint/security/noDangerouslySetInnerHtml: a constant string
  // from theme-provider.tsx, and the only way to run before first paint
  return <script dangerouslySetInnerHTML={themeBootHtml} />
}

function RootErrorComponent({ error }: { error: Error }) {
  return (
    <html lang="en" suppressHydrationWarning>
      <head>
        <title>Error - {{project.name}}</title>
        <ThemeBootScript />
        <Meta />
      </head>
      <body className="font-sans antialiased">
        <div className="min-h-screen flex items-center justify-center p-4 bg-background">
          <div className="swiss-card p-8 max-w-md w-full text-center space-y-4">
            <div className="flex h-16 w-16 items-center justify-center rounded-full bg-destructive/20 mx-auto">
              <span className="text-2xl font-bold text-destructive">!</span>
            </div>
            <h2 className="font-display text-xl font-semibold text-foreground">
              Something went wrong
            </h2>
            <p className="text-sm text-muted-foreground">{error?.message || 'An unexpected error occurred'}</p>
            <button
              onClick={() => window.location.reload()}
              className="text-sm text-primary hover:underline font-medium"
            >
              Reload page
            </button>
          </div>
        </div>
        <Scripts />
      </body>
    </html>
  )
}

function RootNotFoundComponent() {
  return (
    <html lang="en" suppressHydrationWarning>
      <head>
        <title>Not Found - {{project.name}}</title>
        <ThemeBootScript />
        <Meta />
      </head>
      <body className="font-sans antialiased">
        <div className="min-h-screen flex items-center justify-center p-4 bg-background">
          <div className="swiss-card p-8 max-w-md w-full text-center space-y-4">
            <p className="font-display text-6xl font-bold text-muted-foreground/30">404</p>
            <h2 className="font-display text-xl font-semibold text-foreground">Page not found</h2>
            <p className="text-sm text-muted-foreground">
              The page you are looking for does not exist.
            </p>
            <Link to="/dashboard" className="text-sm text-primary hover:underline font-medium">
              Go to Dashboard
            </Link>
          </div>
        </div>
        <Scripts />
      </body>
    </html>
  )
}

export const Route = createRootRoute({
  head: () => ({
    meta: [
      { charSet: 'utf-8' },
      { name: 'viewport', content: 'width=device-width, initial-scale=1' },
    ],
    links: [
      { rel: 'stylesheet', href: globalsCssUrl },
      { rel: 'icon', href: '/favicon.ico' },
      // Webfonts are served from public/fonts, not a font CDN: a third-party
      // stylesheet in the critical path means the app renders wrong wherever
      // that host is unreachable — corporate proxy, air-gapped site, CI.
      { rel: 'stylesheet', href: '/fonts/fonts.css' },
    ],
  }),
  errorComponent: RootErrorComponent,
  notFoundComponent: RootNotFoundComponent,
  component: RootLayout,
})

function RootLayout() {
  return (
    // `suppressHydrationWarning` because the boot script below has already put
    // `class="dark"` and `style="color-scheme:dark"` on this element by the
    // time React hydrates, and the server had no way to know it would. The
    // alternative is not a clean tree — it is applying the theme one paint
    // late, which is a white flash on every load of a dark application.
    <html lang="en" suppressHydrationWarning>
      <head>
        <title>{{project.name}}</title>
        <meta name="description" content="{{project.description}}" />
        {/* Before the stylesheet paints anything, and before any module has
            loaded. This is the only reason the theme does not flash. */}
        <ThemeBootScript />
        <Meta />
      </head>
      <body className="font-sans antialiased">
        <Providers>
          <main className="min-h-screen bg-background">
            <Outlet />
          </main>
        </Providers>
        {/* Bottom right, not top right. The top right is the help toaster's
            now, and it is a panel that stays open — a transient message
            landing on top of it is the one collision this arrangement can
            have, so the two do not share a corner. */}
        <Toaster richColors position="bottom-right" />
        <Scripts />
      </body>
    </html>
  )
}
