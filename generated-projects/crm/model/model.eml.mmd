%% ---- Section 22: Workflow — lead conversion (saga) -------------------------
%% The one process every CRM is judged on. A qualified lead becomes an account,
%% a primary contact and an opening opportunity in one transaction, and the
%% lead is stamped converted so it stops appearing in prospecting lists.
%%
%% `trigger: rule` is load-bearing: the qualification rule in Section 4 decides
%% whether this runs at all. Step B's table is the sizing policy — grade in,
%% tier and opening amount out — and the steps after it read what it published.
%% Step G reaches back into the account step C created, using the id step C
%% bound, which is the only way a later step can touch a row created earlier in
%% the same run.
%%meta name: Lead Conversion
%%meta kind: workflow
%%workflow LeadConversion entity: Lead kind: saga trigger: rule
flowchart TD
    A([Lead qualified]) --> B{Size the account}
    B --> C[Open the account]
    C --> D[Create the primary contact]
    D --> E[Open the first opportunity]
    E --> F[Mark the lead converted]
    F --> G[Stamp the account tier]
    G --> H([Converted])

    %%step B Decision decisionTable: {"hitPolicy":"first","inputs":[{"id":"i1","name":"Score","field":"score"}],"outputs":[{"id":"o1","name":"Tier","field":"accountTier"},{"id":"o2","name":"OpeningAmount","field":"openingAmount"},{"id":"o3","name":"AccountType","field":"openingAccountType"}],"rules":[{"_id":"strategic","i1":">= 85","o1":"'strategic'","o2":"250000","o3":"'prospect'"},{"_id":"enterprise","i1":">= 70","o1":"'enterprise'","o2":"120000","o3":"'prospect'"},{"_id":"midmarket","i1":">= 40","o1":"'mid_market'","o2":"45000","o3":"'prospect'"},{"_id":"rest","i1":"","o1":"'smb'","o2":"12000","o3":"'prospect'"}]}
    %%step C CreateEntity entity: Account as: newAccountId fields: {"name":"company_name","account_type":"openingAccountType","tier":"accountTier","industry":"industry","employee_count":"employee_count","annual_revenue":"annual_revenue","status":"active","owner_id":"owner_id"}
    %%step D CreateEntity entity: Contact as: newContactId fields: {"account_id":"newAccountId","first_name":"first_name","last_name":"last_name","email":"email","phone":"phone","job_title":"job_title","lead_source":"lead_source","is_primary":true,"email_opt_out":false,"do_not_call":false,"status":"active","owner_id":"owner_id"}
    %%step E CreateEntity entity: Opportunity as: newOpportunityId fields: {"account_id":"newAccountId","contact_id":"newContactId","campaign_id":"campaign_id","name":"company_name","amount":"openingAmount","currency_code":"USD","stage":"prospecting","forecast_category":"pipeline","lead_source":"lead_source","owner_id":"owner_id"}
    %%step F UpdateEntity field: status value: converted
    %%step G UpdateEntity entity: Account targetSource: newAccountId field: tier source: accountTier

%% ---- Section 23: Workflow — quote discount approval (saga) -----------------
%% Holds an out-of-policy quote and puts a named approval task in front of a
%% human, with a review window sized by how far out of policy the discount is.
%% Section 7 decides when it runs.
%%meta name: Quote Approval Escalation
%%meta kind: workflow
%%workflow QuoteApprovalEscalation entity: Quote kind: saga trigger: rule
flowchart TD
    A([Discount above rep authority]) --> B{Set the approval level}
    B --> C[Compute the review window]
    C --> D[Raise the approval task]
    D --> E[Hold the quote for review]
    E --> F[Name the approval level on the task]
    F --> G([Awaiting approval])

    %%step B Decision decisionTable: {"hitPolicy":"first","inputs":[{"id":"i1","name":"Discount","field":"discount_percent"}],"outputs":[{"id":"o1","name":"Level","field":"approvalLevel"},{"id":"o2","name":"ReviewHours","field":"reviewHours"}],"rules":[{"_id":"vp","i1":"> 25","o1":"'vp_sales'","o2":"48"},{"_id":"manager","i1":"> 15","o1":"'sales_manager'","o2":"24"},{"_id":"rest","i1":"","o1":"'rep_authority'","o2":"8"}]}
    %%step C Formula target: reviewWindowDays source: reviewHours operation: divide operand: 24
    %%step D CreateEntity entity: Activity as: approvalTaskId fields: {"activity_type":"task","subject":"Approve quote discount","status":"planned","priority":"high","account_id":"account_id","opportunity_id":"opportunity_id","owner_id":"owner_id"}
    %%step E UpdateEntity field: status value: in_review
    %%step F UpdateEntity entity: Activity targetSource: approvalTaskId field: description source: approvalLevel

%% ---- Section 24: Workflow — critical case escalation (saga) ----------------
%% A critical case does not wait for an agent to open the queue. The tier table
%% sets the response clock, an escalation task is raised against the account,
%% the case moves to escalated, and the on-call channel is told.
%%meta name: Critical Case Escalation
%%meta kind: workflow
%%workflow CriticalCaseEscalation entity: SupportCase kind: saga trigger: rule
flowchart TD
    A([Critical case raised]) --> B{Set the escalation tier}
    B --> C[Compute the response deadline]
    C --> D[Raise the escalation task]
    D --> E[Escalate the case]
    E --> F[Name the tier on the task]
    F --> G[Notify the on-call channel]
    G --> H([Escalated])

    %%step B Decision decisionTable: {"hitPolicy":"first","inputs":[{"id":"i1","name":"Priority","field":"priority"}],"outputs":[{"id":"o1","name":"Tier","field":"escalationTier"},{"id":"o2","name":"ResponseMinutes","field":"responseMinutes"}],"rules":[{"_id":"critical","i1":"\"critical\"","o1":"'executive_bridge'","o2":"15"},{"_id":"high","i1":"\"high\"","o1":"'support_manager'","o2":"60"},{"_id":"rest","i1":"","o1":"'queue'","o2":"240"}]}
    %%step C Formula target: responseHours source: responseMinutes operation: divide operand: 60
    %%step D CreateEntity entity: Activity as: escalationTaskId fields: {"activity_type":"task","subject":"Escalated support case","status":"planned","priority":"urgent","account_id":"account_id","contact_id":"contact_id","support_case_id":"id","owner_id":"owner_id"}
    %%step E UpdateEntity field: status value: escalated
    %%step F UpdateEntity entity: Activity targetSource: escalationTaskId field: description source: escalationTier
    %% `url:` carries no space before its value on purpose: a step's properties
    %% are split at whitespace preceding the next `<key>:`, so ` https://…`
    %% would be read as a property named "https" and the step would lose its url.
    %%step G REST url:https://hooks.example.com/crm/case-escalation method: POST bodyTemplate: {"case":"{{case_number}}","tier":"{{escalationTier}}","respondWithinHours":"{{responseHours}}"}

%% ---- Section 25: Workflow — closed-won handoff (saga) ----------------------
%% The other kind of trigger. Nothing gates this one on a rule: every
%% opportunity that reaches closed_won is handed to delivery, because a deal
%% that closes and is never onboarded is the failure mode this exists to stop.
%% It runs on UPDATE, since closing is an update to an existing row.
%%meta name: Closed Won Handoff
%%meta kind: workflow
%%workflow ClosedWonHandoff entity: Opportunity kind: saga trigger: automatic operation: UPDATE
flowchart TD
    A([Opportunity closed won]) --> B{Size the engagement}
    B --> C[Compute the monthly run rate]
    C --> D[Draft the contract]
    D --> E[Book the onboarding kickoff]
    E --> F[Stamp the forecast category]
    F --> G[Name the onboarding tier on the kickoff]
    G --> H([Handed off])

    %%step B Decision decisionTable: {"hitPolicy":"first","inputs":[{"id":"i1","name":"Amount","field":"amount"}],"outputs":[{"id":"o1","name":"TermMonths","field":"termMonths"},{"id":"o2","name":"OnboardingTier","field":"onboardingTier"},{"id":"o3","name":"NoticeDays","field":"renewalNoticeDays"}],"rules":[{"_id":"strategic","i1":">= 250000","o1":"36","o2":"'white_glove'","o3":"120"},{"_id":"enterprise","i1":">= 100000","o1":"24","o2":"'guided'","o3":"90"},{"_id":"rest","i1":"","o1":"12","o2":"'self_serve'","o3":"60"}]}
    %%step C Formula target: monthlyRunRate source: amount operation: divide operand: 12
    %%step D CreateEntity entity: Contract as: newContractId fields: {"account_id":"account_id","status":"draft","term_months":"termMonths","annual_value":"amount","renewal_notice_days":"renewalNoticeDays","auto_renew":false,"owner_id":"owner_id"}
    %%step E CreateEntity entity: Activity as: kickoffActivityId fields: {"activity_type":"meeting","subject":"Customer onboarding kickoff","status":"planned","priority":"high","account_id":"account_id","contact_id":"contact_id","opportunity_id":"id","owner_id":"owner_id"}
    %%step F UpdateEntity field: forecast_category value: closed
    %%step G UpdateEntity entity: Activity targetSource: kickoffActivityId field: description source: onboardingTier

%% ---- Section 26: Workflow — renewal playbook (saga) ------------------------
%% Runs when a contract is updated into its renewal window. Step B evaluates
%% the rule declared in Section 9 rather than carrying a second copy of the
%% policy, which is the whole point of naming a rule instead of inlining a
%% table: the grade a person sees in the rules editor is the grade this process
%% acts on.
%%
%% Step C is the delete. Stale renewal tasks from the previous cycle are
%% cleared by matching Activity.contract_id against the triggering contract —
%% row targeting by foreign key, since no earlier step created those rows.
%%meta name: Renewal Playbook
%%meta kind: workflow
%%workflow RenewalPlaybook entity: Contract kind: saga trigger: automatic operation: UPDATE
flowchart TD
    A([Contract entered renewal window]) --> B{Grade the renewal}
    B --> C[Clear the stale renewal tasks]
    C --> D[Open the renewal opportunity]
    D --> E[Schedule the renewal review]
    E --> F[Flag the contract as expiring]
    F --> G[Name the grade on the renewal opportunity]
    G --> H([Renewal in flight])

    %%step B Decision rule: renewalRisk publish: renewalGrade
    %%step C DeleteEntity entity: Activity targetField: contract_id
    %%step D CreateEntity entity: Opportunity as: renewalOpportunityId fields: {"account_id":"account_id","name":"Renewal","amount":"annual_value","currency_code":"USD","stage":"qualification","forecast_category":"pipeline","expected_close_date":"end_date","owner_id":"owner_id"}
    %%step E CreateEntity entity: Activity as: renewalReviewId fields: {"activity_type":"meeting","subject":"Renewal review","status":"planned","priority":"high","account_id":"account_id","contract_id":"id","opportunity_id":"renewalOpportunityId","owner_id":"owner_id"}
    %%step F UpdateEntity field: status value: expiring
    %%step G UpdateEntity entity: Opportunity targetSource: renewalOpportunityId field: next_step source: renewalGrade
