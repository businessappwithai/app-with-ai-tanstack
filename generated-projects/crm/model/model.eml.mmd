%% ---- Section 2: Business rule — inbound lead scoring -----------------------
%% Scores a lead on firmographics and source, then grades it. The grade is what
%% routing (Section 3) and conversion (Section 22) both read, so the arithmetic
%% lives in exactly one place.
%%meta name: Lead Scoring
%%meta kind: rules
%%rule leadScoring on Lead event: beforeCreate priority: 10
flowchart TD
    A([Start: Lead Captured]) --> B{employee_count >= 1000?}
    B -->|Yes| C[Add 35 firmographic points]
    B -->|No| D{employee_count >= 100?}
    D -->|Yes| E[Add 20 firmographic points]
    D -->|No| F[Add 5 firmographic points]
    C --> G{lead_source == referral?}
    E --> G
    F --> G
    G -->|Yes| H[Add 30 source points]
    G -->|No| I{lead_source == event?}
    I -->|Yes| J[Add 20 source points]
    I -->|No| K[Add 8 source points]
    H --> L{annual_revenue > 10000000?}
    J --> L
    K --> L
    L -->|Yes| M[Add 25 revenue points]
    L -->|No| N[Add 5 revenue points]
    M --> O((Compute lead score))
    N --> O
    O --> P{score >= 70?}
    P -->|Yes| Q[Set rating hot]
    P -->|No| R{score >= 40?}
    R -->|Yes| S[Set rating warm]
    R -->|No| T[Set rating cold]
    Q --> Z([End: Lead Scored])
    S --> Z
    T --> Z

%% ---- Section 3: Business rule — lead routing -------------------------------
%% Who picks the lead up. Enterprise-sized leads never sit in the shared queue,
%% and a lead that arrived through a partner goes back to the partner desk
%% whatever its size.
%%meta name: Lead Routing
%%meta kind: rules
%%rule leadRouting on Lead event: afterCreate priority: 20
flowchart TD
    A([Start: Lead Scored]) --> B{lead_source == partner?}
    B -->|Yes| C[Route to Partner Desk]
    B -->|No| D{annual_revenue > 50000000?}
    D -->|Yes| E[Route to Strategic Accounts Team]
    D -->|No| F{employee_count >= 500?}
    F -->|Yes| G[Route to Enterprise Team]
    F -->|No| H{rating == hot?}
    H -->|Yes| I[Route to Mid Market Team]
    H -->|No| J[Route to SMB Queue]
    C --> K((Assign owner from territory))
    E --> K
    G --> K
    I --> K
    J --> K
    K --> L{owner assigned?}
    L -->|Yes| M[Notify assigned owner]
    L -->|No| N[Hold in unassigned queue]
    M --> Z([End: Lead Routed])
    N --> Z

%% ---- Section 4: Business rule — lead qualification gate --------------------
%% The gate a lead has to pass before it becomes an account. Its %%action is
%% what makes the conversion saga in Section 22 run — without it the saga would
%% either fire on every lead update or never fire at all.
%%meta name: Lead Qualification
%%meta kind: rules
%%rule leadQualification on Lead event: beforeUpdate priority: 15
flowchart TD
    A([Start: Qualification Requested]) --> B{email present?}
    B -->|No| C[Reject: Contact email required]
    B -->|Yes| D{company_name present?}
    D -->|No| E[Reject: Company name required]
    D -->|Yes| F{score >= 40?}
    F -->|No| G[Route back to nurturing]
    F -->|Yes| H{owner assigned?}
    H -->|No| I[Reject: Owner required before conversion]
    H -->|Yes| J[Set status qualified]
    C --> Z([End: Qualification Decided])
    E --> Z
    G --> Z
    I --> Z
    J --> Z

    %% A qualified lead is converted by the multi-step workflow in Section 22.
    %% The `when` is what keeps that workflow off every other lead update.
    %%action convertQualifiedLead trigger-workflow when: status == "qualified" workflow: LeadConversion message: Lead qualified — opening the account, contact and first opportunity

%% ---- Section 5: Business rule — opportunity forecasting --------------------
%% Probability and forecast category are derived, never typed in. Reps disagree
%% about what "70% likely" means; a stage does not.
%%meta name: Opportunity Forecasting
%%meta kind: rules
%%rule opportunityForecast on Opportunity event: beforeUpdate priority: 10
flowchart TD
    A([Start: Opportunity Updated]) --> B{stage == closed_won?}
    B -->|Yes| C[Set probability 100 and category closed]
    B -->|No| D{stage == closed_lost?}
    D -->|Yes| E[Set probability 0 and category omitted]
    D -->|No| F{stage == negotiation?}
    F -->|Yes| G[Set probability 80 and category commit]
    F -->|No| H{stage == proposal?}
    H -->|Yes| I[Set probability 60 and category best_case]
    H -->|No| J{stage == needs_analysis?}
    J -->|Yes| K[Set probability 40 and category pipeline]
    J -->|No| L{stage == qualification?}
    L -->|Yes| M[Set probability 20 and category pipeline]
    L -->|No| N[Set probability 10 and category pipeline]
    C --> O((Recompute account pipeline))
    E --> O
    G --> O
    I --> O
    K --> O
    M --> O
    N --> O
    O --> P{expected_close_date in the past?}
    P -->|Yes| Q[Flag as slipped]
    P -->|No| R[Keep current close date]
    Q --> Z([End: Forecast Recomputed])
    R --> Z

%% ---- Section 6: Business rule — closed-won gate ----------------------------
%% What a deal has to have before anyone is allowed to call it won. A pipeline
%% nobody can trust is usually a pipeline where this gate was never written down.
%%meta name: Closed Won Gate
%%meta kind: rules
%%rule opportunityCloseGate on Opportunity event: beforeUpdate priority: 5
flowchart TD
    A([Start: Close Requested]) --> B{stage == closed_won?}
    B -->|No| C{stage == closed_lost?}
    C -->|Yes| D{loss_reason present?}
    D -->|No| E[Reject: Loss reason required]
    D -->|Yes| F[Stamp actual close date]
    C -->|No| G[Allow: Not a closing transition]
    B -->|Yes| H{amount > 0?}
    H -->|No| I[Reject: Amount required to close won]
    H -->|Yes| J{accepted quote present?}
    J -->|No| K[Reject: An accepted quote is required]
    J -->|Yes| L{primary contact present?}
    L -->|No| M[Reject: A primary contact is required]
    L -->|Yes| N[Stamp actual close date and category closed]
    E --> Z([End: Close Decided])
    F --> Z
    G --> Z
    I --> Z
    K --> Z
    M --> Z
    N --> Z

%% ---- Section 7: Business rule — quote discount policy ----------------------
%% Discount authority by band. Anything past the rep's own authority stops the
%% quote and raises an approval; anything past the ceiling is refused outright
%% rather than sent up the chain, because no one is allowed to approve it.
%%meta name: Quote Discount Policy
%%meta kind: rules
%%rule quoteDiscountApproval on Quote event: beforeUpdate priority: 10
flowchart TD
    A([Start: Quote Priced]) --> B{discount_percent > 40?}
    B -->|Yes| C[Reject: Above the maximum discount]
    B -->|No| D{discount_percent > 25?}
    D -->|Yes| E[Require VP approval]
    D -->|No| F{discount_percent > 15?}
    F -->|Yes| G[Require sales manager approval]
    F -->|No| H{discount_percent > 0?}
    H -->|Yes| I[Auto approve within rep authority]
    H -->|No| J[No discount applied]
    E --> K((Recompute grand total))
    G --> K
    I --> K
    J --> K
    C --> Z([End: Discount Decided])
    K --> Z

    %% Out-of-policy discounts hold the quote and raise an approval task; the
    %% multi-step process that does it is Section 23.
    %%action escalateDiscount trigger-workflow when: discount_percent > 15 workflow: QuoteApprovalEscalation message: Discount above rep authority — holding the quote for approval
    %%action refuseDiscount validation-error when: discount_percent > 40 message: Discounts above 40 percent cannot be approved by anyone — reprice the quote

%% ---- Section 8: Business rule — support case triage ------------------------
%% Priority is a function of who is asking and what broke, not of how the case
%% was worded. The %%action hands a critical case to the escalation process in
%% Section 24.
%%meta name: Support Case Triage
%%meta kind: rules
%%rule caseTriage on SupportCase event: beforeCreate priority: 5
flowchart TD
    A([Start: Case Raised]) --> B{account tier == strategic?}
    B -->|Yes| C{case_type == incident?}
    C -->|Yes| D[Set priority critical]
    C -->|No| E[Set priority high]
    B -->|No| F{case_type == incident?}
    F -->|Yes| G{account tier == enterprise?}
    G -->|Yes| H[Set priority high]
    G -->|No| I[Set priority medium]
    F -->|No| J{case_type == billing?}
    J -->|Yes| K[Set priority medium]
    J -->|No| L[Set priority low]
    D --> M((Stamp SLA targets from policy))
    E --> M
    H --> M
    I --> M
    K --> M
    L --> M
    M --> N{first response due within 60 minutes?}
    N -->|Yes| O[Page the on-call queue]
    N -->|No| P[Queue for the next available agent]
    O --> Z([End: Case Triaged])
    P --> Z

    %% A critical case escalates through Section 24 rather than waiting for an
    %% agent to notice it.
    %%action escalateCriticalCase trigger-workflow when: priority == "critical" workflow: CriticalCaseEscalation message: Critical case — escalating and raising an escalation task
    %%action requireResolutionNotes validation-error when: status == "resolved" and resolution_notes == null message: A resolved case needs resolution notes

%% ---- Section 9: Business rule — renewal risk -------------------------------
%% Grades a contract as its renewal window opens. The renewal playbook in
%% Section 26 evaluates this same rule as a step rather than forking a second
%% copy of the policy.
%%meta name: Renewal Risk
%%meta kind: rules
%%rule renewalRisk on Contract event: beforeUpdate priority: 15
flowchart TD
    A([Start: Renewal Window Opened]) --> B{account health_score < 40?}
    B -->|Yes| C[Grade renewal at risk]
    B -->|No| D{open critical cases > 0?}
    D -->|Yes| E[Grade renewal watch]
    D -->|No| F{annual_value >= 250000?}
    F -->|Yes| G{auto_renew == true?}
    G -->|Yes| H[Grade renewal secure and confirm terms]
    G -->|No| I[Grade renewal strategic and assign an executive]
    F -->|No| J{auto_renew == true?}
    J -->|Yes| K[Grade renewal automatic]
    J -->|No| L[Grade renewal standard]
    C --> M((Compute renewal probability))
    E --> M
    H --> M
    I --> M
    K --> M
    L --> M
    M --> Z([End: Renewal Graded])

