{
  "name": "erdwithai",
  "version": "5.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @erdwithai/web dev",
    "dev:mastra": "bun --filter @erdwithai/ai dev",
    "build": "bun run lint && bun run build:core && bun run build:generator && bun run build:ai && bun run build:web",
    "build:core": "bun --filter @erdwithai/core build",
    "build:generator": "bun --filter @erdwithai/generator build",
    "build:ai": "bun --filter @erdwithai/ai build",
    "build:web": "bun --filter @erdwithai/web build",
    "start": "bun --filter @erdwithai/web start",
    "start:mastra": "bun --filter @erdwithai/ai start",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "type-check:language": "tsc -p tsconfig.language.json",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist",
    "convert": "bun --filter @erdwithai/ai convert",
    "migrate": "bun run packages/generator/migrations/migrate.ts",
    "generate:tanstack": "INIT_CWD=$PWD bun --filter @erdwithai/generator generate -- --stack tanstackjs-nestjs",
    "test": "bun --filter @erdwithai/web test",
    "test:watch": "bun --filter @erdwithai/web test:watch",
    "test:coverage": "bun test --coverage",
    "test:ui": "bun test --watch",
    "test:app": "bun test test/full-app-test.ts",
    "test:e2e": "bun test test/comprehensive-e2e.test.ts",
    "test:e2e:all": "bun test test/full-app-test.ts && bun test test/comprehensive-e2e.test.ts",
    "test:generator": "bun test test/generator-e2e.test.ts",
    "test:complete": "bun test test/run-all-e2e.test.ts",
    "test:e2e:server": "./scripts/tests/run-e2e-with-server.sh",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:debug": "playwright test --debug",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "setup:gstack": "git clone --single-branch --depth 1 https://github.com/garrytan/gstack.git ~/.claude/skills/gstack && cd ~/.claude/skills/gstack && ./setup",
    "seed:admin": "bun scripts/seed-admin.ts",
    "generate:wasm": "bun packages/generator/src/cli-wasm/generate.ts generate",
    "wasm": "bun packages/generator/src/cli-wasm/generate.ts",
    "build:wasm-runtime": "bun scripts/build-wasm-runtime.ts",
    "build:wasm-browser": "bun scripts/build-wasm-browser.ts",
    "vendor:pglite": "bun scripts/vendor-pglite.ts",
    "test:wasm": "playwright test --config tests/e2e/wasm/playwright.config.ts",
    "test:wasm:cli": "playwright test --config tests/e2e/wasm/playwright.config.ts --grep @cli",
    "test:wasm:browser": "playwright test --config tests/e2e/wasm/playwright.config.ts --grep @browser"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@electric-sql/pglite": "^0.5.5",
    "@gorules/zen-engine-darwin-arm64": "0.54.0",
    "@nestjs/common": "^10",
    "@nestjs/config": "^3",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.16.0",
    "kysely": "^0.29.4",
    "kysely-pglite": "^0.6.1",
    "pg": "^8.17.1",
    "playwright": "^1.62.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "preferredRuntime": "bun",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@copilotkit/react-core": "^1.68.1",
    "@copilotkit/react-ui": "^1.68.1",
    "@copilotkit/runtime": "^1.68.1",
    "@e2b/code-interpreter": "^2.7.0",
    "@mastra/client-js": "^1.40.0",
    "@mastra/core": "^1.59.0",
    "@mastra/fastembed": "^1.2.0",
    "@mastra/libsql": "^1.20.0",
    "@mastra/loggers": "^1.2.0",
    "@mastra/memory": "^1.26.2",
    "@mastra/pg": "^1.20.0",
    "@mastra/rag": "^2.5.0",
    "@mermaid-js/parser": "^1.2.0",
    "@tanstack/start": "^1.120.20",
    "autoprefixer": "^10.5.0",
    "critters": "^0.0.25",
    "openai": "^7.1.0"
  }
}
