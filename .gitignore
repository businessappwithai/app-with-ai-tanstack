# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Allow test files inside source packages and generated-projects
!packages/**/__tests__/*.test.ts
!packages/**/__tests__/*.spec.ts
!generated-projects/**/*.test.ts
!generated-projects/**/*.spec.ts

# Generated projects runtime artifacts
packages/web/generated-projects/
packages/generator/generated-projects/
generated-projects/*
generated-app/
run-logs/

# Test + build artifacts. These are bundled output — linting or reviewing them
# says nothing about the source, and playwright-report/index.html alone carried
# 1380 lint diagnostics from its inlined bundle.
playwright-report/
test-results/

# Production
dist/
build/
.next/
out/

# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Database
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
erdwithai-mastra.db*
database/erdwithai.db/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*
lerna-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*.swn
.vscode
.idea

# Misc
.turbo
.vercel
.cache
temp/
tmp/

# Generated
generated/
output/
test-output/
*.mermaid
*.generated.*
.gstack/
.playwright-mcp/

# Checker report artifacts — rewritten on every generate
*.eml.mmd.error
docker/ca-certificates/*.crt

# Generated CRM reference application — the source is committed on purpose (it
# is the worked example for language/examples/crm.eml.mmd), but never its
# dependencies, build output or lockfile.
!generated-projects/crm/
generated-projects/crm/**/node_modules/
generated-projects/crm/**/dist/
generated-projects/crm/**/.output/
generated-projects/crm/**/build/
generated-projects/crm/**/.vinxi/
generated-projects/crm/**/.tanstack/
generated-projects/crm/**/*.log
generated-projects/crm/**/.env
generated-projects/crm/bun.lock
generated-projects/crm/**/app.config.timestamp_*.js

# PGlite vendored beside the guide by `bun run vendor:pglite` — 17MB of
# WebAssembly, fetched on demand rather than committed.
html/assets/vendor/

# The browser stack's inlined runtime is generated, and is committed anyway.
# It is what the generator actually reads — a browser has no `fs.readFile` — so
# a checkout without it produces applications with no runtime in them. CI keeps
# it honest by regenerating and diffing (`bun run build:wasm-runtime --check`).
!packages/generator/src/generators/wasm/runtime-assets.generated.ts
