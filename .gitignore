# Checker report artifacts — rewritten on every generate
*.eml.mmd.error
docker/ca-certificates/*.crt

# Generated CRM reference application — the source is committed on purpose (it
# is the worked example for language/examples/crm.eml.mmd), but never its
# dependencies, build output or lockfile.

# PGlite vendored beside the guide by `bun run vendor:pglite` — 17MB of
# WebAssembly, fetched on demand rather than committed.
html/assets/vendor/

# The WASM stack's inlined assets are generated, and are committed anyway.
# They are what the generator actually reads — a browser has no `fs.readFile` —
# so a checkout without them produces applications with no runtime and an
# overlay with nothing to apply. CI keeps them honest by regenerating and
# diffing (`bun run build:wasm-runtime -- --check`).
#
# Named individually rather than as `!**/*.generated.ts`: the blanket form would
# quietly start committing every generated file anyone adds later, which is the
# opposite of what the rule above it is for.
!packages/generator/src/generators/wasm/runtime-assets.generated.ts
!packages/generator/src/generators/wasm/overlay-assets.generated.ts

# Written by the audit-ledger test when it stubs the Nest decorators.
packages/generator/templates/wasm-overlay/backend/src/modules/audit/__stub.ts
packages/generator/templates/wasm-overlay/backend/src/modules/audit/__under-test.ts
packages/generator/src/generators/wasm/__tests__/.tmp/

# Screenshots the wasm E2E suite captures on every run. Regenerated by
# `bun run test:wasm`; the ones worth keeping are copied into docs/qa.
pics/wasm-e2e/

# The NestJS stack's templates, copied beside the hosted page by
# `bun run build:stack-templates`. A second copy of files already in this
# repository — regenerate it rather than commit it.
html/assets/stack-templates.json
pics/

# Tool and build output that was committed once and should not be again.
# `graphify-out/` is a dependency-graph report, `.understand-anything/` a code
# scan, `.mastra/` Mastra's bundler output, and `.pids/` the pid files a local
# run leaves behind — including, until recently, ones naming stacks the
# generator stopped emitting years ago.
.mastra/
.pids/
graphify-out/
.understand-anything/

# A per-developer profile for a local model endpoint. Personal tooling.
.openclaude-profile.json
