# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Allow test files inside source packages and generated-projects
!packages/**/__tests__/*.test.ts
!packages/**/__tests__/*.spec.ts
!generated-projects/**/*.test.ts
!generated-projects/**/*.spec.ts

# ...and the E2E suites, which are the repository's own tests. The blanket
# `*.spec.ts` above is aimed at spec files inside generated output; without this
# negation a suite written under tests/ is silently never committed, which is
# exactly what happened to `tests/e2e/wasm/` — playwright.config.ts landed and
# the two specs beside it did not.
!tests/**/*.e2e.spec.ts
!tests/**/*.spec.ts

# Generated projects runtime artifacts
packages/web/generated-projects/
packages/generator/generated-projects/
generated-projects/*
generated-app/
run-logs/

# Test + build artifacts. These are bundled output — linting or reviewing them
# says nothing about the source, and playwright-report/index.html alone carried
# 1380 lint diagnostics from its inlined bundle.
playwright-report/
test-results/

