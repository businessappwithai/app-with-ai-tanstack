    %%rbac role:doctor|nurse on ImagingOrder.create
    %%rbac role:doctor|nurse|radiologist|receptionist on ImagingOrder.update
    %%rbac role:administrator on ImagingOrder.delete

    %%field ImagingReport.imaging_order_id help: The study this report interprets.
    %%field ImagingReport.doctor_id help: The radiologist who read the study and signed the report.
    %%field ImagingReport.findings help: What is visible on the study, described.
    %%field ImagingReport.impression help: What it means. This is the part the ordering clinician reads first and acts on.
    %%field ImagingReport.is_addendum help: Marks a later report that amends an earlier one rather than replacing it. The first report is kept, because a decision was made on it.
    %%field ImagingReport.is_critical help: A finding that has to be communicated now rather than read at the next ward round. Set by the radiologist; the escalation workflow acts on it.
    %%field ImagingReport.reported_at help: When the report was signed.
    %%index ImagingReport(imaging_order_id, reported_at)
    %%index ImagingReport(is_critical)
