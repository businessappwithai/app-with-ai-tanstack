    %%field InsurancePolicy.patient_id help: The patient this cover belongs to.
    %%field InsurancePolicy.insurer_name help: The company underwriting the policy, as it should appear on a claim.
    %%field InsurancePolicy.policy_number help: The insurer's own reference. Unique, and quoted on every claim.
    %%field InsurancePolicy.policy_type help: What kind of cover this is, which decides what may be claimed under it.
    %%field InsurancePolicy.valid_from help: The first day the cover applies.
    %%field InsurancePolicy.valid_to help: The last day it applies. An invoice dated outside these two is not claimable.
    %%field InsurancePolicy.coverage_limit help: The most the insurer will pay across the policy period, in currency.
    %%field InsurancePolicy.copay_percentage help: The share of each bill the patient pays themselves, as a percentage. The billing rule computes the split from this.
    %%field InsurancePolicy.is_primary help: Which policy to claim against first where a patient holds more than one. Exactly one should be ticked.
    %%field InsurancePolicy.status help: Whether the cover is live. Driven by the policy lifecycle rather than typed in.
    %%field InsurancePolicy.policy_type enum: PolicyType
    %%field InsurancePolicy.status enum: PolicyStatus
    %%index InsurancePolicy(patient_id, status)
    %%index InsurancePolicy(valid_to)
