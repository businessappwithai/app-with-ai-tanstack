%%meta name: Invoice Issue Gate
%%meta kind: rules
%%rule invoiceIssueGate on Invoice event: beforeUpdate priority: 10
flowchart TD
    A([Start: Bill being issued]) --> B{status becoming issued?}
    B -->|No| G[Allow the change]
    B -->|Yes| C{policy valid on the charge dates?}
    C -->|No| F[Refuse the issue]
    C -->|Yes| D{insurer and patient shares add up?}
    D -->|No| F
    D -->|Yes| E{marked overdue before its due date?}
    E -->|Yes| F
    E -->|No| G
    F --> H([Refused])
    G --> I([Allowed])

    %%action refuseInvalidPolicy validation-error when: status == 'issued' and insurancePolicyId != null and policyVerified == false message: The policy on this bill is not active for the dates being charged. Correct the cover, or bill the patient directly.
    %%action refuseUnbalancedSplit validation-error when: status == 'issued' and insurerAmount + patientAmount != grossAmount message: The insurer's share and the patient's share do not add up to the total. The co-payment has not been applied.
    %%action refuseEarlyOverdue validation-error when: status == 'overdue' and dueOn >= today message: A bill cannot be overdue before the day it falls due.

