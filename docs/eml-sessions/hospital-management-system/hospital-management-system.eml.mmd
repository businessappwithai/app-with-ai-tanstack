    %%field ClinicalNote.encounter_id help: The contact this note belongs to.
    %%field ClinicalNote.staff_id help: Who wrote it. Never changes — an addendum is a new note, not an edit of this one.
    %%field ClinicalNote.note_type help: What kind of note this is, which decides where it appears in the record.
