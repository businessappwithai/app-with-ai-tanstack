flowchart TD
    A([Item falls to its reorder level]) --> B[Put the item on the buyer's worklist]
    B --> C([Replenishment raised])

    %%step B UpdateEntity entity: InventoryItem targetField: inventory_item_id field: is_on_reorder value: true

%%meta name: Stock Movement Gate
%%meta kind: rules
%%rule stockMovementGate on StockTransaction event: beforeCreate priority: 10
flowchart TD
    A([Start: Movement being recorded]) --> B{quantity is zero?}
    B -->|Yes| F[Refuse the movement]
    B -->|No| C{direction matches the type?}
    C -->|No| F
    C -->|Yes| D{issue leaves enough stock?}
    D -->|No| F
    D -->|Yes| E[Record the movement]
    F --> G([Refused])
    E --> H([Recorded])

    %%action refuseZeroMovement validation-error when: quantity == 0 message: A movement of nothing is not a movement. To correct a count, record the difference.
    %%action refuseWrongDirectionIn validation-error when: transactionType == 'receipt' and quantity <= 0 message: A receipt adds to the store. Record a negative quantity as a return or a disposal.
    %%action refuseWrongDirectionOut validation-error when: transactionType == 'issue' and quantity >= 0 message: An issue takes stock away. Record it as a negative quantity.
    %%action refuseNegativeStock validation-error when: quantityOnHandAfter < 0 message: There is not that much in the store. Count the shelf and record a correction before issuing.

%%meta name: Stock Reorder Gate
%%meta kind: rules
%%rule stockReorderGate on StockTransaction event: afterCreate priority: 20
flowchart TD
    A([Start: Movement recorded]) --> B{item at or below its reorder level?}
    B -->|No| E[Nothing to do]
    B -->|Yes| C{already on the worklist?}
    C -->|Yes| E
    C -->|No| D[Raise a replenishment]
    D --> F([Raised])
    E --> G([Done])

    %%action raiseReplenishment trigger-workflow when: triggersReorder == true workflow: StockReplenishment message: This item has fallen to its reorder level and is now on the buyer's worklist.

%% ---- Gate D — the effects that cross entities ------------------------------

%%meta name: Appointment Check In
%%meta kind: workflow
%%workflow AppointmentCheckIn entity: Appointment kind: saga trigger: rule
flowchart TD
    A([Patient arrives and is checked in]) --> B[Open the encounter]
    B --> C([Encounter open])

    %%step B CreateEntity entity: Encounter as: newEncounterId fields: {"patient_id":"patient_id","doctor_id":"doctor_id","department_id":"department_id","appointment_id":"id","encounter_type":"outpatient","status":"open","is_billable":true}

%%meta name: Admission Takes Bed
%%meta kind: workflow
%%workflow AdmissionTakesBed entity: Admission kind: saga trigger: automatic operation: CREATE
flowchart TD
    A([Patient is admitted]) --> B[Take the bed out of the pool]
    B --> C([Bed occupied])

    %%step B UpdateEntity entity: Bed targetField: bed_id field: status value: occupied

%%meta name: Discharge Releases Bed
%%meta kind: workflow
%%workflow DischargeReleasesBed entity: Admission kind: saga trigger: rule
flowchart TD
    A([Patient is discharged]) --> B[Send the bed for cleaning]
    B --> C([Bed cleaning])

    %%step B UpdateEntity entity: Bed targetField: bed_id field: status value: cleaning

%%meta name: Encounter Invoicing
%%meta kind: workflow
%%workflow EncounterInvoicing entity: Encounter kind: saga trigger: rule
flowchart TD
    A([Encounter closed and billable]) --> B[Raise the bill in draft]
    B --> C([Invoice drafted])

    %%step B CreateEntity entity: Invoice as: newInvoiceId fields: {"patient_id":"patient_id","encounter_id":"id","status":"draft","gross_amount":0,"insurer_amount":0,"patient_amount":0,"paid_amount":0}

%%meta name: Consent Withdrawal
%%meta kind: workflow
%%workflow ConsentWithdrawal entity: Consent kind: saga trigger: rule
flowchart TD
    A([Consent withdrawn]) --> B[Take the procedure back to planned]
    B --> C([Procedure no longer consented])

    %%step B UpdateEntity entity: Procedure targetField: procedure_id field: status value: planned

%%meta name: Appointment Check In Gate
%%meta kind: rules
%%rule appointmentCheckInGate on Appointment event: afterUpdate priority: 20
flowchart TD
    A([Start: Appointment updated]) --> B{status becoming checked_in?}
    B -->|No| D[Nothing to do]
    B -->|Yes| C[Open the encounter]
    C --> E([Encounter opened])
    D --> F([Done])

    %%action openEncounter trigger-workflow when: status == 'checked_in' workflow: AppointmentCheckIn message: The patient has arrived, so the booking becomes a clinical contact.

%%meta name: Discharge Bed Gate
%%meta kind: rules
%%rule dischargeBedGate on Admission event: afterUpdate priority: 30
flowchart TD
    A([Start: Admission updated]) --> B{status becoming discharged?}
    B -->|No| D[Nothing to do]
    B -->|Yes| C[Release the bed]
    C --> E([Bed released])
    D --> F([Done])

    %%action releaseBed trigger-workflow when: status == 'discharged' workflow: DischargeReleasesBed message: The stay has ended, so the bed goes for cleaning rather than straight back into the pool.

%%meta name: Encounter Invoicing Gate
%%meta kind: rules
%%rule encounterInvoicingGate on Encounter event: afterUpdate priority: 20
flowchart TD
    A([Start: Encounter updated]) --> B{status becoming closed?}
    B -->|No| E[Nothing to do]
    B -->|Yes| C{billable?}
    C -->|No| E
    C -->|Yes| D[Raise the bill]
    D --> F([Invoice drafted])
    E --> G([Done])

    %%action raiseInvoice trigger-workflow when: status == 'closed' and isBillable == true workflow: EncounterInvoicing message: A closed contact is what makes an episode billable, so the bill is drafted here rather than typed later.

%%meta name: Consent Withdrawal Gate
%%meta kind: rules
%%rule consentWithdrawalGate on Consent event: afterUpdate priority: 20
flowchart TD
    A([Start: Consent updated]) --> B{withdrawn?}
    B -->|No| D[Nothing to do]
    B -->|Yes| C[Take the procedure back to planned]
    C --> E([Procedure unconsented])
    D --> F([Done])

    %%action unconsentProcedure trigger-workflow when: isWithdrawn == true workflow: ConsentWithdrawal message: Consent has been withdrawn, so the procedure it authorised is no longer consented.
