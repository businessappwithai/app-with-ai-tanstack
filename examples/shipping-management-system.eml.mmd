%%meta name: Quote lifecycle
%%meta kind: workflow
%%workflow QuoteLifecycle entity: Quote kind: state
stateDiagram-v2
    [*] --> quote_draft
    quote_draft --> quote_offered : offer
    quote_offered --> quote_draft : revise
    quote_offered --> quote_accepted : accept
    quote_offered --> quote_declined : decline
    quote_offered --> quote_expired : expire
    quote_accepted --> [*]
    quote_declined --> [*]
    quote_expired --> [*]

%%meta name: Shipment lifecycle
%%meta kind: workflow
%%workflow ShipmentLifecycle entity: Shipment kind: state
stateDiagram-v2
    [*] --> job_open
    job_open --> job_booked : confirm_arrangements
    job_booked --> job_open : replan
    job_booked --> job_moving : depart
    job_moving --> job_arrived : arrive
    job_arrived --> job_moving : oncarry
    job_arrived --> job_delivered : complete_delivery
    job_delivered --> job_closed : close_job
    job_open --> job_cancelled : cancel_job
    job_booked --> job_cancelled : cancel_job
    job_closed --> [*]
    job_cancelled --> [*]

%%meta name: Booking lifecycle
%%meta kind: workflow
%%workflow BookingLifecycle entity: Booking kind: state
stateDiagram-v2
    [*] --> booking_requested
    booking_requested --> booking_confirmed : confirm_booking
    booking_requested --> booking_rejected : reject_booking
    booking_requested --> booking_cancelled : withdraw_booking
    booking_confirmed --> booking_amending : request_amendment
    booking_amending --> booking_confirmed : resolve_amendment
    booking_confirmed --> booking_cancelling : request_cancellation
    booking_cancelling --> booking_confirmed : refuse_cancellation
    booking_cancelling --> booking_cancelled : accept_cancellation
    booking_confirmed --> booking_completed : complete_booking
    booking_completed --> [*]
    booking_rejected --> [*]
    booking_cancelled --> [*]

%%meta name: BookingChange lifecycle
%%meta kind: workflow
%%workflow BookingChangeLifecycle entity: BookingChange kind: state
stateDiagram-v2
    [*] --> change_draft
    change_draft --> change_sent : submit_change
    change_draft --> change_withdrawn : withdraw_change
    change_sent --> change_accepted : accept_change
    change_sent --> change_refused : refuse_change
    change_sent --> change_withdrawn : withdraw_change
    change_accepted --> [*]
    change_refused --> [*]
    change_withdrawn --> [*]

%%meta name: TransportLeg lifecycle
%%meta kind: workflow
%%workflow TransportLegLifecycle entity: TransportLeg kind: state
stateDiagram-v2
    [*] --> leg_planned
    leg_planned --> leg_dispatched : dispatch_leg
    leg_dispatched --> leg_moving : start_leg
    leg_moving --> leg_completed : complete_leg
    leg_planned --> leg_cancelled : cancel_leg
    leg_dispatched --> leg_cancelled : cancel_leg
    leg_completed --> [*]
    leg_cancelled --> [*]

%%meta name: ContainerUse lifecycle
%%meta kind: workflow
%%workflow ContainerUseLifecycle entity: ContainerUse kind: state
