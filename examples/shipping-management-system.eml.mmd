%%report sales-quote-decisions title: Sales quotation decisions entity: Quote help: Review offered, accepted and lost commercial versions before following up customer decisions. sql: SELECT status, COUNT(*) AS offers FROM bus_quote WHERE deleted_at IS NULL GROUP BY status
%%report sales-offer-costs title: Offered services and estimated margin entity: Quote help: Compare sell value and reviewed cost estimates within each offer currency; this is a quotation estimate rather than posted job profit. sql: SELECT q.reference, q.status, c.code AS currency, SUM(CASE WHEN l.quantity*l.unit_price > l.minimum_amount THEN l.quantity*l.unit_price ELSE l.minimum_amount END) AS offered_net, SUM(l.estimated_cost) AS estimated_cost FROM bus_quote q JOIN bus_quote_line l ON l.quote_id=q.id AND l.deleted_at IS NULL JOIN bus_currency c ON c.id=q.currency_id AND c.deleted_at IS NULL WHERE q.deleted_at IS NULL GROUP BY q.reference,q.status,c.code
%%report operations-active-jobs title: Open forwarding jobs entity: Shipment help: Prioritise live customer commitments and unresolved operational holds. sql: SELECT reference,status,cargo_ready_on,requested_delivery_on,is_on_hold,hold_reason FROM bus_shipment WHERE deleted_at IS NULL AND status NOT IN ('job_closed','job_cancelled') ORDER BY requested_delivery_on,reference
%%report operations-missed-cutoffs title: Carrier bookings past cargo cut-off entity: Booking help: Investigate bookings whose cargo deadline has passed and reconcile actual loading or carrier rollover evidence. sql: SELECT reference,carrier_reference,cargo_cutoff_at,status FROM bus_booking WHERE deleted_at IS NULL AND cargo_cutoff_at < CURRENT_TIMESTAMP AND status IN ('booking_requested','booking_confirmed','booking_amending') ORDER BY cargo_cutoff_at
%%report equipment-return-risk title: Equipment awaiting empty return entity: ContainerUse help: Locate equipment cycles with an overdue agreed return and obtain current depot acceptance evidence. sql: SELECT reference,container_number,status,empty_return_due_at FROM bus_container_use WHERE deleted_at IS NULL AND empty_return_due_at < CURRENT_TIMESTAMP AND empty_returned_at IS NULL AND status NOT IN ('unit_cancelled','unit_returned') ORDER BY empty_return_due_at
%%report warehouse-loading-readiness title: Packed units awaiting verified loading evidence entity: ContainerUse help: Obtain the accepted VGM version before treating a packed unit as ready for vessel loading. sql: SELECT reference,container_number,verified_gross_kg,vgm_acknowledged FROM bus_container_use WHERE deleted_at IS NULL AND status='unit_packed' AND (verified_gross_kg IS NULL OR vgm_acknowledged=FALSE)
%%report documentation-instruction-queue title: Instructions awaiting carrier response entity: ShippingInstruction help: Follow up documentary acknowledgement and correction requests before the linked booking cut-offs. sql: SELECT reference,revision_number,status,submitted_at FROM bus_shipping_instruction WHERE deleted_at IS NULL AND status IN ('si_submitted','si_correction') ORDER BY submitted_at
%%report documentation-original-control title: Issued documents awaiting surrender decision entity: TransportDocument help: Review outstanding original-control and amendment cases; waybill entitlement follows its distinct procedure. sql: SELECT reference,document_number,document_kind,medium,status,issued_at FROM bus_transport_document WHERE deleted_at IS NULL AND status IN ('doc_issued','doc_surrender_pending','doc_amend_pending') ORDER BY issued_at
%%report customs-deadline-queue title: Customs submissions requiring action entity: CustomsFiling help: Resolve authority queries and filing deadlines using the reviewed jurisdiction-specific requirement. sql: SELECT reference,filing_kind,authority_name,status,filing_due_at,authority_response FROM bus_customs_filing WHERE deleted_at IS NULL AND status IN ('filing_draft','filing_rejected','filing_held') ORDER BY filing_due_at
%%report release-held-cargo title: Cargo release clearance gaps entity: ReleaseOrder help: Show the independent clearances still preventing authorised cargo collection. sql: SELECT reference,status,document_cleared,customs_cleared,finance_cleared,terminal_cleared FROM bus_release_order WHERE deleted_at IS NULL AND status IN ('release_requested','release_held')
%%report warehouse-delivery-exceptions title: Receiving shortages and damage entity: Delivery help: Follow up actual receiving exceptions without counting damaged packages twice as missing goods. sql: SELECT d.reference,c.name,l.planned_packages,l.delivered_packages,l.short_packages,l.damaged_packages,l.receipt_reservations FROM bus_delivery d JOIN bus_delivery_line l ON l.delivery_id=d.id AND l.deleted_at IS NULL JOIN bus_cargo_item c ON c.id=l.cargo_item_id AND c.deleted_at IS NULL WHERE d.deleted_at IS NULL AND (l.short_packages>0 OR l.damaged_packages>0)
%%report finance-overdue-balances title: Overdue invoice balances by currency entity: Invoice help: Collect overdue customer balances and plan supplier payments without summing unlike currencies. sql: SELECT p.name,c.code,i.invoice_kind,i.document_number,i.due_on,i.open_amount FROM bus_invoice i JOIN bus_party p ON p.id=i.party_id AND p.deleted_at IS NULL JOIN bus_currency c ON c.id=i.currency_id AND c.deleted_at IS NULL WHERE i.deleted_at IS NULL AND i.invoice_kind IN ('receivable_invoice','payable_invoice') AND i.status IN ('invoice_posted','invoice_partial') AND i.open_amount>0 AND i.due_on<CURRENT_DATE ORDER BY c.code,i.due_on
%%report finance-job-billed-margin title: Posted job margin by transaction currency entity: Invoice help: Posted revenue less supplier costs excluding tax, with credit signs applied; review remaining accrual exposure separately. sql: SELECT s.reference,c.code,SUM(CASE WHEN i.invoice_kind='receivable_invoice' THEN l.net_amount WHEN i.invoice_kind='receivable_credit' THEN -l.net_amount WHEN i.invoice_kind='payable_invoice' THEN -l.net_amount ELSE l.net_amount END) AS billed_net_margin FROM bus_invoice_line l JOIN bus_invoice i ON i.id=l.invoice_id AND i.deleted_at IS NULL JOIN bus_shipment s ON s.id=l.shipment_id AND s.deleted_at IS NULL JOIN bus_currency c ON c.id=i.currency_id AND c.deleted_at IS NULL WHERE l.deleted_at IS NULL AND i.status IN ('invoice_posted','invoice_partial','invoice_settled') GROUP BY s.reference,c.code
%%report finance-unmatched-cost title: Remaining supplier accrual exposure entity: CostAccrual help: Review expected costs still unmatched by actual vendor charges before closing a job. sql: SELECT s.reference,c.code,SUM(a.remaining_amount) AS unbilled_cost FROM bus_cost_accrual a JOIN bus_shipment s ON s.id=a.shipment_id AND s.deleted_at IS NULL JOIN bus_currency c ON c.id=a.currency_id AND c.deleted_at IS NULL WHERE a.deleted_at IS NULL AND a.status IN ('accrual_approved','accrual_partial') GROUP BY s.reference,c.code
%%report finance-disputed-statements title: Supplier reconciliation differences entity: SupplierStatement help: Resolve unmatched supplier or agent items using each statement’s documented currency and sign convention. sql: SELECT reference,status,period_to,supplier_closing_balance,ledger_closing_balance,supplier_closing_balance-ledger_closing_balance AS variance FROM bus_supplier_statement WHERE deleted_at IS NULL AND (status='statement_disputed' OR supplier_closing_balance<>ledger_closing_balance)
%%report claims-notice-watch title: Open claim notice and limitation dates entity: Claim help: Preserve reviewed contractual deadlines while separately recording notice and recovery evidence. sql: SELECT reference,status,claim_kind,notice_due_on,limitation_on,claimed_amount,recovered_amount FROM bus_claim WHERE deleted_at IS NULL AND status IN ('claim_open','claim_notified','claim_negotiating') ORDER BY limitation_on,notice_due_on
%%report staff-overdue-actions title: Overdue shipment actions entity: Task help: Every functional team can identify overdue actions in the jobs it is authorised to handle. sql: SELECT title,priority,status,due_at,shipment_id,owner_id FROM bus_task WHERE deleted_at IS NULL AND status NOT IN ('task_done','task_cancelled') AND due_at<CURRENT_TIMESTAMP ORDER BY due_at

