%%meta name: Billing Calculation
%%meta kind: rules
%%rule BillingCalculation on INVOICE event: beforeCreate priority: 10
flowchart TD
    A([Invoice prepared]) --> B{gross_amount >= discount_amount}
    B -->|Yes| C[Calculate net amount]
    B -->|No| D[Reject invalid discount]
    C --> Z([Calculation complete])
    D --> Z
%%action calculateInvoice trigger-workflow when: gross_amount >= discount_amount workflow: InvoiceCalculation message: Calculate invoice net amount
%%action rejectExcessDiscount validation-error when: gross_amount < discount_amount message: Discount cannot exceed gross amount
%%meta name: Prescription Safety
%%meta kind: rules
%%rule PrescriptionSafety on PRESCRIPTION event: beforeUpdate priority: 20
flowchart TD
    A([Prescription reviewed]) --> B{interaction_alert == true}
    B -->|Yes| C[Block signing]
    B -->|No| D[Allow signing]
    C --> Z([Safety decision])
    D --> Z
%%action blockUnsafePrescription validation-error when: interaction_alert == true message: Resolve the interaction alert before signing
%%meta name: Triage Override
%%meta kind: rules
%%rule TriageOverride on ENCOUNTER event: beforeUpdate priority: 5
flowchart TD
    A([Triage updated]) --> B{triage_priority == "EMERGENCY"}
    B -->|Yes| C[Escalate immediately]
    B -->|No| D[Continue normal queue]
    C --> Z([Triage routed])
    D --> Z
%%action escalateEmergency transform when: triage_priority == "EMERGENCY" field: status value: TRIAGED message: Emergency triage recorded
%%meta name: Invoice Calculation
%%meta kind: workflow
%%workflow InvoiceCalculation entity: INVOICE kind: saga trigger: rule
flowchart TD
    A([Start calculation]) --> B[Subtract discount]
    B --> C[Add tax]
    C --> D[Store net amount]
    D --> Z([Invoice calculated])
%%step B Formula target: subtotal operation: subtract source: gross_amount operand: discount_amount
%%step C Formula target: calculatedNet operation: add source: subtotal operand: tax_amount
%%step D UpdateEntity field: net_amount source: calculatedNet
%%meta name: Invoice Audit Hook
%%meta kind: workflow
%%workflow InvoiceAudit entity: INVOICE kind: hook
flowchart TD
    A([Invoice created]) --> B[Record audit context]
    B --> Z([Audit complete])
%%hook afterCreate auditInvoiceCreation on INVOICE[field: status]
