%%enum AdmissionStatus: planned, admitted, discharged, cancelled
%%enum BedStatus: available, occupied, cleaning, maintenance
%%enum PrescriptionStatus: draft, prescribed, dispensed, cancelled
%%enum LabOrderStatus: ordered, collected, processing, completed, cancelled
%%enum ImagingOrderStatus: ordered, scheduled, performed, reported, cancelled
%%enum InvoiceStatus: draft, issued, partially_paid, paid, cancelled
%%enum PaymentStatus: pending, completed, failed, refunded
%%enum InventoryStatus: active, inactive
%%enum StockTransactionStatus: pending, posted, cancelled

