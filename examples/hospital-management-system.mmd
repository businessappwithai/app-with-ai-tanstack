%%meta name: Appointment Lifecycle
%%meta kind: workflow
%%workflow AppointmentLifecycle entity: Appointment kind: state
stateDiagram-v2
    [*] --> requested
    requested --> confirmed : confirm
    requested --> cancelled : cancel
    confirmed --> checked_in : check_in
    confirmed --> cancelled : cancel
    confirmed --> no_show : mark_no_show
    checked_in --> completed : complete
    checked_in --> cancelled : cancel
    completed --> [*]
    cancelled --> [*]
    no_show --> [*]
    %%rbac role:receptionist on Appointment.confirm
    %%rbac role:receptionist|nurse on Appointment.check_in
    %%rbac role:receptionist|doctor on Appointment.complete
    %%rbac role:receptionist on Appointment.cancel
    %%rbac role:receptionist on Appointment.mark_no_show
    %% Nobody presses these; the clock does. `%%trigger` is validated rather
    %% than compiled, so it documents the schedule the operator has to provide
    %% rather than creating it — check the directive's status before promising
    %% a user that it runs.
    %%trigger cron:0 7 * * * -> remindTomorrowsAppointments on Appointment
    %%trigger cron:0 1 * * * -> expireUnconfirmedAppointments on Appointment

