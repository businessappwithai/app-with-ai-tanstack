%% ---- Lifecycle hooks -------------------------------------------------------
%% Rules decide; hooks act on the write itself. Everything below is something
%% that has to happen on every path into the record — the API, an import, a
%% saga — and so cannot live in a screen. The flowchart is what a reader sees
%% and the `%%hook` lines are what the generator compiles; both halves have to
%% say the same thing.

%%meta name: Patient Registration
%%meta kind: workflow
%%workflow PatientRegistration entity: Patient kind: hook
flowchart TD
    A[Client Request] --> B[Validate Request]
    B --> C[beforeCreate: normalizePatientName]
    C --> D[customValidate: ensureMedicalRecordNumberUnique]
    D --> E[Process Patient]
    E --> F[afterCreate: openPatientTimeline]
    F --> G[beforeList: scopeToTreatingDepartment]
    G --> H[beforeDelete: blockDeleteWithClinicalHistory]
    H --> I[Response]

    %% A patient is never deleted once anything clinical hangs off them — an
    %% encounter, an invoice, a dispensed prescription. The refusal is here
    %% rather than in the UI because the record is reachable from the API and
    %% from an import, and a deleted patient orphans a diagnosis.
    %%hook beforeCreate normalizePatientName on Patient[field: last_name]
    %%hook customValidate ensureMedicalRecordNumberUnique on Patient[field: medical_record_number]
    %%hook afterCreate openPatientTimeline on Patient
    %%hook beforeList scopeToTreatingDepartment on Patient
    %%hook beforeDelete blockDeleteWithClinicalHistory on Patient

%%meta name: Bed Occupancy
%%meta kind: workflow
%%workflow BedOccupancy entity: Admission kind: hook
flowchart TD
    A[Client Request] --> B[Validate Request]
    B --> C[beforeCreate: ensureBedAvailable]
    C --> D[Process Admission]
    D --> E[afterCreate: occupyBed]
    E --> F[beforeUpdate: stampDischargedAt]
    F --> G[afterUpdate: releaseBedOnDischarge]
    G --> H[Response]

    %% Bed status is the one piece of state two records disagree about if
    %% nobody owns it: `Bed.status` says whether it can be given out, and
    %% `Admission` is what takes it. These four keep the pair honest — the bed
    %% is checked before the admission is written, taken when it is, and given
    %% back the moment a discharge time lands on the row.
    %%hook beforeCreate ensureBedAvailable on Admission[field: bed_id]
    %%hook afterCreate occupyBed on Admission[field: bed_id]
    %%hook beforeUpdate stampDischargedAt on Admission[field: discharged_at]
    %%hook afterUpdate releaseBedOnDischarge on Admission[field: bed_id]

%%meta name: Prescription Dispensing
%%meta kind: workflow
%%workflow PrescriptionDispensing entity: Prescription kind: hook
flowchart TD
    A[Client Request] --> B[Validate Request]
    B --> C[beforeCreate: stampPrescribedAt]
    C --> D[customValidate: ensurePrescriberIsLicensed]
    D --> E[Process Prescription]
    E --> F[afterUpdate: decrementDispensedStock]
    F --> G[afterList: attachDispensingStatus]
    G --> H[Response]

    %% Dispensing is where the clinical record and the pharmacy stock meet.
    %% `decrementDispensedStock` is on afterUpdate rather than afterCreate
    %% because stock moves when the prescription reaches `dispensed`, not when
    %% it is written.
    %%hook beforeCreate stampPrescribedAt on Prescription[field: prescribed_at]
    %%hook customValidate ensurePrescriberIsLicensed on Prescription[field: doctor_id]
    %%hook afterUpdate decrementDispensedStock on Prescription
    %%hook afterList attachDispensingStatus on Prescription

%%meta name: Invoice Calculation
%%meta kind: workflow
%%workflow InvoiceCalculation entity: Invoice kind: hook
flowchart TD
    A[Client Request] --> B[Validate Request]
    B --> C[beforeCreate: computeInvoiceTotals]
    C --> D[customValidate: ensureInvoiceNumberUnique]
    D --> E[Process Invoice]
    E --> F[beforeUpdate: recomputeBalanceDue]
    F --> G[afterList: attachAgeingBucket]
    G --> H[Response]

    %% Totals are arithmetic over the lines, so they are computed on the write
    %% and never trusted from the caller: an invoice whose `total` disagrees
    %% with its own lines is the one defect a billing system may not have.
    %%hook beforeCreate computeInvoiceTotals on Invoice[field: total]
    %%hook customValidate ensureInvoiceNumberUnique on Invoice[field: invoice_number]
    %%hook beforeUpdate recomputeBalanceDue on Invoice[field: balance_due]
    %%hook afterList attachAgeingBucket on Invoice

%%meta name: Patient Validation
%%meta kind: rules
%%rule patientValidation on Patient event: beforeCreate priority: 10
flowchart TD
    A([Patient registration]) --> B{medical_record_number present?}
    B -->|Yes| C[Accept registration]
    B -->|No| D[Reject registration]
    C --> Z([Patient accepted])
    D --> E([Registration rejected])
    %%action requirePatientNumber validation-error when: medical_record_number == null message: Medical record number is required

%%meta name: Appointment Gate
%%meta kind: rules
%%rule appointmentGate on Appointment event: beforeCreate priority: 10
flowchart TD
    A([Appointment request]) --> B{scheduled_at present?}
    B -->|Yes| C[Accept appointment]
    B -->|No| D[Reject appointment]
    C --> Z([Appointment accepted])
    D --> E([Appointment rejected])
    %%action requireAppointmentTime validation-error when: scheduled_at == null message: Appointment date and time are required
    %%action startEncounterWorkflow trigger-workflow when: status == "checked_in" workflow: AppointmentToEncounter message: Checked-in appointment creates an encounter

%%meta name: Prescription Safety
%%meta kind: rules
%%rule prescriptionSafety on Prescription event: beforeCreate priority: 10
flowchart TD
    A([Prescription request]) --> B{doctor present?}
    B -->|Yes| C[Accept prescription]
    B -->|No| D[Reject prescription]
    C --> Z([Prescription accepted])
    D --> E([Prescription rejected])
    %%action requirePrescribingDoctor validation-error when: doctor_id == null message: A prescribing doctor is required

%%meta name: Admission Allocation Gate
%%meta kind: rules
%%rule admissionAllocationGate on Admission event: beforeCreate priority: 10
flowchart TD
    A([Admission planned]) --> B{bed present?}
    B -->|Yes| C[Allocate admission]
    B -->|No| D[Reject admission]
    C --> Z([Admission accepted])
    D --> E([Admission rejected])
    %%action requireAdmissionBed validation-error when: bed_id == null message: An assigned bed is required for an admission
    %%action startAdmissionWorkflow trigger-workflow when: status == "planned" workflow: AdmissionBedAllocation message: Planned admission allocates the assigned bed

%%meta name: Lab Completion Gate
%%meta kind: rules
%%rule labCompletionGate on LabResult event: beforeCreate priority: 10
flowchart TD
    A([Lab result]) --> B{result value present?}
    B -->|Yes| C[Accept result]
    B -->|No| D[Reject result]
    C --> Z([Result accepted])
    D --> E([Result rejected])
    %%action requireLabValue validation-error when: result_value == null message: Laboratory result value is required

%%meta name: Invoice Integrity
%%meta kind: rules
%%rule invoiceIntegrity on Invoice event: beforeCreate priority: 10
flowchart TD
    A([Invoice]) --> B{total >= 0?}
    B -->|Yes| C[Accept invoice]
    B -->|No| D[Reject invoice]
    C --> Z([Invoice accepted])
    D --> E([Invoice rejected])
    %%action rejectNegativeInvoice validation-error when: total < 0 message: Invoice total cannot be negative

%%meta name: Payment Settlement Gate
%%meta kind: rules
%%rule paymentSettlementGate on Payment event: afterUpdate priority: 10
flowchart TD
    A([Payment updated]) --> B{status == completed?}
    B -->|Yes| C[Apply settlement]
    B -->|No| D[Leave invoice open]
    C --> Z([Settlement started])
    D --> Z
    %%action startPaymentSettlement trigger-workflow when: status == "completed" workflow: InvoicePaymentSettlement message: Completed payment updates the invoice

%%meta name: Inventory Reorder
%%meta kind: rules
%%rule inventoryReorder on InventoryItem event: afterUpdate priority: 20
flowchart TD
    A([Inventory updated]) --> B{quantity_on_hand <= reorder_level?}
    B -->|Yes| C[Flag for replenishment]
    B -->|No| D[No replenishment action]
    C --> Z([Reorder evaluation complete])
    D --> Z

%%meta name: Appointment To Encounter
%%meta kind: workflow
%%workflow AppointmentToEncounter entity: Appointment kind: saga trigger: rule
flowchart TD
    A([Checked-in appointment]) --> B[Create encounter]
    B --> C[Link appointment]
    C --> Z([Encounter opened])
    %%step B CreateEntity entity: Encounter as: encounterId fields: {"patient_id":"patient_id","doctor_id":"doctor_id","appointment_id":"id","department_id":"department_id","status":"open","chief_complaint":"reason","started_at":"scheduled_at"}
    %%step C UpdateEntity field: status value: checked_in

%%meta name: Admission Bed Allocation
%%meta kind: workflow
%%workflow AdmissionBedAllocation entity: Admission kind: saga trigger: rule
flowchart TD
    A([Admission planned]) --> B[Occupy assigned bed]
    B --> C[Mark admission admitted]
    C --> Z([Admission ready])
    %%step B UpdateEntity entity: Bed targetSource: bed_id field: status value: occupied
    %%step C UpdateEntity field: status value: admitted

%%meta name: Invoice Payment Settlement
%%meta kind: workflow
%%workflow InvoicePaymentSettlement entity: Payment kind: saga trigger: rule
flowchart TD
    A([Payment completed]) --> B[Apply payment to invoice]
    B --> C[Recalculate balance]
    C --> D[Close invoice when fully paid]
    D --> Z([Settlement complete])
    %%step B Formula target: newBalance operation: subtract source: balance_due operand: amount
    %%step C UpdateEntity entity: Invoice targetField: invoice_id field: balance_due source: newBalance
    %%step D UpdateEntity entity: Invoice targetField: invoice_id field: status value: paid
