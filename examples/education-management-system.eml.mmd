    %%report students-by-program title: Students by Program entity: Student help: Headcount and average GPA by program, showing where enrolment is concentrated. sql: SELECT p.name AS program, d.name AS department, COUNT(s.id) AS student_count, ROUND(AVG(s.gpa)::numeric, 2) AS avg_gpa FROM bus_student s JOIN bus_program p ON p.id = s.program_id JOIN bus_department d ON d.id = p.department_id WHERE s.deleted_at IS NULL GROUP BY p.name, d.name ORDER BY p.name

    %%report course-enrollment-summary title: Course Enrollment Summary entity: CourseSection chart: bar x: course y: enrolled help: Enrollment versus capacity for each section, identifying over-subscribed courses. sql: SELECT c.course_code, c.title, se.name AS semester, cs.enrolled_count, cs.max_capacity, cs.enrolled_count::float / NULLIF(cs.max_capacity, 0) AS fill_rate FROM bus_course_section cs JOIN bus_course c ON c.id = cs.course_id JOIN bus_semester se ON se.id = cs.semester_id WHERE cs.deleted_at IS NULL ORDER BY se.name, c.course_code

    %%report faculty-teaching-load title: Faculty Teaching Load entity: Faculty chart: bar x: faculty y: sections help: How many sections each faculty member is delivering this term, to surface workload imbalances. sql: SELECT f.first_name || ' ' || f.last_name AS faculty_name, d.name AS department, COUNT(cs.id) AS sections_taught FROM bus_faculty f JOIN bus_department d ON d.id = f.department_id LEFT JOIN bus_course_section cs ON cs.faculty_id = f.id AND cs.deleted_at IS NULL WHERE f.deleted_at IS NULL GROUP BY f.id, f.first_name, f.last_name, d.name ORDER BY sections_taught DESC

    %%report overdue-loans title: Overdue Library Loans entity: BookLoan help: Items not returned by their due date, together with the borrower and the fine accrued. sql: SELECT bl.item_title, bl.item_isbn, bl.loan_date, bl.due_date, (now()::date - bl.due_date) AS days_overdue, bl.fine_amount, l.name AS library FROM bus_book_loan bl JOIN bus_library l ON l.id = bl.library_id WHERE bl.deleted_at IS NULL AND bl.status = 'overdue' ORDER BY days_overdue DESC
