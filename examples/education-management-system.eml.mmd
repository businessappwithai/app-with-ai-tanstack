%%entity Department help: An academic department that groups related disciplines and faculty.
%%field Department.department_code help: Short code used in course prefixes and room bookings.
%%field Department.name help: Full name of the department.
%%field Department.description help: Summary of the department's academic focus.
%%field Department.building help: Building where the department's main offices are located.
%%field Department.phone help: Main telephone number for the department office.
%%field Department.email help: General enquiries email address.
%%field Department.head_id help: The faculty member currently serving as department head.
%%field Department.budget help: Annual operating budget allocated to this department.

%%entity Faculty help: An academic staff member who teaches, researches, and advises students.
%%field Faculty.employee_number help: Unique staff identifier used in payroll and HR systems.
%%field Faculty.first_name help: Legal given name.
%%field Faculty.last_name help: Legal family name.
%%field Faculty.email help: Institutional email address.
%%field Faculty.phone help: Office telephone extension.
%%field Faculty.title help: Academic or professional title.
%%field Faculty.rank help: Academic rank within the institution's hierarchy.
%%field Faculty.specialization help: Primary area of academic expertise.
%%field Faculty.hire_date help: Date the faculty member joined the institution.
%%field Faculty.department_id help: The department this faculty member belongs to.
%%field Faculty.office_location help: Room number and building for student office hours.
%%field Faculty.is_active help: Whether this faculty member is currently employed.
%%field Faculty.title enum: FacultyTitle
%%field Faculty.rank enum: FacultyRank

%%entity Program help: A structured academic qualification such as a degree or diploma.
%%field Program.program_code help: Short unique code used in official documents and timetables.
%%field Program.name help: Full name of the program as it appears on transcripts.
%%field Program.description help: Overview of what the program covers and who it is for.
%%field Program.degree_type help: The qualification awarded on successful completion.
%%field Program.duration_years help: Nominal number of years to complete the program full-time.
%%field Program.total_credits help: Total credit hours required to graduate.
%%field Program.department_id help: The department that owns and administers this program.
%%field Program.is_active help: Whether new students may currently enrol in this program.
%%field Program.degree_type enum: DegreeType

%%entity Student help: A person enrolled or applying to study at the institution.
%%field Student.student_number help: Unique identifier assigned at enrolment, printed on all official documents.
%%field Student.first_name help: Legal given name as it appears on identity documents.
%%field Student.last_name help: Legal family name as it appears on identity documents.
%%field Student.date_of_birth help: Used to verify identity and calculate age eligibility.
%%field Student.email help: Primary contact address; used for all official correspondence.
%%field Student.phone help: Contact telephone number including country code.
%%field Student.address help: Residential address for postal correspondence.
%%field Student.enrollment_date help: Date the student was formally admitted and enrolled.
%%field Student.status help: Current standing of the student in the institution.
%%field Student.gpa help: Cumulative grade point average across all completed courses.
%%field Student.advisor_id help: The faculty member advising this student.
%%field Student.program_id help: The academic program the student is pursuing.
%%field Student.status enum: StudentStatus

%%entity Semester help: An academic period during which courses are offered and assessed.
%%field Semester.name help: Human-readable name such as Fall 2024 or Spring 2025.
%%field Semester.semester_code help: Short code used in transcripts and section identifiers.
%%field Semester.start_date help: First day of classes.
%%field Semester.end_date help: Last day of classes.
%%field Semester.registration_start help: Date from which students may register for courses.
%%field Semester.registration_end help: Deadline for adding or dropping courses without penalty.
%%field Semester.is_active help: Whether this semester is currently in progress.

%%entity Course help: A unit of study offered by a department, identified by a code and title.
%%field Course.course_code help: Unique code such as CS101 used in timetables and transcripts.
%%field Course.title help: Full descriptive title of the course.
%%field Course.description help: What the course covers, its learning outcomes and assessment methods.
%%field Course.credits help: Number of credit hours this course contributes to a program.
%%field Course.level help: Academic level indicating the year of study the course is intended for.
%%field Course.department_id help: The department that owns and delivers this course.
%%field Course.is_active help: Whether this course is currently available for enrolment.
%%field Course.max_capacity help: Maximum number of students who may enrol in a single section.
%%field Course.prerequisites help: Free-text description of courses that must be completed first.
%%field Course.level enum: CourseLevel

%%entity CourseSection help: A specific offering of a course in a given semester with a time, place, and instructor.
%%field CourseSection.section_number help: Identifier distinguishing this offering from others of the same course in the same term.
%%field CourseSection.course_id help: The course this section delivers.
%%field CourseSection.faculty_id help: The instructor assigned to teach this section.
%%field CourseSection.semester_id help: The semester in which this section runs.
%%field CourseSection.room help: Classroom or laboratory where sessions are held.
%%field CourseSection.schedule help: Days and times the section meets.
%%field CourseSection.enrolled_count help: Current number of students enrolled; updated automatically.
%%field CourseSection.status help: Whether the section is open, closed, or cancelled.
%%field CourseSection.status enum: SectionStatus

%%entity Enrollment help: A student's registration in a specific course section for a semester.
%%field Enrollment.student_id help: The student who enrolled.
%%field Enrollment.section_id help: The course section the student is enrolled in.
%%field Enrollment.enrollment_date help: Date and time the student registered.
%%field Enrollment.status help: Current state of the enrollment.
%%field Enrollment.grade help: Final letter grade awarded on completion.
%%field Enrollment.grade_points help: Numeric grade points used to compute GPA.
%%field Enrollment.attendance_percent help: Percentage of sessions the student attended.
%%field Enrollment.notes help: Administrative notes about this enrollment.
%%field Enrollment.status enum: EnrollmentStatus
%%field Enrollment.grade enum: LetterGrade

%%entity Assignment help: A graded piece of work set within a course section.
%%field Assignment.title help: Name of the assignment shown to students.
%%field Assignment.description help: Full instructions and submission requirements.
%%field Assignment.section_id help: The course section this assignment belongs to.
%%field Assignment.due_date help: Deadline by which students must submit.
%%field Assignment.max_score help: Maximum number of points attainable.
%%field Assignment.weight_percent help: Contribution of this assignment to the overall course grade.
%%field Assignment.assignment_type help: Category of work required.
%%field Assignment.is_published help: Whether students can currently see this assignment.
%%field Assignment.assignment_type enum: AssignmentType

%%entity Submission help: A student's response to an assignment including any score awarded.
%%field Submission.assignment_id help: The assignment being submitted.
%%field Submission.student_id help: The student who made the submission.
%%field Submission.submitted_at help: Date and time of submission.
%%field Submission.score help: Points awarded by the grader.
%%field Submission.feedback help: Grader's written comments returned to the student.
%%field Submission.graded_by help: Faculty member who graded this submission.
%%field Submission.graded_at help: When the score and feedback were recorded.
%%field Submission.is_late help: Whether the submission was received after the due date.
%%field Submission.status help: Current grading state.
%%field Submission.status enum: SubmissionStatus

%%entity Library help: A campus library available to students and faculty.
%%field Library.name help: Name of the library.
%%field Library.location help: Building and floor where the library is situated.
%%field Library.opening_hours help: Days and times the library is open.
%%field Library.phone help: Contact number for enquiries and renewals.
%%field Library.email help: Email for enquiries.
%%field Library.is_active help: Whether the library is currently operational.

%%entity BookLoan help: A loan of a library resource to a student or faculty member.
%%field BookLoan.library_id help: The library from which the item was borrowed.
%%field BookLoan.borrower_student_id help: Student who borrowed the item, if applicable.
%%field BookLoan.borrower_faculty_id help: Faculty who borrowed the item, if applicable.
%%field BookLoan.item_title help: Title of the book or resource borrowed.
%%field BookLoan.item_isbn help: ISBN or other catalogue identifier.
%%field BookLoan.loan_date help: Date the item was checked out.
%%field BookLoan.due_date help: Date by which the item must be returned.
%%field BookLoan.return_date help: Actual date the item was returned, if returned.
%%field BookLoan.fine_amount help: Fine charged for late return, if any.
%%field BookLoan.status help: Current state of the loan.
%%field BookLoan.status enum: LoanStatus

