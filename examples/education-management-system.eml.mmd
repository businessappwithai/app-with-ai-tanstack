%%rule gradePointsRange on Enrollment event: beforeUpdate priority: 5
flowchart TD
    A([Start: Grade Updated]) --> B{grade_points >= 0?}
    B -->|No| X1[Reject: Grade points must be 0 or higher]
    B -->|Yes| C{grade_points <= 4?}
    C -->|No| X2[Reject: Grade points cannot exceed 4]
    C -->|Yes| P[Accept]
    X1 --> Z([End])
    X2 --> Z
    P --> Z

%%rule attendanceRange on Enrollment event: beforeUpdate priority: 5
flowchart TD
    A([Start: Attendance Updated]) --> B{attendance_percent >= 0?}
    B -->|No| X1[Reject: Attendance cannot be negative]
    B -->|Yes| C{attendance_percent <= 100?}
    C -->|No| X2[Reject: Attendance cannot exceed 100 percent]
    C -->|Yes| P[Accept]
    X1 --> Z([End])
    X2 --> Z
    P --> Z

%%rule submissionScoreRange on Submission event: beforeUpdate priority: 5
flowchart TD
    A([Start: Score Entered]) --> B{score >= 0?}
    B -->|No| X1[Reject: Score cannot be negative]
    B -->|Yes| P[Accept]
    X1 --> Z([End])
    P --> Z

%%workflow GradeRecorded entity: Enrollment kind: saga trigger: automatic operation: UPDATE
flowchart TD
    A([Grade recorded]) --> B[Mark enrollment complete]
    B --> C([Done])

