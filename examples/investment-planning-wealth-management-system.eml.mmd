%%rule RiskSuitability on InvestmentRecommendation event: beforeUpdate priority: 10
%% Policy retained: Risk suitability must pass before recommendation approval.
flowchart TD
    A([Risk suitability must pass before recommendation approval.]) --> B{Pass?}
    B -->|Yes| C[Continue]
    B -->|No| D[Reject or create exception]
    C --> Z([End: Review completed])
    D --> Z

    %%action blockUnassessedApproval validation-error when: status == "approved" and suitability_status != "passed" message: Record a passed suitability result before approving this recommendation

