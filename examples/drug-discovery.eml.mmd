%% ---- Section 10: Workflow — critical deviation escalation ------------------
%% A multi-step process: it decides an SLA from a table, computes from what the
%% table published, creates a CAPA in another entity, updates the record that
%% triggered it, and then reaches back into the row it created using the id that
%% step bound. `trigger: rule` is what makes the severity condition in Section 3
%% load-bearing — without it the workflow would run on every deviation, critical
%% or not.
%%
%% Step B is a decision table living inside the process. The base SLA used to be
%% a literal 3, which meant the number was in the diagram but the reasoning
%% behind it was nowhere: changing the window for major deviations meant editing
%% a Formula and hoping the reader inferred why. As a table, the policy is the
%% artifact, and the two variables it publishes are read by the steps after it.
%%meta name: Critical Deviation Escalation
%%meta kind: workflow
%%workflow CriticalDeviationEscalation entity: DeviationReport kind: saga trigger: rule
flowchart TD
    A([Critical deviation reported]) --> B{Classify the severity}
    B --> C[Compute the resolution window]
    C --> D[Open a CAPA]
    D --> E[Escalate the deviation]
    E --> F[Record the window on the CAPA]
    F --> G([Escalated])

    %%step B Decision decisionTable: {"hitPolicy":"first","inputs":[{"id":"i1","name":"Severity","field":"severity"}],"outputs":[{"id":"o1","name":"BaseDays","field":"baseDays"},{"id":"o2","name":"Category","field":"capaCategory"}],"rules":[{"_id":"critical","i1":"\"critical\"","o1":"1","o2":"'immediate_containment'"},{"_id":"major","i1":"\"major\"","o1":"3","o2":"'under_investigation'"},{"_id":"rest","i1":"","o1":"7","o2":"'under_investigation'"}]}
    %%step C Formula target: resolutionDays source: baseDays operation: multiply operand: 7
    %%step D CreateEntity entity: CAPA as: newCapaId fields: {"deviation_report_id":"id","title":"CAPA for a critical deviation","root_cause_category":"capaCategory","remediation_owner_id":"reported_by_id","required_resolution_date":"anomaly_timestamp","status":"open"}
    %%step E UpdateEntity field: status value: escalated
    %%step F UpdateEntity entity: CAPA targetSource: newCapaId field: effectiveness_metric source: resolutionDays

%% ---- Section 11: Workflow — sample disposition on update -------------------
%% The escalation in Section 10 is rule-triggered: a rule decides whether it
%% runs at all. This one is the other half of the pairing — it runs on the
%% lifecycle itself, every time a sample is updated, and carries its own
%% decision instead of being gated by one.
%%
%% The shape is the point: a table decides, and what it decides is read by the
%% steps that create a row on another entity, write back to the record that
%% triggered the workflow, and then reach into the row just created. Rules and
%% variables interleaved through create, update and delete — driven by an
%% entity's own lifecycle rather than by a rule naming the workflow.
%%meta name: Sample Disposition
%%meta kind: workflow
%%workflow SampleDisposition entity: Sample kind: saga trigger: automatic operation: UPDATE
flowchart TD
    A([Sample updated]) --> B{Decide the disposition}
    B --> C[Record the disposition]
    C --> D[Move the sample]
    D --> E[Name the disposition record]
    E --> F([Disposed])

    %%step B Decision decisionTable: {"hitPolicy":"first","inputs":[{"id":"i1","name":"Status","field":"status"}],"outputs":[{"id":"o1","name":"AliasType","field":"dispositionType"},{"id":"o2","name":"Location","field":"dispositionLocation"}],"rules":[{"_id":"consumed","i1":"\"consumed\"","o1":"'disposition_consumed'","o2":"'ARCHIVE-A'"},{"_id":"quarantined","i1":"\"quarantined\"","o1":"'disposition_quarantine'","o2":"'QUARANTINE-1'"},{"_id":"rest","i1":"","o1":"'disposition_active'","o2":"'FREEZER-A'"}]}
    %%step C CreateEntity entity: CompoundAlias as: dispositionAliasId fields: {"compound_id":"compound_id","alias_name":"pending disposition","alias_type":"dispositionType"}
    %%step D UpdateEntity field: storage_location source: dispositionLocation
    %%step E UpdateEntity entity: CompoundAlias targetSource: dispositionAliasId field: alias_name source: dispositionLocation

%% ---- Section 12: Workflow — stability test retirement on delete ------------
%% The third trigger. Section 10 runs when a rule names it, Section 11 runs on
%% every update, and this one runs when a record is deleted.
%%
%% A delete is a hard delete, and the row goes last: this workflow runs inside
%% the same transaction, before the removal, which is the only order that works.
%% A StabilityTest owns its pulls, so the pulls have to be cleared while the
%% test still exists — a foreign key does not care that we intended to delete
%% the parent. If the cascade throws, nothing is deleted and the test is still
%% there to try again.
%%
%% The decision reads the record being deleted, so the same shape as the other
%% two holds here: a table decides, its variables reach the steps after it, and
%% those steps write across entities.
%%meta name: Stability Test Retirement
%%meta kind: workflow
%%workflow StabilityTestRetirement entity: StabilityTest kind: saga trigger: automatic operation: DELETE
flowchart TD
    A([Stability test deleted]) --> B{Classify the retirement}
    B --> C[Record the retirement]
    C --> D[Clear the scheduled pulls]
    D --> E([Retired])

    %%step B Decision decisionTable: {"hitPolicy":"first","inputs":[{"id":"i1","name":"Status","field":"status"}],"outputs":[{"id":"o1","name":"Reason","field":"retirementReason"}],"rules":[{"_id":"completed","i1":"\"completed\"","o1":"'retired_after_completion'"},{"_id":"rest","i1":"","o1":"'retired_early'"}]}
    %%step C CreateEntity entity: CompoundAlias as: retirementNoteId fields: {"compound_id":"compound_id","alias_name":"retired stability test","alias_type":"retirementReason"}
    %%step D DeleteEntity entity: StabilityPull targetField: stability_test_id targetSource: id
