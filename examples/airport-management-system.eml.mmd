%%meta name: Flight Validation
%%meta kind: rules
%%rule validateFlight on Flight event: beforeUpdate priority: 10
flowchart TD
    A([Write requested]) --> B{Record valid?}
    B -->|Yes| C([Accept])
    B -->|No| D([Reject with explanation])
    %%action passengersNonnegative validation-error when: passenger_count < 0 message: Passenger counts cannot be negative.
    %%action actualBeforeCompletion validation-error when: status == "completed" and actual_at == null message: Record the observed UTC movement time before completion.
    %%action actualBeforeCompletionOnMove validation-error when: completed_at != null and actual_at == null message: Record the observed UTC movement time before completion.
    %%action flightCancelReason validation-error when: status == "cancelled" and cancellation_reason == null message: Record why the movement was cancelled.
    %%action flightCancelReasonOnMove validation-error when: cancelled_at != null and cancellation_reason == null message: Record why the movement was cancelled.

%%meta name: Allocation Validation
%%meta kind: rules
%%rule validateAllocation on Allocation event: beforeUpdate priority: 10
flowchart TD
    A([Write requested]) --> B{Record valid?}
    B -->|Yes| C([Accept])
    B -->|No| D([Reject with explanation])
    %%action positiveReservation validation-error when: ends_at <= starts_at message: Reservation end must follow its start.

%%meta name: TurnaroundTask Validation
%%meta kind: rules
%%rule validateTurnaroundTask on TurnaroundTask event: beforeUpdate priority: 10
flowchart TD
    A([Write requested]) --> B{Record valid?}
    B -->|Yes| C([Accept])
    B -->|No| D([Reject with explanation])
    %%action taskFinishedTime validation-error when: status == "finished" and finished_at == null message: Record when the handling work actually finished.
    %%action waiverEvidence validation-error when: status == "waived" and completion_notes == null message: Explain who authorised waiving this handling activity.
    %%action waiverEvidenceOnMove validation-error when: waived_at != null and completion_notes == null message: Explain who authorised waiving this handling activity.

%%meta name: BaggageBatch Validation
%%meta kind: rules
%%rule validateBaggageBatch on BaggageBatch event: beforeUpdate priority: 10
flowchart TD
    A([Write requested]) --> B{Record valid?}
    B -->|Yes| C([Accept])
    B -->|No| D([Reject with explanation])
    %%action reconciledCounts validation-error when: status == "reconciled" and expected_bags != counted_bags message: Resolve the count discrepancy before reconciliation.
    %%action reconciledCountsOnMove validation-error when: reconciled_at != null and expected_bags != counted_bags message: Resolve the count discrepancy before reconciliation.
    %%action bagCountNonnegative validation-error when: counted_bags < 0 or expected_bags < 0 message: Baggage counts cannot be negative.

%%meta name: CargoConsignment Validation
%%meta kind: rules
%%rule validateCargoConsignment on CargoConsignment event: beforeUpdate priority: 10
flowchart TD
    A([Write requested]) --> B{Record valid?}
    B -->|Yes| C([Accept])
    B -->|No| D([Reject with explanation])
    %%action cargoQuantity validation-error when: pieces <= 0 or weight_kg <= 0 message: Cargo needs positive piece count and gross weight.
    %%action cargoRelease validation-error when: status == "dispatched" and release_reference == null message: Record release authority before dispatching cargo.
    %%action cargoReleaseOnMove validation-error when: dispatched_at != null and release_reference == null message: Record release authority before dispatching cargo.

%%meta name: WorkOrder Validation
%%meta kind: rules
%%rule validateWorkOrder on WorkOrder event: beforeUpdate priority: 10
flowchart TD
    A([Write requested]) --> B{Record valid?}
