%%rbac role:airport_manager on BaggageBatch.delete
%%index BaggageBatch(flight_id)

%%entity CargoConsignment help: An air waybill consignment handled by the airport cargo operation, with release recorded separately from physical receipt.
%%field CargoConsignment.reference help: Air waybill reference used to locate the consignment and its supporting documents.
%%field CargoConsignment.flight_id help: Movement carrying the consignment into or out of the airport.
%%field CargoConsignment.status help: booked is expected, received is physically accepted, held cannot move, cleared is authorised, dispatched has left custody.
%%field CargoConsignment.status enum: CargoConsignmentStatus
%%field CargoConsignment.pieces help: Number of cargo packages accepted under this waybill.
%%field CargoConsignment.weight_kg help: Accepted gross weight in kilograms for handling and charging.
%%field CargoConsignment.is_dangerous_goods help: True requires specialist acceptance and handling precautions before clearance.
%%field CargoConsignment.goods_description help: Plain description that handlers can use to verify the consignment.
%%field CargoConsignment.release_reference help: Customs or authorised release evidence required before dispatch.
%%section entity: CargoConsignment; name: Waybill; help: Identify the movement and physical cargo quantity.; rows: reference, status | flight_id, is_dangerous_goods | pieces, weight_kg
%%section entity: CargoConsignment; name: Acceptance and release; help: Describe the goods and preserve evidence allowing them to leave custody.; rows: goods_description | release_reference
