%%entity BaggageBatch help: An aggregate hold-baggage batch on a movement. Counts support reconciliation without keeping individual passenger identities.
%%field BaggageBatch.reference help: Batch label used by the baggage handling team to reconcile a load or unload.
%%field BaggageBatch.flight_id help: Movement carrying this batch.
%%field BaggageBatch.status help: collecting accepts bags, reconciled has matching counts, loaded is on the aircraft, delivered is handed over, exception needs investigation.
%%field BaggageBatch.status enum: BaggageBatchStatus
%%field BaggageBatch.expected_bags help: Bags expected from the handling manifest.
%%field BaggageBatch.counted_bags help: Bags physically scanned or counted for this batch.
%%field BaggageBatch.weight_kg help: Aggregate bag weight in kilograms from the accepted load sheet.
%%field BaggageBatch.exception_notes help: Reason counts differ or a bag was withheld from the batch.
%%section entity: BaggageBatch; name: Baggage reconciliation; help: Compare the handling manifest with physical counts for the movement.; rows: reference, status | flight_id, weight_kg | expected_bags, counted_bags
%%section entity: BaggageBatch; name: Exceptions; help: Explain discrepancies before loading or closing the batch.; rows: exception_notes
%%rbac role:airport_manager|operations_controller|ground_supervisor|terminal_supervisor|security_officer on BaggageBatch.read
%%rbac role:airport_manager|operations_controller|ground_supervisor|terminal_supervisor|security_officer on BaggageBatch.create
