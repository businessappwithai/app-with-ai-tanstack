%%report movement-board title: Movement board entity: Flight help: Review dated movement timings for the operations duty briefing. sql: SELECT reference, direction, scheduled_at, estimated_at, actual_at, status FROM bus_flight WHERE deleted_at IS NULL ORDER BY scheduled_at
%%report resource-reservations title: Confirmed facility reservations entity: Allocation help: Review the live reservations requiring resource coordination. sql: SELECT reference, resource_id, flight_id, starts_at, ends_at FROM bus_allocation WHERE status = 'reserved' AND deleted_at IS NULL ORDER BY starts_at
%%report ground-work title: Unfinished handling tasks entity: TurnaroundTask help: Dispatch the ground work still requiring completion. sql: SELECT reference, flight_id, owner_id, due_at FROM bus_turnaround_task WHERE status IN ('queued', 'underway') AND deleted_at IS NULL ORDER BY due_at
%%report baggage-discrepancies title: Unresolved baggage counts entity: BaggageBatch help: Investigate batches whose physical count cannot yet be accepted. sql: SELECT reference, flight_id, expected_bags, counted_bags FROM bus_baggage_batch WHERE (expected_bags <> counted_bags OR status = 'exception') AND deleted_at IS NULL
%%report cargo-holds title: Held cargo consignments entity: CargoConsignment help: Locate consignments that cannot yet leave controlled custody. sql: SELECT reference, flight_id, pieces, weight_kg FROM bus_cargo_consignment WHERE status = 'held' AND deleted_at IS NULL
%%report engineering-backlog title: Maintenance work awaiting handback entity: WorkOrder help: Prioritise equipment repairs still awaiting verified handback. sql: SELECT reference, asset_id, priority, due_at FROM bus_work_order WHERE status <> 'closed' AND deleted_at IS NULL ORDER BY due_at
%%report safety-followup title: Unverified safety commitments entity: CorrectiveAction help: Follow up the owners of unfinished safety commitments. sql: SELECT reference, safety_case_id, owner_id, due_at FROM bus_corrective_action WHERE status <> 'validated' AND deleted_at IS NULL ORDER BY due_at
%%report pass-register title: Issued airside access passes entity: SecurityPass help: Review issued authorisations by expiry before checking current validity. sql: SELECT reference, holder_name, access_zone, valid_until FROM bus_security_pass WHERE status = 'issued' AND deleted_at IS NULL ORDER BY valid_until
%%report outstanding-invoices title: Issued invoices awaiting payment entity: Invoice help: Prioritise airline collection work by payment deadline. sql: SELECT reference, airline_id, due_on, currency, total_amount, received_amount, total_amount - received_amount AS outstanding FROM bus_invoice WHERE status = 'issued' AND deleted_at IS NULL ORDER BY due_on
%%report charge-review title: Airport charges awaiting review entity: Charge help: Resolve assessments and disputes before issuing the next airline bill. sql: SELECT reference, flight_id, currency, gross_amount FROM bus_charge WHERE status IN ('assessed', 'disputed') AND deleted_at IS NULL

