%%entity Airport help: An airport operated by this organisation. Its timezone governs local displays while movement timestamps are recorded in UTC.
%%field Airport.name help: Airport name used in duty logs and operational reports.
%%field Airport.code help: Four-letter ICAO designator used to distinguish this airport from route destinations.
%%field Airport.iata_code help: Three-letter commercial designator, left empty for airports without one.
%%field Airport.timezone help: IANA timezone such as Asia/Kolkata used when interpreting local schedules.
%%field Airport.country_code help: ISO two-letter country code used on airport correspondence.
%%field Airport.duty_phone help: Continuously staffed operations contact for disruptions and emergencies.
%%field Airport.is_active help: Clear when the airport leaves the operating portfolio, retaining past movements.
%%section entity: Airport; name: Airport identity; help: Identify the aerodrome before configuring facilities.; rows: name, code | iata_code, country_code
%%section entity: Airport; name: Duty coordination; help: Confirm the local time basis and the staffed operational contact.; rows: timezone, duty_phone | is_active
%%rbac role:airport_manager|operations_controller|ground_supervisor|terminal_supervisor|safety_officer|maintenance_engineer|finance_officer|security_officer on Airport.read
%%rbac role:airport_manager on Airport.create
%%rbac role:airport_manager on Airport.update
%%rbac role:airport_manager on Airport.delete

%%entity Staff help: An operational employee who owns tasks or approves work. Login permissions are assigned through the generated role system.
%%field Staff.full_name help: Name colleagues recognise in task assignments and approval records.
%%field Staff.airport_id help: Home duty station, used to organise the airport roster.
%%field Staff.email help: Work address used to contact the employee about assigned airport work.
%%field Staff.phone help: Duty contact reachable during the assigned shift.
%%field Staff.discipline help: Operational function performed by this employee, separate from login role grants.
%%field Staff.discipline enum: Discipline
%%field Staff.is_active help: Clear when staff leave active duty so historical sign-offs remain attributable.
%%section entity: Staff; name: Duty identity; help: Identify the colleague and their home operating station.; rows: full_name, airport_id | discipline, is_active
%%section entity: Staff; name: Contact; help: Use staffed work contacts for duty coordination.; rows: email, phone
%%rbac role:airport_manager|operations_controller|ground_supervisor|terminal_supervisor|safety_officer|maintenance_engineer|finance_officer|security_officer on Staff.read
%%rbac role:airport_manager on Staff.create
%%rbac role:airport_manager on Staff.update
%%rbac role:airport_manager on Staff.delete
%%index Staff(airport_id)

%%entity Airline help: An aircraft operator billed for airport services. Retain it after its last flight so historical movements and invoices remain attributable.
%%field Airline.name help: Trading name displayed on movement lists and invoices.
%%field Airline.code help: ICAO operator designator used with flight numbers.
%%field Airline.iata_code help: Commercial two-character operator code when one is allocated.
%%field Airline.billing_email help: Address to receive issued airport charge invoices.
%%field Airline.operations_phone help: Airline station contact for turnaround and schedule changes.
%%field Airline.is_active help: Clear when the operator stops using the airport without removing its history.
%%section entity: Airline; name: Operator; help: Identify the operator from its published designators.; rows: name, code | iata_code, is_active
%%section entity: Airline; name: Station contacts; help: Route financial and operational enquiries to the right desks.; rows: billing_email, operations_phone
%%rbac role:airport_manager|operations_controller|ground_supervisor|terminal_supervisor|safety_officer|maintenance_engineer|finance_officer|security_officer on Airline.read
%%rbac role:airport_manager|operations_controller on Airline.create
%%rbac role:airport_manager|operations_controller on Airline.update
%%rbac role:airport_manager on Airline.delete

%%entity AircraftType help: A certified airframe variant used to check stand suitability and describe the operating fleet.
%%field AircraftType.name help: Manufacturer and variant as recognised by airport planners.
%%field AircraftType.code help: ICAO aircraft type designator used on movement messages.
%%field AircraftType.wake_category help: Light, medium, heavy or super planning classification, not an ATC separation decision.
%%field AircraftType.wake_category enum: WakeCategory
%%field AircraftType.wingspan_m help: Wingtip span in metres used in physical clearance planning.
%%field AircraftType.passenger_capacity help: Maximum configured passenger seats for plausibility checks.
%%field AircraftType.maximum_takeoff_weight_kg help: Certified maximum mass in kilograms, used as the charge basis where tariffs specify it.
%%section entity: AircraftType; name: Airframe; help: Identify the certified variant and planning classification.; rows: name, code | wake_category, passenger_capacity
%%section entity: AircraftType; name: Physical limits; help: Use published dimensions and mass when checking infrastructure and charges.; rows: wingspan_m, maximum_takeoff_weight_kg
%%rbac role:airport_manager|operations_controller|ground_supervisor|terminal_supervisor|safety_officer|maintenance_engineer|finance_officer|security_officer on AircraftType.read
%%rbac role:airport_manager|operations_controller on AircraftType.create
%%rbac role:airport_manager|operations_controller on AircraftType.update
%%rbac role:airport_manager on AircraftType.delete

%%entity Aircraft help: A registered airframe visiting the airport. Flight movements reference the airframe so its type and operator can be checked.
%%field Aircraft.name help: Registration painted on the airframe, including the national prefix.
%%field Aircraft.aircraft_type_id help: Certified variant that supplies dimensions and maximum mass.
%%field Aircraft.airline_id help: Operator currently responsible for this airframe.
%%field Aircraft.is_active help: Clear when the registration is retired from the local fleet register.
%%section entity: Aircraft; name: Registration; help: Confirm the actual airframe rather than just its flight number.; rows: name, aircraft_type_id | airline_id, is_active
%%rbac role:airport_manager|operations_controller|ground_supervisor|terminal_supervisor|safety_officer|maintenance_engineer|finance_officer|security_officer on Aircraft.read
%%rbac role:airport_manager|operations_controller on Aircraft.create
%%rbac role:airport_manager|operations_controller on Aircraft.update
%%rbac role:airport_manager on Aircraft.delete
%%index Aircraft(aircraft_type_id)
%%index Aircraft(airline_id)

%%entity Terminal help: A passenger building whose gates, counters and reclaim belts are allocated to movements.
%%field Terminal.name help: Wayfinding name displayed to passengers and duty teams.
%%field Terminal.airport_id help: Airport containing this passenger building.
%%field Terminal.code help: Local terminal designation, unique within its airport.
%%field Terminal.is_active help: Clear when the building is withdrawn from routine passenger operations.
%%section entity: Terminal; name: Passenger building; help: Match the terminal to airport wayfinding before adding its resources.; rows: name, code | airport_id, is_active
%%rbac role:airport_manager|operations_controller|ground_supervisor|terminal_supervisor|safety_officer|maintenance_engineer|finance_officer|security_officer on Terminal.read
%%rbac role:airport_manager|terminal_supervisor on Terminal.create
%%rbac role:airport_manager|terminal_supervisor on Terminal.update
%%rbac role:airport_manager on Terminal.delete
%%index Terminal(airport_id)

%%entity Resource help: A schedulable airport facility such as a runway, stand, gate, check-in counter or reclaim belt. Reservations carry time intervals rather than an occupied flag.
%%field Resource.name help: Operational designation on signs and allocation screens, such as Stand A12.
%%field Resource.airport_id help: Airport controlling this facility.
%%field Resource.terminal_id help: Passenger building served, empty for runways or remote apron facilities.
%%field Resource.resource_type help: Runway for movements, stand for parking, gate for boarding, counter for check-in, or belt for reclaim.
%%field Resource.resource_type enum: ResourceType
%%field Resource.availability help: Available permits planning, restricted requires review, closed blocks new use.
%%field Resource.availability enum: Availability
%%field Resource.maximum_wingspan_m help: Physical span limit in metres for stands or gates, empty when not applicable.
%%field Resource.capacity help: People or service positions the facility can safely handle, according to its operating procedure.
%%field Resource.restriction_notes help: Closure limits and operating precautions from the current airport duty instruction.
%%section entity: Resource; name: Facility; help: Identify the physical resource and the operation it serves.; rows: name, resource_type | airport_id, terminal_id
%%section entity: Resource; name: Operating restrictions; help: Check suitability and current restrictions before reserving the facility.; rows: availability, maximum_wingspan_m | capacity | restriction_notes
%%rbac role:airport_manager|operations_controller|ground_supervisor|terminal_supervisor|safety_officer|maintenance_engineer|finance_officer|security_officer on Resource.read
%%rbac role:airport_manager|operations_controller on Resource.create
%%rbac role:airport_manager|operations_controller on Resource.update
%%rbac role:airport_manager on Resource.delete
%%index Resource(airport_id)
%%index Resource(terminal_id)

%%entity Flight help: One arrival or departure at one operated airport on a service date. An aircraft turnaround may connect an inbound movement to an outbound movement through resource planning.
%%field Flight.reference help: Locally unique movement reference combining flight number, date and direction.
%%field Flight.airport_id help: Operated airport at which this movement is handled.
%%field Flight.airline_id help: Operating airline responsible for coordination and airport charges.
%%field Flight.aircraft_id help: Actual registered airframe, optional until the operator confirms it.
%%field Flight.flight_number help: Published operator flight number retained even if the aircraft changes.
%%field Flight.direction help: Arrival enters this airport, departure leaves it.
%%field Flight.direction enum: Direction
%%field Flight.route_airport_code help: ICAO designator of the other endpoint, kept as an external code rather than an operated-airport lookup.
%%field Flight.service_date help: Local operating date used to distinguish recurring flight numbers across midnight.
%%field Flight.status help: planned is provisional, scheduled is accepted, active is underway, completed records actual movement, cancelled retains the reason.
%%field Flight.status enum: FlightStatus
%%field Flight.scheduled_at help: Scheduled landing or takeoff in UTC, interpreted using the airport timezone.
%%field Flight.estimated_at help: Latest agreed estimated landing or takeoff in UTC.
%%field Flight.actual_at help: Observed landing or takeoff in UTC, required before completing the movement.
%%field Flight.passenger_count help: Actual or latest expected passengers on this movement, excluding crew.
%%field Flight.owner_id help: Operations controller accountable for this movement's coordination.
%%field Flight.cancellation_reason help: Airline or airport explanation required when the movement is cancelled.
%%section entity: Flight; name: Movement; help: Identify the dated movement and its operating responsibility.; rows: reference, status | flight_number, direction | airline_id, aircraft_id
%%section entity: Flight; name: Route and timetable; help: Record the local service date and UTC movement times.; rows: airport_id, route_airport_code | service_date, scheduled_at | estimated_at, actual_at
%%section entity: Flight; name: Duty coordination; help: Confirm the passenger workload and accountable controller.; rows: passenger_count, owner_id
%%section entity: Flight; name: Cancellation; help: Retain the reason a planned movement did not operate.; rows: cancellation_reason
%%rbac role:airport_manager|operations_controller|ground_supervisor|terminal_supervisor|safety_officer|maintenance_engineer|finance_officer|security_officer on Flight.read
%%rbac role:airport_manager|operations_controller on Flight.create
%%rbac role:airport_manager|operations_controller on Flight.update
%%rbac role:airport_manager on Flight.delete
%%index Flight(airport_id)
%%index Flight(airline_id)
%%index Flight(aircraft_id)
%%index Flight(owner_id)

%%entity Allocation help: A timed reservation of one airport resource for one movement. Overlapping live reservations require conflict validation before confirmation.
%%field Allocation.reference help: Allocation reference used in the duty log when a facility is reassigned.
%%field Allocation.flight_id help: Movement receiving the facility for this time interval.
%%field Allocation.resource_id help: Physical facility being reserved.
%%field Allocation.status help: requested awaits conflict review, reserved is confirmed, released ended normally, voided was withdrawn.
%%field Allocation.status enum: AllocationStatus
%%field Allocation.starts_at help: Beginning of the reserved interval in UTC, including the planned setup buffer.
%%field Allocation.ends_at help: End of the reserved interval in UTC, including handover and clearance time.
%%field Allocation.owner_id help: Controller who owns the reservation and resolves conflicting requests.
%%field Allocation.notes help: Handover instructions or the reason for a nonstandard reservation.
%%section entity: Allocation; name: Reservation; help: Link the movement to the facility and confirm approval.; rows: reference, status | flight_id, resource_id
%%section entity: Allocation; name: Use interval; help: Include setup and clearance buffers in the UTC reservation interval.; rows: starts_at, ends_at | owner_id | notes
%%rbac role:airport_manager|operations_controller|ground_supervisor|terminal_supervisor|safety_officer|maintenance_engineer|finance_officer|security_officer on Allocation.read
%%rbac role:airport_manager|operations_controller on Allocation.create
%%rbac role:airport_manager|operations_controller on Allocation.update
%%rbac role:airport_manager on Allocation.delete
%%index Allocation(flight_id)
%%index Allocation(resource_id)
%%index Allocation(owner_id)

